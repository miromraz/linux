# Gemini PDA (MT6797) bringup: early on-screen kernel console.
#
# With no UART and no USB gadget yet, the only way to see why the kernel hangs
# (e.g. during the MSDC0/eMMC probe) is the panel.  U-Boot/LK hand over a live
# simple-framebuffer; simpledrm adopts it and fbcon renders kernel messages on
# it from early boot.  FRAMEBUFFER_CONSOLE and DRM_FBDEV_EMULATION are already
# enabled in the base config; simpledrm pulls in its DRM helper deps via select.
#
# The in-tree MediaTek DRM driver (DRM_MEDIATEK=y) and pwm-backlight would both
# take over and blank the panel, so boot with:
#   initcall_blacklist=mtk_drm_init,pwm_backlight_driver_init
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
