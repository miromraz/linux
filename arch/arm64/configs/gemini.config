# Minimal config fragment for OBS compile validation of the MT6797 base
# platform + CPU/CCI DVFS series (up/mt6797-platform-cpufreq). Merged on top of
# arm64 `defconfig`, then `olddefconfig` resolves selects. Not a board config:
# it only forces the drivers the series adds/touches to compile, and the gemini
# DTB is built separately by debian/rules (make W=1 mt6797-gemini-pda.dtb).
#   defconfig already provides ARCH_MEDIATEK=y, MFD_MT6397=y, REGULATOR=y,
#   CPUFREQ_DT=y, ARM_MEDIATEK_CPUFREQ=y, ARM_MEDIATEK_CCI_DEVFREQ=m, and the
#   existing MediaTek clk/pinctrl/iommu/pwm/panel/touch drivers.
# DVFS drivers (same set as up/cpufreq-mt6797):
CONFIG_COMMON_CLK_MT6797=y
CONFIG_COMMON_CLK_MT6797_MCU=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_MT6797_CPU_SRAM=y
CONFIG_ARM_MEDIATEK_CPUFREQ=y
CONFIG_PM_DEVFREQ=y
CONFIG_ARM_MEDIATEK_CCI_DEVFREQ=y
# New platform drivers added by the base-platform series:
CONFIG_COMMON_CLK_MT6797_CAMSYS=y
CONFIG_COMMON_CLK_MT6797_MFGSYS=y
CONFIG_COMMON_CLK_MT6797_MJCSYS=y
CONFIG_REGULATOR_MT6351=y
CONFIG_REGULATOR_RT5735=y
CONFIG_REGULATOR_FAN49101=y
CONFIG_NVMEM_MT6351_EFUSE=y
CONFIG_SND_SOC_MT6351_ACCDET=y
CONFIG_LEDS_AW9120=y
CONFIG_TYPEC_FUSB301=y
