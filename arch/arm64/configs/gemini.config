# Minimal config fragment for OBS compile validation of the MT6797 cpufreq
# series (up/cpufreq-mt6797). Merged on top of arm64 `defconfig`, then
# `olddefconfig` resolves selects (REGMAP, MFD_SYSCON, CPUFREQ_DT_PLATDEV).
# Not a board config: it only forces the series' touched drivers to compile.
#   defconfig already provides ARCH_MEDIATEK=y, CPUFREQ_DT=y,
#   ARM_MEDIATEK_CPUFREQ=y, ARM_MEDIATEK_CCI_DEVFREQ=m.
CONFIG_COMMON_CLK_MT6797=y
CONFIG_COMMON_CLK_MT6797_MCU=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_MT6797_CPU_SRAM=y
CONFIG_ARM_MEDIATEK_CPUFREQ=y
CONFIG_PM_DEVFREQ=y
CONFIG_ARM_MEDIATEK_CCI_DEVFREQ=y
