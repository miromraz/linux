# Reproducible project identity. Hardware-specific options should be added with
# the patch that makes them usable and validated by scripts/kernel configure.
CONFIG_LOCALVERSION="-gemini"
# CONFIG_LOCALVERSION_AUTO is not set

# Planet LK boots the Gemini through its Android/DT path, not EFI or ACPI.
# Keep host-only hypervisor and ATA stacks out of the decompressed Image;
# the MT6797 LK build allocates a fixed 0x03200000 (50 MiB) output buffer.
# These options are intentionally Gemini-specific and do not alter upstream
# defaults outside this fragment.
# CONFIG_ACPI is not set
# CONFIG_EFI is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_XEN is not set
# USB mass storage on the right USB-C port (MUSB host) needs SCSI; build it
# as modules so the Image does not grow.
CONFIG_SCSI=m
CONFIG_BLK_DEV_SD=m
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m
# CONFIG_ATA is not set
CONFIG_ARCH_MEDIATEK=y
CONFIG_COMMON_CLK_MT6797_CAMSYS=y
CONFIG_COMMON_CLK_MT6797_MJCSYS=y
CONFIG_COMMON_CLK_MT6797_MFGSYS=y
# MMSYS provides the SMI/larb/IOMMU clocks the display pipeline needs; the
# other multimedia subsystem clock controllers sit behind their own domains.
CONFIG_COMMON_CLK_MT6797_MMSYS=y
CONFIG_COMMON_CLK_MT6797_IMGSYS=y
CONFIG_COMMON_CLK_MT6797_VDECSYS=y
CONFIG_COMMON_CLK_MT6797_VENCSYS=y
CONFIG_MTK_IOMMU=y
CONFIG_MTK_SMI=y
CONFIG_MTK_CMDQ=y
CONFIG_MTK_CMDQ_MBOX=y
CONFIG_MTK_MMSYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Standard IIO path prepared for the disabled BMI160 candidate node.
CONFIG_IIO=y
CONFIG_BMI160_I2C=m
# Build the generic MediaTek AUXADC thermal framework.  The MT6797 SoC
# thermal sensor is enabled in the device tree (CPU thermal zone with
# cpufreq cooling); keep the driver as a module so it can be loaded by hand
# for a first controlled calibration/readback check before relying on the
# critical trip.
CONFIG_MTK_THERMAL=m
CONFIG_MTK_SOC_THERMAL=m
# MT6351 PMIC eFuse (ACCDET offset calibration).  SoC thermal calibration
# comes from the SoC eFuse via NVMEM_MTK_EFUSE (defconfig).
CONFIG_NVMEM_MT6351_EFUSE=y
# Existing STK3310-family driver is prepared for the STK3X1X reuse candidate;
# no Gemini DT child is enabled until product ID and board resources are known.
CONFIG_STK3310=m

# MT6797/MT6351 platform foundation carried by the local patch series.
CONFIG_PINCTRL_MT6797=y
CONFIG_EINT_MTK=y
CONFIG_MFD_MT6397=y
CONFIG_REGULATOR_MT6351=y
# On-SoC CPU SRAM LDO; built-in so the Vsram supply is present when the
# built-in cpufreq driver probes (it would otherwise defer on it). The CCI
# devfreq driver stays the defconfig module (ARM_MEDIATEK_CCI_DEVFREQ=m).
CONFIG_REGULATOR_MT6797_CPU_SRAM=y
CONFIG_REGULATOR_RT5735=y
CONFIG_REGULATOR_FAN49101=m
CONFIG_TYPEC_FUSB301=m
CONFIG_PINCTRL_AW9523=m
# Standard GPIO/EV_SW path for the disabled hall/lid candidate.
CONFIG_KEYBOARD_GPIO=m
CONFIG_KEYBOARD_MATRIX=m
CONFIG_KEYBOARD_MTK_PMIC=y
# Compile NT36772 support (upstream novatek-nvt-ts).  The Gemini touchscreen node is
# intentionally absent until the 0x62-to-0x01 target transition, rails, reset,
# and event ranges are validated on hardware.
CONFIG_TOUCHSCREEN_NOVATEK_NVT_TS=m
CONFIG_RTC_DRV_MT6397=y

# USB11 uses the existing MUSB core/glue with a recovered MT6797 data table.
# Keep transfers PIO-only until DMA and the USB11 PHY/runtime lifecycle are
# proven on hardware; the DT nodes remain disabled.
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_USB_MUSB_MEDIATEK=y
CONFIG_MUSB_PIO_ONLY=y

# Standard MT6797/MT6351 ASoC drivers are prepared for the disabled AFE
# resource node; no Gemini machine-card or analog route is enabled yet.
CONFIG_SND_SOC_MT6797=m
CONFIG_SND_SOC_MT6797_MT6351=m
# Loudspeaker amplifiers (one-wire pulse mode control).
CONFIG_SND_SOC_AW8738=m

# gemini-7.1 ports
CONFIG_PINCTRL_MT6797=y
CONFIG_MEDIATEK_MT6359_AUXADC=m
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_MT6323=m
CONFIG_LEDS_AW9120=m
CONFIG_INPUT_REGULATOR_HAPTIC=m
CONFIG_MMC_MTK=y
CONFIG_DRM=y
# Module, so display bring-up can be retried without a reboot.
CONFIG_DRM_MEDIATEK=m
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
# Function trace into ramoops, to find where silent hard hangs stop.
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_PSTORE_FTRACE=y
CONFIG_PHY_MTK_MIPI_DSI=y
CONFIG_DRM_PANEL_NOVATEK_NT36672E=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_PWM=y
CONFIG_PWM_MEDIATEK=y
CONFIG_REGULATOR_TPS65132=y
CONFIG_CHARGER_BQ25890=m
CONFIG_SND_SOC_MT6351_ACCDET=m
CONFIG_DRM_PANFROST=m
CONFIG_TYPEC=m

# Left USB-C MTU3 peripheral gadget + CDC-NCM (RNDIS fallback) over configfs.
# Built-in (=y, overriding the defconfig's =m) so the debug initramfs and the
# early rootfs can bring up the gadget with no out-of-tree module juggling;
# modules would otherwise have to be rebuilt and shipped to match this kernel.
CONFIG_USB_MTU3=y
CONFIG_USB_MTU3_DUAL_ROLE=y
CONFIG_PHY_MTK_TPHY=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_U_ETHER=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_F_NCM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_F_RNDIS=y
CONFIG_CONFIGFS_FS=y

# Bluetooth for the internal CONSYS/MT6631 combo (out-of-tree vendor hci_stp
# driver): LE for BLE devices, RFCOMM/BNEP for serial and PAN profiles.
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_UHID=m

# Use the power_allocator (IPA) thermal governor for the CPU thermal zone:
# it budgets power across the A53/A53/A72 clusters from the Energy Model
# (dynamic-power-coefficient) and the zone's sustainable-power, holding the
# passive trip far better than step_wise under a sustained all-core load.
CONFIG_THERMAL_DEFAULT_GOV_POWER_ALLOCATOR=y
