/dts-v1/;

#include "mt6797.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/iio/adc/mediatek,mt6351-auxadc.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Planet Computers Gemini PDA";
	chassis-type = "handset";
	compatible = "planet,gemini-pda", "mediatek,mt6797";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:921600n8";
	};

	firmware {
		mt6797_atag_devinfo: atag-devinfo {
			compatible = "mediatek,mt6797-atag-devinfo";
			#address-cells = <1>;
			#size-cells = <1>;
			read-only;

			mt6797_thermal_calibration: calibration-data@0 {
				reg = <0 12>;
			};
		};
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0 0x40000000 1 0>;
	};

	/*
	 * Vibrator driven by the MT6351 VIBR LDO. The vendor vibrator node
	 * selects VOSEL 5 (vib_vol = <5>), which the MT6351 VIBR voltage table
	 * maps to 2.8 V.
	 */
	vibrator {
		compatible = "regulator-haptic";
		haptic-supply = <&mt6351_vibr_reg>;
		min-microvolt = <2800000>;
		max-microvolt = <2800000>;
	};

	/*
	 * VBUS switch for the right USB-C port (USB11 MUSB host). The vendor
	 * Type-C flow drives USB1 DRVVBUS (GPIO94) high to source 5 V when a
	 * device attaches in source role (drivers/misc/mediatek/usb_c/.../
	 * usb_typec.c; aeon_gpio.dtsi labels GPIO94 "usb1_drvvbus"). Active
	 * high, left off at boot.
	 */
	usb_p1_vbus: regulator-usb-p1-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb-p1-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&pio 94 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/*
	 * Single-cell Li-Ion pack. The design capacity is the vendor
	 * fuel-gauge Q_MAX at 25 C (mt_battery_meter.h: Q_MAX_POS_25 =
	 * 4268 mAh). The open-circuit-voltage table is taken from the vendor
	 * 25 C profile battery_profile_t2[] in mt_battery_meter_table.h, which
	 * lists depth-of-discharge against resting voltage in mV; the capacity
	 * column here is 100 - depth-of-discharge.
	 */
	battery: battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <4268000>;
		voltage-min-design-microvolt = <3400000>;
		voltage-max-design-microvolt = <4357000>;
		ocv-capacity-celsius = <25>;
		ocv-capacity-table-0 =
			<4357000 100>, <4301000 95>, <4248000 91>, <4196000 86>,
			<4132000 80>, <4082000 75>, <4023000 70>, <3970000 65>,
			<3941000 60>, <3888000 56>, <3849000 50>, <3826000 45>,
			<3807000 40>, <3789000 35>, <3776000 30>, <3760000 25>,
			<3739000 19>, <3715000 15>, <3688000 10>, <3681000 5>,
			<3483000 1>, <3400000 0>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		memory@40000000 {
			reg = <0 0x40000000 0 0x1000>;
			no-map;
		};

		memory@44400000 {
			reg = <0 0x44400000 0 0x10000>;
			no-map;
		};

		ramoops@44410000 {
			compatible = "ramoops";
			reg = <0 0x44410000 0 0xe0000>;
			record-size = <0x1000>;
			console-size = <0x10000>;
			ftrace-size = <0x1000>;
			pmsg-size = <0x20000>;
			mem-type = <0>;
			no-map;
		};

		memory@444f0000 {
			reg = <0 0x444f0000 0 0x10000>;
			no-map;
		};

		memory@44600000 {
			reg = <0 0x44600000 0 0x10000>;
			no-map;
		};

		memory@44610000 {
			reg = <0 0x44610000 0 0x30000>;
			no-map;
		};

		memory@44640000 {
			reg = <0 0x44640000 0 0x30000>;
			no-map;
		};

		memory@44800000 {
			reg = <0 0x44800000 0 0x100000>;
			no-map;
		};

		memory@46000000 {
			reg = <0 0x46000000 0 0x400000>;
			no-map;
		};
	};
};

&mt6351regulator {
	mt6351_vemc_reg: ldo-vemc {
		regulator-name = "vemc_3v3";
		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
	};

	mt6351_vio18_reg: ldo-vio18 {
		regulator-name = "vio18";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	mt6351_vmch_reg: ldo-vmch {
		regulator-name = "vmch_3v3";
		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3300000>;
	};

	mt6351_vmc_reg: ldo-vmc {
		regulator-name = "vmc";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;
	};

	mt6351_vibr_reg: ldo-vibr {
		regulator-name = "vibr";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
	};
};

&pmic {
	/*
	 * MT6351 ISINK current-sink LEDs. Vendor aeon6797_6m_n.dts led@0/led@1
	 * drive the red/green indicators from ISINK0/ISINK1 (led_mode = 3).
	 */
	leds {
		compatible = "mediatek,mt6351-led";
		#address-cells = <1>;
		#size-cells = <0>;

		led@0 {
			reg = <0>;
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_INDICATOR;
		};

		led@1 {
			reg = <1>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_INDICATOR;
		};
	};
};

&pio {
	/*
	 * MT6797 pinctrl currently supports pinmux only for these pads:
	 * its descriptor has no pull, IES, or drive-strength register maps.
	 * Keep boot-firmware pad configuration until those maps are recovered.
	 */
	uart0_gemini_pins: uart0-gemini-pins {
		pins-rx-tx {
			pinmux = <MT6797_GPIO97__FUNC_URXD0>,
				 <MT6797_GPIO98__FUNC_UTXD0>;
		};
	};

	mmc0_pins_default: mmc0-default-pins {
		pins-cmd-dat {
			pinmux = <MT6797_GPIO114__FUNC_MSDC0_DAT0>,
				 <MT6797_GPIO115__FUNC_MSDC0_DAT1>,
				 <MT6797_GPIO116__FUNC_MSDC0_DAT2>,
				 <MT6797_GPIO117__FUNC_MSDC0_DAT3>,
				 <MT6797_GPIO118__FUNC_MSDC0_DAT4>,
				 <MT6797_GPIO119__FUNC_MSDC0_DAT5>,
				 <MT6797_GPIO120__FUNC_MSDC0_DAT6>,
				 <MT6797_GPIO121__FUNC_MSDC0_DAT7>,
				 <MT6797_GPIO122__FUNC_MSDC0_CMD>;
		};

		pins-clk {
			pinmux = <MT6797_GPIO123__FUNC_MSDC0_CLK>;
		};

		pins-ds {
			pinmux = <MT6797_GPIO124__FUNC_MSDC0_DSL>;
		};

		pins-rst {
			pinmux = <MT6797_GPIO125__FUNC_MSDC0_RSTB>;
		};
	};

	mmc1_pins_default: mmc1-default-pins {
		pins-cmd-dat {
			pinmux = <MT6797_GPIO130__FUNC_MSDC1_DAT0>,
				 <MT6797_GPIO131__FUNC_MSDC1_DAT1>,
				 <MT6797_GPIO132__FUNC_MSDC1_DAT2>,
				 <MT6797_GPIO133__FUNC_MSDC1_DAT3>,
				 <MT6797_GPIO129__FUNC_MSDC1_CMD>;
		};

		pins-clk {
			pinmux = <MT6797_GPIO134__FUNC_MSDC1_CLK>;
		};
	};

	hall_pins: hall-pins {
		pins-hall {
			pinmux = <MT6797_GPIO66__FUNC_GPIO66>;
		};
	};
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_gemini_pins>;
	status = "okay";
};

&mmc0 {
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_pins_default>;
	pinctrl-1 = <&mmc0_pins_default>;
	bus-width = <8>;
	max-frequency = <25000000>;
	vmmc-supply = <&mt6351_vemc_reg>;
	vqmmc-supply = <&mt6351_vio18_reg>;
	non-removable;
	no-sd;
	no-sdio;
	status = "okay";
};

&mmc1 {
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc1_pins_default>;
	pinctrl-1 = <&mmc1_pins_default>;
	bus-width = <4>;
	max-frequency = <200000000>;
	cap-sd-highspeed;
	sd-uhs-sdr12;
	sd-uhs-sdr25;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	cd-gpios = <&pio 67 GPIO_ACTIVE_HIGH>;
	vmmc-supply = <&mt6351_vmch_reg>;
	vqmmc-supply = <&mt6351_vmc_reg>;
	no-mmc;
	no-sdio;
	status = "okay";
};

&i2c6 {
	clock-frequency = <3400000>;
	mediatek,use-push-pull;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c6_pins_a>;
	status = "okay";

	da9214: regulator@68 {
		compatible = "dlg,da9214";
		reg = <0x68>;

		regulators {
			da9214_bucka: BUCKA {
				regulator-name = "da9214-bucka";
			};

			da9214_buckb: BUCKB {
				regulator-name = "vproc-big";
			};
		};
	};
};

&i2c7 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c7_pins_a>;

	/* Live Gemian identifies the external GPU buck as RT5735 at 0x1c. */
	rt5735_vgpu: regulator@1c {
		compatible = "richtek,rt5735";
		reg = <0x1c>;
		regulator-name = "vgpu";
		regulator-min-microvolt = <862500>;
		regulator-max-microvolt = <1131250>;
		regulator-ramp-delay = <32000>;
	};
};

&pio {
	lcd_bias_pins: lcd-bias-pins {
		pins-enp-enn {
			pinmux = <MT6797_GPIO60__FUNC_GPIO60>,
				 <MT6797_GPIO251__FUNC_GPIO251>;
		};
	};
};

&i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_pins_a>;
	status = "okay";

	/*
	 * Bosch BMI160 accelerometer/gyroscope. The vendor rewrites its logical
	 * 0x68 client to 0x69 in probe, which is the live I2C1 address. The
	 * mount-matrix is the vendor coordinate direction 7 (aeon6797_6m_n.dts
	 * cust_accel@1/cust_gyro@1) expanded through the MediaTek hwmsen
	 * conversion table (sign {-1,-1,-1}, axis map {1,0,2}).
	 */
	bmi160: imu@69 {
		compatible = "bosch,bmi160";
		reg = <0x69>;
		mount-matrix = "0", "-1", "0",
			       "-1", "0", "0",
			       "0", "0", "-1";
	};

	/*
	 * LCD bias for the internal panel. The vendor driver treats it as an
	 * "lp3101" at I2C1 0x3e, which is register-compatible with the TI
	 * TPS65132 dual output regulator. ENP (GPIO60) gates the positive OUTP
	 * rail and ENN (GPIO251) the negative OUTN rail, both active-high per
	 * aeon_gpio.dtsi:143-170. The vendor LCM writes VPOS/VNEG = 0x0f, i.e.
	 * +/-5.5 V (lp3101.c:105-125).
	 */
	lcd_bias: regulator@3e {
		compatible = "ti,tps65132";
		reg = <0x3e>;
		pinctrl-names = "default";
		pinctrl-0 = <&lcd_bias_pins>;

		reg_lcd_bias_outp: outp {
			regulator-name = "lcd-bias-outp";
			regulator-min-microvolt = <5500000>;
			regulator-max-microvolt = <5500000>;
			enable-gpios = <&pio 60 GPIO_ACTIVE_HIGH>;
		};

		reg_lcd_bias_outn: outn {
			regulator-name = "lcd-bias-outn";
			regulator-min-microvolt = <5500000>;
			regulator-max-microvolt = <5500000>;
			enable-gpios = <&pio 251 GPIO_ACTIVE_HIGH>;
		};
	};

	/*
	 * Sensortek STK3x1x ambient-light/proximity sensor. Vendor
	 * aeon6797_6m_n.dts cust_alsps@0 uses I2C1 0x48 with EINT on
	 * GPIO88 (= EINT11, alspspincfg) and ps_threshold_high = 50.
	 */
	light-sensor@48 {
		compatible = "sensortek,stk3310";
		reg = <0x48>;
		interrupt-parent = <&pio>;
		interrupts = <11 IRQ_TYPE_LEVEL_LOW>;
		proximity-near-level = <50>;
	};
};

&i2c4 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c4_pins_a>;
	status = "okay";

	/*
	 * Novatek NT36772 TDDI touchscreen. Verified against the vendor
	 * aeon6797_6m_n.dts: I2C4 0x62, interrupt on GPIO85/EINT8, reset on
	 * GPIO68. As a TDDI controller it shares the panel's always-on rails,
	 * which are not switchable from this node, so no supply is described.
	 * The driver applies the vendor portrait orientation (swap X/Y, invert
	 * Y) internally, so no touchscreen-* transform properties are set.
	 * Kept disabled until the reset polarity and the 0x62-to-0x01 target
	 * transition are validated on hardware.
	 */
	touchscreen@62 {
		compatible = "novatek,nt36772-ts";
		reg = <0x62>;
		interrupt-parent = <&pio>;
		interrupts = <8 IRQ_TYPE_EDGE_RISING>;
		reset-gpios = <&pio 68 GPIO_ACTIVE_HIGH>;
		status = "disabled";
	};
};

&watchdog {
	interrupts = <GIC_SPI 137 IRQ_TYPE_EDGE_FALLING>;
};

/*
 * Panel backlight driven by the MT6797 display PWM. The vendor backlight
 * node (aeon6797_6m_n.dts led6, "mediatek,lcd-backlight") selects
 * led_mode = <5>, i.e. the display PWM source.
 */
&disp_pwm {
	status = "okay";
};

&{/} {
	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&disp_pwm 0 500000>;
		brightness-levels = <0 16 32 48 64 80 96 112 128
				     144 160 176 192 208 224 240 255>;
		default-brightness-level = <10>;
	};
};

&pio {
	keyboard_soc_pins: keyboard-soc-pins {
		pins-reset {
			pinmux = <MT6797_GPIO58__FUNC_GPIO58>;
			output-high;
		};

		pins-irq {
			pinmux = <MT6797_GPIO87__FUNC_EINT10>;
		};
	};
};

&i2c5 {
	/* Keep the bus and both consumers disabled until a safe keyboard test. */
	pinctrl-names = "default";
	pinctrl-0 = <&i2c5_pins_a>;

	aw9523: gpio-expander@5b {
		compatible = "awinic,aw9523-pinctrl";
		reg = <0x5b>;
		pinctrl-names = "default";
		pinctrl-0 = <&keyboard_soc_pins>;
		interrupt-parent = <&pio>;
		interrupts = <10 IRQ_TYPE_LEVEL_LOW>;
		gpio-controller;
		#gpio-cells = <2>;
		gpio-ranges = <&aw9523 0 0 16>;
		interrupt-controller;
		#interrupt-cells = <2>;
		reset-gpios = <&pio 58 GPIO_ACTIVE_HIGH>;
		status = "disabled";

		keyboard_matrix_row_pins: keyboard-matrix-row-pins {
			pins = "gpio0", "gpio1", "gpio2", "gpio3",
			       "gpio4", "gpio5", "gpio6", "gpio7";
			function = "gpio";
			bias-pull-up;
			drive-open-drain;
			input-enable;
		};

		keyboard_matrix_col_pins: keyboard-matrix-col-pins {
			pins = "gpio8", "gpio9", "gpio10", "gpio11",
			       "gpio12", "gpio13", "gpio14";
			function = "gpio";
			input-disable;
			output-low;
		};
	};
};

&{/} {
	keyboard-matrix {
		compatible = "gpio-matrix-keypad";
		pinctrl-names = "default";
		gpio-activelow;
		drive-inactive-cols;
		pinctrl-0 = <&keyboard_matrix_row_pins
				     &keyboard_matrix_col_pins>;
		row-gpios = <&aw9523 0 GPIO_ACTIVE_HIGH>,
			    <&aw9523 1 GPIO_ACTIVE_HIGH>,
			    <&aw9523 2 GPIO_ACTIVE_HIGH>,
			    <&aw9523 3 GPIO_ACTIVE_HIGH>,
			    <&aw9523 4 GPIO_ACTIVE_HIGH>,
			    <&aw9523 5 GPIO_ACTIVE_HIGH>,
			    <&aw9523 6 GPIO_ACTIVE_HIGH>,
			    <&aw9523 7 GPIO_ACTIVE_HIGH>;
		col-gpios = <&aw9523 8 GPIO_ACTIVE_HIGH>,
			    <&aw9523 9 GPIO_ACTIVE_HIGH>,
			    <&aw9523 10 GPIO_ACTIVE_HIGH>,
			    <&aw9523 11 GPIO_ACTIVE_HIGH>,
			    <&aw9523 12 GPIO_ACTIVE_HIGH>,
			    <&aw9523 13 GPIO_ACTIVE_HIGH>,
			    <&aw9523 14 GPIO_ACTIVE_HIGH>;
		linux,keymap = <
			MATRIX_KEY(0, 0, KEY_1)
			MATRIX_KEY(1, 0, KEY_U)
			MATRIX_KEY(2, 0, KEY_S)
			MATRIX_KEY(3, 0, KEY_Z)
			MATRIX_KEY(4, 0, KEY_COMMA)
			MATRIX_KEY(5, 0, KEY_APOSTROPHE)
			MATRIX_KEY(6, 0, KEY_8)
			MATRIX_KEY(7, 0, KEY_J)
			MATRIX_KEY(0, 1, KEY_2)
			MATRIX_KEY(1, 1, KEY_W)
			MATRIX_KEY(2, 1, KEY_D)
			MATRIX_KEY(3, 1, KEY_C)
			MATRIX_KEY(4, 1, KEY_LEFTALT)
			MATRIX_KEY(5, 1, KEY_LEFT)
			MATRIX_KEY(6, 1, KEY_9)
			MATRIX_KEY(7, 1, KEY_K)
			MATRIX_KEY(0, 2, KEY_3)
			MATRIX_KEY(1, 2, KEY_Y)
			MATRIX_KEY(2, 2, KEY_TAB)
			MATRIX_KEY(3, 2, KEY_N)
			MATRIX_KEY(4, 2, KEY_M)
			MATRIX_KEY(5, 2, KEY_DOWN)
			MATRIX_KEY(6, 2, KEY_BACKSPACE)
			MATRIX_KEY(7, 2, KEY_I)
			MATRIX_KEY(0, 3, KEY_4)
			MATRIX_KEY(1, 3, KEY_T)
			MATRIX_KEY(2, 3, KEY_F)
			MATRIX_KEY(3, 3, KEY_X)
			MATRIX_KEY(4, 3, KEY_LEFTMETA)
			MATRIX_KEY(5, 3, KEY_RIGHTSHIFT)
			MATRIX_KEY(6, 3, KEY_P)
			MATRIX_KEY(0, 4, KEY_5)
			MATRIX_KEY(1, 4, KEY_E)
			MATRIX_KEY(2, 4, KEY_G)
			MATRIX_KEY(3, 4, KEY_V)
			MATRIX_KEY(4, 4, KEY_SPACE)
			MATRIX_KEY(5, 4, KEY_UP)
			MATRIX_KEY(6, 4, KEY_O)
			MATRIX_KEY(0, 5, KEY_6)
			MATRIX_KEY(1, 5, KEY_Q)
			MATRIX_KEY(2, 5, KEY_A)
			MATRIX_KEY(3, 5, KEY_B)
			MATRIX_KEY(4, 5, KEY_DOT)
			MATRIX_KEY(5, 5, KEY_RIGHT)
			MATRIX_KEY(6, 5, KEY_ENTER)
			MATRIX_KEY(0, 6, KEY_7)
			MATRIX_KEY(1, 6, KEY_R)
			MATRIX_KEY(2, 6, KEY_H)
			MATRIX_KEY(3, 6, KEY_LEFTSHIFT)
			MATRIX_KEY(4, 6, KEY_LEFTCTRL)
			MATRIX_KEY(5, 6, KEY_L)
			MATRIX_KEY(6, 6, KEY_0)>;
		status = "disabled";
	};
};

/*
 * The left USB-C connector is wired to the MTU3 device controller. Keep the
 * controller disabled in the normal board description; a bounded diagnostic
 * overlay may enable these already-described resources for bring-up.
 */
&u2port0 {
	clocks = <&clk26m>;
	mediatek,force-b-session-valid;
};

&ssusb {
	assigned-clocks = <&topckgen CLK_TOP_MUX_SSUSB_TOP_SYS>;
	assigned-clock-parents = <&topckgen CLK_TOP_UNIVPLL3_D2>;
	phys = <&u2port0 PHY_TYPE_USB2>;
	dr_mode = "peripheral";
	maximum-speed = "high-speed";
};

&thermal {
	nvmem-cells = <&mt6797_thermal_calibration>;
	nvmem-cell-names = "calibration-data";
};

&i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pins_a>;
	status = "okay";

	/*
	 * ON Semi FUSB301A autonomous Type-C controller for the right USB-C
	 * port. Its active-low interrupt is wired to GPIO64/EINT3; the FUSB301A
	 * on I2C1 has no usable interrupt line and is therefore not described.
	 */
	fusb301: typec@25 {
		compatible = "onnn,fusb301a";
		reg = <0x25>;
		interrupt-parent = <&pio>;
		interrupts = <3 IRQ_TYPE_LEVEL_LOW>;

		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			power-role = "dual";
			data-role = "dual";
			typec-power-opmode = "default";
			pd-disable;
			vbus-supply = <&usb_p1_vbus>;
		};
	};

	/*
	 * TI BQ25896 single-cell Li-Ion charger. The vendor DT mislabels it
	 * "bq24261@6b", but the board enables MTK_BQ25896_SUPPORT and the part
	 * answers at 0x6b. Its INT line is not routed (the vendor firmware
	 * tracks the MT6351 charger-detect comparator instead), so the driver
	 * polls the status registers.
	 *
	 * Charge voltage (4.416 V) and current (2.048 A) match the vendor
	 * settings. Termination (256 mA), precharge (128 mA), minimum system
	 * voltage (3.5 V) and boost voltage (5.126 V) are the BQ25896 power-on
	 * reset defaults (REG05 = 0x13, REG03 = 0x1a, REG0A = 0x93); the vendor
	 * does not reprogram them. The 1.3 A boost current limit matches the
	 * value the vendor firmware writes.
	 */
	charger: charger@6b {
		compatible = "ti,bq25896", "ti,bq25890";
		reg = <0x6b>;

		monitored-battery = <&battery>;

		ti,battery-regulation-voltage = <4416000>;
		ti,charge-current = <2048000>;
		ti,termination-current = <256000>;
		ti,precharge-current = <128000>;
		ti,minimum-sys-voltage = <3500000>;
		ti,boost-voltage = <5126000>;
		ti,boost-max-current = <1300000>;
	};

	/* FAN49101 is populated, but keep the regulator and consumer disabled. */
	fan49101: regulator@70 {
		compatible = "onnn,fan49101";
		reg = <0x70>;
		status = "disabled";

		regulators {
			fan49101_vout: vout {
				regulator-name = "fan49101-vout";
				regulator-min-microvolt = <603000>;
				regulator-max-microvolt = <1413000>;
			};
		};
	};
};

&i2c3 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3_pins_a>;
	status = "okay";

	/*
	 * Awinic AW9120 20-channel constant-current LED controller (I2C3 0x2c,
	 * PDN GPIO245; docs/driver-port-inventory.md). The per-channel colour
	 * map is taken from the gemian-leds daemon (LightState.cpp
	 * AWLEDCodeForStep plus the CH_6/CH_7 defines): five RGB indicator
	 * blocks, an RGB status LED, a caps-lock LED and a power LED.
	 */
	led-controller@2c {
		compatible = "awinic,aw9120";
		reg = <0x2c>;
		#address-cells = <1>;
		#size-cells = <0>;
		enable-gpios = <&pio 245 GPIO_ACTIVE_HIGH>;

		led@0 {
			reg = <0>;
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_INDICATOR;
			function-enumerator = <1>;
		};

		led@1 {
			reg = <1>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_INDICATOR;
			function-enumerator = <1>;
		};

		led@2 {
			reg = <2>;
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_INDICATOR;
			function-enumerator = <1>;
		};

		led@3 {
			reg = <3>;
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_INDICATOR;
			function-enumerator = <3>;
		};

		led@4 {
			reg = <4>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_INDICATOR;
			function-enumerator = <3>;
		};

		led@5 {
			reg = <5>;
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_INDICATOR;
			function-enumerator = <3>;
		};

		led@6 {
			reg = <6>;
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_INDICATOR;
			function-enumerator = <4>;
		};

		led@7 {
			reg = <7>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_INDICATOR;
			function-enumerator = <4>;
		};

		led@8 {
			reg = <8>;
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_INDICATOR;
			function-enumerator = <4>;
		};

		led@9 {
			reg = <9>;
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_INDICATOR;
			function-enumerator = <5>;
		};

		led@a {
			reg = <10>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_INDICATOR;
			function-enumerator = <5>;
		};

		led@b {
			reg = <11>;
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_INDICATOR;
			function-enumerator = <5>;
		};

		led@c {
			reg = <12>;
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_INDICATOR;
			function-enumerator = <2>;
		};

		led@d {
			reg = <13>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_INDICATOR;
			function-enumerator = <2>;
		};

		led@e {
			reg = <14>;
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_INDICATOR;
			function-enumerator = <2>;
		};

		led@f {
			reg = <15>;
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
		};

		led@10 {
			reg = <16>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
		};

		led@11 {
			reg = <17>;
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
		};

		led@12 {
			reg = <18>;
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_CAPSLOCK;
		};

		led@13 {
			reg = <19>;
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_POWER;
		};
	};
};

&mfgsys {
	status = "okay";
};

&gpu {
	mali-supply = <&rt5735_vgpu>;
	status = "okay";
};

&{/} {
	hall_gpio_keys: gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&hall_pins>;

		hall-switch {
			/* Vendor hall.c maps raw low to FCOVER_CLOSE/SW_LID=1. */
			label = "Hall lid";
			linux,input-type = <EV_SW>;
			linux,code = <SW_LID>;
			gpios = <&pio 66 GPIO_ACTIVE_LOW>;
			debounce-interval = <64>;
		};
	};
};

&pio {
	panel_pins: panel-pins {
		pins-reset {
			pinmux = <MT6797_GPIO180__FUNC_GPIO180>;
		};
	};
};

&mipi_tx0 {
	status = "okay";
};

&dsi0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	/*
	 * NT36672-class FHD+ DSI video panel (vendor LCM
	 * aeon_nt36672_fhd_dsi_vdo_x600_xinli): 4-lane burst mode, reset on
	 * GPIO180 (LCM_RST). OUTP/OUTN are the TPS65132 bias rails; the vendor
	 * sequence enables both before releasing reset. VDDI is not switched by
	 * the vendor LCM (its PMIC VGP1 calls are commented out), so no digital
	 * supply is described here.
	 */
	panel@0 {
		compatible = "planet,gemini-pda-nt36672";
		reg = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&panel_pins>;
		reset-gpios = <&pio 180 GPIO_ACTIVE_HIGH>;
		outp-supply = <&reg_lcd_bias_outp>;
		outn-supply = <&reg_lcd_bias_outn>;
		backlight = <&backlight>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi0_out_ep>;
			};
		};
	};
};

&dsi0_out {
	dsi0_out_ep: endpoint {
		remote-endpoint = <&panel_in>;
	};
};

&afe {
	status = "okay";
};

&pmic {
	mt6351_codec: audio-codec {
		compatible = "mediatek,mt6351-sound";
	};

	accdet: accdet {
		compatible = "mediatek,mt6351-accdet";
		io-channels = <&pmic_adc MT6351_AUXADC_ACCDET>;
		io-channel-names = "accdet";
		mediatek,mic-vol = <7>;
		mediatek,mic-mode = <1>;
		mediatek,key-mode = <0>;
		mediatek,pwm-deb-setting = <0x500 0x500 1 0x1f0 0x800 0x800 0x20>;
		mediatek,three-key-thr = <0 80 220 400>;
	};
};

&{/} {
	sound {
		compatible = "mediatek,mt6797-mt6351-sound";
		mediatek,platform = <&afe>;
		mediatek,audio-codec = <&mt6351_codec>;
		mediatek,accdet = <&accdet>;
	};
};
