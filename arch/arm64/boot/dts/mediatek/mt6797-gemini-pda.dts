/dts-v1/;

#include "mt6797.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	model = "Planet Computers Gemini PDA";
	chassis-type = "handset";
	compatible = "planet,gemini-pda", "mediatek,mt6797";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:921600n8";
	};

	/*
	 * GPU operating points for this board's MT6797 speed bin. The
	 * frequency/voltage pairs are the vendor 3.18 mt_gpufreq non-M-bin
	 * grid (238-700 MHz); M-bin parts use a disjoint grid topping out at
	 * 600 MHz, so this table is not valid for every MT6797 and lives in
	 * the board DTS rather than the shared SoC dtsi.
	 */
	gpu_opp_table: opp-table-gpu {
		compatible = "operating-points-v2";
		opp-shared;

		opp-238000000 {
			opp-hz = /bits/ 64 <238000000>;
			opp-microvolt = <862500>;
		};
		opp-365000000 {
			opp-hz = /bits/ 64 <365000000>;
			opp-microvolt = <912500>;
		};
		opp-442500000 {
			opp-hz = /bits/ 64 <442500000>;
			opp-microvolt = <975000>;
		};
		opp-520000000 {
			opp-hz = /bits/ 64 <520000000>;
			opp-microvolt = <1006250>;
		};
		opp-610000000 {
			opp-hz = /bits/ 64 <610000000>;
			opp-microvolt = <1081250>;
		};
		opp-700000000 {
			opp-hz = /bits/ 64 <700000000>;
			opp-microvolt = <1131250>;
		};
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0 0x40000000 1 0>;
	};

	/*
	 * VBUS switch for the right USB-C port (USB11 MUSB host). The vendor
	 * Type-C flow drives USB1 DRVVBUS (GPIO94) high to source 5 V when a
	 * device attaches in source role (drivers/misc/mediatek/usb_c/.../
	 * usb_typec.c; aeon_gpio.dtsi labels GPIO94 "usb1_drvvbus"). Active
	 * high, left off at boot.
	 */
	usb_p1_vbus: regulator-usb-p1-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb-p1-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&pio 94 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/*
	 * Single-cell Li-Ion pack. The design capacity is the vendor
	 * fuel-gauge Q_MAX at 25 C (mt_battery_meter.h: Q_MAX_POS_25 =
	 * 4268 mAh). The open-circuit-voltage table is taken from the vendor
	 * 25 C profile battery_profile_t2[] in mt_battery_meter_table.h, which
	 * lists depth-of-discharge against resting voltage in mV; the capacity
	 * column here is 100 - depth-of-discharge.
	 */
	battery: battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <4268000>;
		voltage-min-design-microvolt = <3400000>;
		voltage-max-design-microvolt = <4416000>;
		ocv-capacity-celsius = <25>;
		ocv-capacity-table-0 =
			<4357000 100>, <4301000 95>, <4248000 91>, <4196000 86>,
			<4132000 80>, <4082000 75>, <4023000 70>, <3970000 65>,
			<3941000 60>, <3888000 56>, <3849000 50>, <3826000 45>,
			<3807000 40>, <3789000 35>, <3776000 30>, <3760000 25>,
			<3739000 19>, <3715000 15>, <3688000 10>, <3681000 5>,
			<3483000 1>, <3400000 0>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/*
		 * Fixed firmware reservations carried over from the vendor
		 * mt6797.dtsi. By base address the owners are: 0x40000000 the
		 * preloader-preserved first DRAM page; 0x44400000 ram_console;
		 * 0x44410000 pstore/ramoops; 0x444f0000 minirdump; 0x44600000
		 * ARM Trusted Firmware; 0x44610000 ATF ramdump; 0x44640000
		 * i-cache dump; 0x44800000 preloader; 0x46000000 LK. Linux must
		 * not map any of them (no-map); the retained MT6797 LK adds its
		 * further runtime mblock reservations after this DT is loaded.
		 */
		memory@40000000 {
			reg = <0 0x40000000 0 0x1000>;
			no-map;
		};

		memory@44400000 {
			reg = <0 0x44400000 0 0x10000>;
			no-map;
		};

		ramoops@44410000 {
			compatible = "ramoops";
			reg = <0 0x44410000 0 0xe0000>;
			record-size = <0x1000>;
			console-size = <0x10000>;
			ftrace-size = <0x1000>;
			pmsg-size = <0x20000>;
			mem-type = <0>;
			no-map;
		};

		memory@444f0000 {
			reg = <0 0x444f0000 0 0x10000>;
			no-map;
		};

		memory@44600000 {
			reg = <0 0x44600000 0 0x10000>;
			no-map;
		};

		memory@44610000 {
			reg = <0 0x44610000 0 0x30000>;
			no-map;
		};

		memory@44640000 {
			reg = <0 0x44640000 0 0x30000>;
			no-map;
		};

		memory@44800000 {
			reg = <0 0x44800000 0 0x100000>;
			no-map;
		};

		memory@46000000 {
			reg = <0 0x46000000 0 0x400000>;
			no-map;
		};
	};
};

&mt6351regulator {
	mt6351_vemc_reg: ldo-vemc {
		regulator-name = "vemc_3v3";
		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
	};

	mt6351_vio18_reg: ldo-vio18 {
		regulator-name = "vio18";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	mt6351_vmch_reg: ldo-vmch {
		regulator-name = "vmch_3v3";
		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3300000>;
	};

	mt6351_vmc_reg: ldo-vmc {
		regulator-name = "vmc";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;
	};
};

&pmic {
	/*
	 * MT6351 ISINK current-sink LEDs. Vendor aeon6797_6m_n.dts led@0/led@1
	 * drive the red/green indicators from ISINK0/ISINK1 (led_mode = 3).
	 */
	leds {
		compatible = "mediatek,mt6351-led";
		#address-cells = <1>;
		#size-cells = <0>;

		led@0 {
			reg = <0>;
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_INDICATOR;
		};

		led@1 {
			reg = <1>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_INDICATOR;
		};
	};
};

&pio {
	uart0_gemini_pins: uart0-gemini-pins {
		pins-rx-tx {
			pinmux = <MT6797_GPIO97__FUNC_URXD0>,
				 <MT6797_GPIO98__FUNC_UTXD0>;
		};
	};

	mmc0_pins_default: mmc0-default-pins {
		pins-cmd-dat {
	/*
	 * Pull and drive values follow the vendor aeon6797_6m_n.dts mmc1 groups
	 * (cmd/dat pull-up, clk pull-down; drive-strength is written as a raw
	 * MT6797 register code as on all MT6797 pads). Card detect is GPIO67
	 * (vendor EINT6) with an internal pull-up.
	 */
	mmc1_pins_default: mmc1-default-pins {
		pins-cmd-dat {
			pinmux = <MT6797_GPIO130__FUNC_MSDC1_DAT0>,
				 <MT6797_GPIO131__FUNC_MSDC1_DAT1>,
				 <MT6797_GPIO132__FUNC_MSDC1_DAT2>,
				 <MT6797_GPIO133__FUNC_MSDC1_DAT3>,
				 <MT6797_GPIO129__FUNC_MSDC1_CMD>;
			drive-strength = <4>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};

		pins-clk {
			pinmux = <MT6797_GPIO134__FUNC_MSDC1_CLK>;
			drive-strength = <4>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};
	};

	mmc1_cd_pins: mmc1-cd-pins {
		pins-cd {
			pinmux = <MT6797_GPIO67__FUNC_GPIO67>;
			input-enable;
			bias-pull-up;
		};
	};

			pinmux = <MT6797_GPIO114__FUNC_MSDC0_DAT0>,
				 <MT6797_GPIO115__FUNC_MSDC0_DAT1>,
				 <MT6797_GPIO116__FUNC_MSDC0_DAT2>,
				 <MT6797_GPIO117__FUNC_MSDC0_DAT3>,
				 <MT6797_GPIO118__FUNC_MSDC0_DAT4>,
				 <MT6797_GPIO119__FUNC_MSDC0_DAT5>,
				 <MT6797_GPIO120__FUNC_MSDC0_DAT6>,
				 <MT6797_GPIO121__FUNC_MSDC0_DAT7>,
				 <MT6797_GPIO122__FUNC_MSDC0_CMD>;
		};

		pins-clk {
			pinmux = <MT6797_GPIO123__FUNC_MSDC0_CLK>;
		};

		pins-ds {
			pinmux = <MT6797_GPIO124__FUNC_MSDC0_DSL>;
		};

		pins-rst {
			pinmux = <MT6797_GPIO125__FUNC_MSDC0_RSTB>;
		};
	};
};

&uart0 {
	pinctrl-names = "default";
&mmc1 {
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc1_pins_default>, <&mmc1_cd_pins>;
	pinctrl-1 = <&mmc1_pins_default>, <&mmc1_cd_pins>;
	bus-width = <4>;
	max-frequency = <200000000>;
	cap-sd-highspeed;
	sd-uhs-sdr12;
	sd-uhs-sdr25;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	cd-gpios = <&pio 67 GPIO_ACTIVE_HIGH>;
	vmmc-supply = <&mt6351_vmch_reg>;
	vqmmc-supply = <&mt6351_vmc_reg>;
	no-mmc;
	no-sdio;
	status = "okay";
};

	pinctrl-0 = <&uart0_gemini_pins>;
	status = "okay";
};

&mmc0 {
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_pins_default>;
	pinctrl-1 = <&mmc0_pins_default>;
	bus-width = <8>;
	max-frequency = <25000000>;
	vmmc-supply = <&mt6351_vemc_reg>;
	vqmmc-supply = <&mt6351_vio18_reg>;
	non-removable;
	no-sd;
	no-sdio;
	status = "okay";
};
&i2c6 {
	clock-frequency = <3400000>;
	mediatek,use-push-pull;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c6_pins_a>;
	status = "okay";

	da9214: regulator@68 {
		compatible = "dlg,da9214";
		reg = <0x68>;

		regulators {
			da9214_bucka: BUCKA {
				regulator-name = "vproc-little";
				regulator-always-on;
				regulator-boot-on;
			};

			da9214_buckb: BUCKB {
				regulator-name = "vproc-big";
				regulator-always-on;
				regulator-boot-on;
			};
		};
	};
};

	/*
	 * TI BQ25896 single-cell Li-Ion charger. The vendor DT mislabels it
	 * "bq24261@6b", but the board enables MTK_BQ25896_SUPPORT and the part
	 * answers at 0x6b. Its INT line is not routed (the vendor firmware
	 * tracks the MT6351 charger-detect comparator instead), so the driver
	 * polls the status registers.
	 *
	 * Charge voltage (4.416 V) and current (2.048 A) match the vendor
	 * settings. Termination (256 mA), precharge (128 mA), minimum system
	 * voltage (3.5 V) and boost voltage (5.126 V) are the BQ25896 power-on
	 * reset defaults (REG05 = 0x13, REG03 = 0x1a, REG0A = 0x93); the vendor
	 * does not reprogram them. The 1.3 A boost current limit matches the
	 * value the vendor firmware writes.
	 */
	charger: charger@6b {
		compatible = "ti,bq25896", "ti,bq25890";
		reg = <0x6b>;

		monitored-battery = <&battery>;

		ti,battery-regulation-voltage = <4416000>;
		ti,charge-current = <2048000>;
		ti,termination-current = <256000>;
		ti,precharge-current = <128000>;
		ti,minimum-sys-voltage = <3500000>;
		ti,boost-voltage = <5126000>;
		ti,boost-max-current = <1300000>;
	};

	keys {
		compatible = "mediatek,mt6351-keys";

		power {
			linux,keycodes = <KEY_POWER>;
			wakeup-source;
		};

		home {
			linux,keycodes = <KEY_HOME>;
		};
	};

&pio {
	lcd_bias_pins: lcd-bias-pins {
		pins-enp-enn {
			pinmux = <MT6797_GPIO60__FUNC_GPIO60>,
				 <MT6797_GPIO251__FUNC_GPIO251>;
		};
	};
};


/*
 * Panel backlight driven by the MT6797 display PWM. The vendor backlight
 * node (aeon6797_6m_n.dts led6, "mediatek,lcd-backlight") selects
 * led_mode = <5>, i.e. the display PWM source.
 */
&disp_pwm {
	status = "okay";
};

&{/} {
	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&disp_pwm 0 500000>;
		brightness-levels = <0 16 32 48 64 80 96 112 128
				     144 160 176 192 208 224 240 255>;
		default-brightness-level = <10>;
	};
};

&pio {
	/*
	 * LCD bias for the internal panel. The vendor driver treats it as an
	 * "lp3101" at I2C1 0x3e, which is register-compatible with the TI
	 * TPS65132 dual output regulator. ENP (GPIO60) gates the positive OUTP
	 * rail and ENN (GPIO251) the negative OUTN rail, both active-high per
	 * aeon_gpio.dtsi:143-170. The vendor LCM writes VPOS/VNEG = 0x0f, i.e.
	 * +/-5.5 V (lp3101.c:105-125).
	 */
	lcd_bias: regulator@3e {
		compatible = "ti,tps65132";
		reg = <0x3e>;
		pinctrl-names = "default";
		pinctrl-0 = <&lcd_bias_pins>;

		reg_lcd_bias_outp: outp {
			regulator-name = "lcd-bias-outp";
			regulator-min-microvolt = <5500000>;
			regulator-max-microvolt = <5500000>;
			enable-gpios = <&pio 60 GPIO_ACTIVE_HIGH>;
		};

		reg_lcd_bias_outn: outn {
			regulator-name = "lcd-bias-outn";
			regulator-min-microvolt = <5500000>;
			regulator-max-microvolt = <5500000>;
			enable-gpios = <&pio 251 GPIO_ACTIVE_HIGH>;
		};
	};
};

&pio {
	panel_pins: panel-pins {
		pins-reset {
			pinmux = <MT6797_GPIO180__FUNC_GPIO180>;
		};
	};
};

&mipi_tx0 {
	status = "okay";
};

&dsi0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	/*
	 * NT36672-class FHD+ DSI video panel (vendor LCM
	 * aeon_nt36672_fhd_dsi_vdo_x600_xinli): 4-lane burst mode, reset on
	 * GPIO180 (LCM_RST). The panel's AVDD/AVEE analog rails are supplied by
	 * the TPS65132 bias OUTP/OUTN outputs; the vendor sequence enables both
	 * before releasing reset. VDDI is not switched by the vendor LCM (its
	 * PMIC VGP1 calls are commented out), so no digital supply is described
	 * here.
	 */
	panel@0 {
		compatible = "planet,gemini-pda-nt36672";
		reg = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&panel_pins>;
		reset-gpios = <&pio 180 GPIO_ACTIVE_HIGH>;
		avdd-supply = <&reg_lcd_bias_outp>;
		avee-supply = <&reg_lcd_bias_outn>;
		backlight = <&backlight>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi0_out_ep>;
			};
		};
	};
};

&dsi0_out {
	dsi0_out_ep: endpoint {
		remote-endpoint = <&panel_in>;
	};
};

&i2c7 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c7_pins_a>;
	status = "okay";

	/* External GPU buck: Richtek RT5735 at I2C address 0x1c. */
	rt5735_vgpu: regulator@1c {
		compatible = "richtek,rt5735";
		reg = <0x1c>;
		regulator-name = "vgpu";
		regulator-min-microvolt = <862500>;
		regulator-max-microvolt = <1131250>;
		regulator-ramp-delay = <32000>;
	};
};

/*
 * The left USB-C connector is wired to the MTU3 device controller. Keep the
 * controller disabled until device-mode operation has been validated on
 * this board.
 */
&u2port0 {
	clocks = <&clk26m>;
};

&ssusb {
	assigned-clocks = <&topckgen CLK_TOP_MUX_SSUSB_TOP_SYS>;
	assigned-clock-parents = <&topckgen CLK_TOP_UNIVPLL3_D2>;
	phys = <&u2port0 PHY_TYPE_USB2>;
	dr_mode = "peripheral";
	maximum-speed = "high-speed";
};

/*
 * The right USB-C connector is wired to the USB11 MUSB controller, which the
 * vendor runs as a full-speed host only (CONFIG_MTK_USBFSH, "Host-only MUSB
 * hardware"). Enable the controller and its USB2 T-PHY; the SoC description
 * already fixes dr_mode = "host". Select the proven 26 MHz PHY reference as
 * on the left-port u2port0.
 */
&usb11_tphy {
	status = "okay";
};

&usb11_u2 {
	clocks = <&clk26m>;
	status = "okay";
};

&usb11 {
	status = "okay";
};

&i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pins_a>;
	status = "okay";

	/*
	 * ON Semi FUSB301A autonomous Type-C controller for the right USB-C
	 * port. Its active-low interrupt is wired to GPIO64/EINT3; the FUSB301A
	 * on I2C1 has no usable interrupt line and is therefore not described.
	 */
	fusb301: typec@25 {
		compatible = "onnn,fusb301a", "onnn,fusb301";
		reg = <0x25>;
		interrupt-parent = <&pio>;
		interrupts = <3 IRQ_TYPE_LEVEL_LOW>;

		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			power-role = "source";
			data-role = "host";
			typec-power-opmode = "default";
			pd-disable;
			vbus-supply = <&usb_p1_vbus>;
		};
	};

	/* FAN49101 is populated, but keep the regulator and consumer disabled. */
	fan49101: regulator@70 {
		compatible = "onnn,fan49101";
		reg = <0x70>;
		status = "disabled";

		regulators {
			fan49101_vout: vout {
				regulator-name = "fan49101-vout";
				regulator-min-microvolt = <603000>;
				regulator-max-microvolt = <1411038>;
			};
		};
	};
};

&mfg_async {
	/*
	 * Keep the GPU (MFG) rail up while the MFG_ASYNC/MFG power domains
	 * are powered. Without it the MFG power-on ack times out, the
	 * power-controller probe fails and its cleanup powers off the
	 * already-on MM domain, blanking the LK-enabled display.
	 */
	domain-supply = <&rt5735_vgpu>;
};

&mfgsys {
	status = "okay";
};

&gpu {
	mali-supply = <&rt5735_vgpu>;
	operating-points-v2 = <&gpu_opp_table>;
	status = "okay";
};
