/dts-v1/;

#include <dt-bindings/clock/qcom,camcc-sc7180.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/media/video-interfaces.h>
#include "sm7125-samsung-common.dtsi"

/ {
	model = "Samsung Galaxy A52";
	compatible = "samsung,a52q", "qcom,sm7125";
	qcom,board-id = <0x22 0x6>;

	/* S2MPB03 camera PMIC on a bit-banged bus (gpio25 SDA, gpio26 SCL) */
	i2c-campmic {
		compatible = "i2c-gpio";
		sda-gpios = <&tlmm 25 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&tlmm 26 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <2>;
		#address-cells = <1>;
		#size-cells = <0>;

		pmic@56 {
			compatible = "samsung,s2mpb03";
			reg = <0x56>;

			regulators {
				vreg_cam_l1: ldo1 {	/* front/UW vdig */
					regulator-min-microvolt = <1050000>;
					regulator-max-microvolt = <1050000>;
				};

				vreg_cam_l2: ldo2 {	/* main vdig */
					regulator-min-microvolt = <1100000>;
					regulator-max-microvolt = <1100000>;
				};

				vreg_cam_l3: ldo3 {	/* vio, all sensors */
					regulator-min-microvolt = <1800000>;
					regulator-max-microvolt = <1800000>;
				};

				vreg_cam_l5: ldo5 {	/* main vana */
					regulator-min-microvolt = <2800000>;
					regulator-max-microvolt = <2800000>;
				};

				vreg_cam_l6: ldo6 {	/* front vana */
					regulator-min-microvolt = <2800000>;
					regulator-max-microvolt = <2800000>;
				};

				vreg_cam_l7: ldo7 {	/* main vaf (VCM) */
					regulator-min-microvolt = <2800000>;
					regulator-max-microvolt = <2800000>;
				};
			};
		};
	};

	/* GPIO-switched camera LDOs */
	vreg_cam0_avdd18: regulator-cam0-avdd18 {
		compatible = "regulator-fixed";
		regulator-name = "cam0_avdd_1p8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		gpio = <&tlmm 63 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	vreg_cam2_vana: regulator-cam2-vana {
		compatible = "regulator-fixed";
		regulator-name = "cam2_vana";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		gpio = <&tlmm 65 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/*
	 * The ultra-wide (S5K3L6XX) and macro (GC5035) cameras share CSIPHY3
	 * through a gpio66 MIPI switch, modelled as a video-mux. gpio66 low
	 * selects the ultra-wide (mux state 0), high the macro (state 1).
	 */
	cam_mipi_mux: mux-controller {
		compatible = "gpio-mux";
		#mux-control-cells = <0>;
		mux-gpios = <&tlmm 66 GPIO_ACTIVE_HIGH>;
	};

	video-mux {
		compatible = "video-mux";
		mux-controls = <&cam_mipi_mux>;
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;	/* mux state 0: ultra-wide */
			vmux_in_uw: endpoint {
				remote-endpoint = <&cam_s5k3l6_ep>;
			};
		};

		port@1 {
			reg = <1>;	/* mux state 1: macro */
			/*
			 * The macro camera is a GalaxyCore GC5035, which has
			 * no mainline binding yet, so its sensor node and this
			 * endpoint's remote are left to a later change.
			 */
			vmux_in_macro: endpoint {
			};
		};

		port@2 {
			reg = <2>;	/* output to CSIPHY3 */
			vmux_out: endpoint {
				remote-endpoint = <&csiphy3_ep>;
			};
		};
	};
};

&rmtfs_mem {
	reg = <0x0 0xf4f00000 0x0 0x202000>;
};

&bluetooth {
	firmware-name = "sm7125/a52q/apnv11.bin";
};

&display_panel {
	compatible = "samsung,s6e3fc3-ams646yd04", "samsung,s6e3fc3";

	status = "okay";
};

&gpu_zap_shader {
	firmware-name = "qcom/sm7125/a52q/a615_zap.mbn";
};

&i2c4 {
	status = "okay";

	usb-switch@25 {
		compatible = "siliconmitus,sm5714-muic";
		reg = <0x25>;
		mode-switch;

		port {
			sm5714_muic_ep: endpoint {
				remote-endpoint = <&sm5714_mux_ep>;
			};
		};
	};

	charger@49 {
		compatible = "siliconmitus,sm5714-charger";
		reg = <0x49>;

		siliconmitus,enable-autostop;
		siliconmitus,input-current-limit = <1300>;
		siliconmitus,charging-current = <1300>;
		siliconmitus,topoff-current = <225>;

		vreg_usb_otg_vbus: usb-otg-vbus {
			regulator-name = "usb_otg_vbus";
		};
	};

	fuel-gauge@71 {
		compatible = "siliconmitus,sm5714-fg";
		reg = <0x71>;
	};
};

&i2c7 {
	status = "okay";
	clock-frequency = <400000>;

	touchscreen@49 {
		compatible = "st,stmfts_fts5cu56a";
		reg = <0x49>;

		pinctrl-names = "default";
		pinctrl-0 = <&tsp_int>;

		interrupt-parent = <&tlmm>;
		interrupts = <9 IRQ_TYPE_LEVEL_LOW>;

		vdd-supply = <&vreg_l10a_1p8>;
		avdd-supply = <&vreg_l7c_3p0>;
	};
};

&i2c11 {
	status = "okay";

	typec@33 {
		compatible = "siliconmitus,sm5714-cc";
		reg = <0x33>;
		interrupts-extended = <&tlmm 104 IRQ_TYPE_LEVEL_LOW>;

		pinctrl-names = "default";
		pinctrl-0 = <&typec_int>;

		vbus-supply = <&vreg_usb_otg_vbus>;

		connector {
			compatible = "usb-c-connector";
			power-role = "dual";
			data-role = "dual";
			try-power-role = "sink";
			typec-power-opmode = "default";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					#address-cells = <1>;
					#size-cells = <0>;

					sm5714_hs_ep: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&usb_1_dwc3_hs>;
					};

					sm5714_mux_ep: endpoint@1 {
						reg = <1>;
						remote-endpoint = <&sm5714_muic_ep>;
					};
				};
			};
		};
	};
};

&ipa {
	firmware-name = "qcom/sm7125/a52q/ipa_fws.mbn";

	status = "okay";
};

&remoteproc_adsp {
	firmware-name = "qcom/sm7125/a52q/adsp.mbn";

	status = "okay";
};

&remoteproc_mpss {
	firmware-name = "qcom/sm7125/a52q/modem.mbn";

	status = "okay";
};

&tlmm {
	tsp_int: tsp-int-state {
		pins = "gpio9";
		function = "gpio";
		bias-disable;
		drive-strength = <2>;
	};

	typec_int: typec-int-state {
		pins = "gpio104";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};
};

&usb_1_dwc3 {
	dr_mode = "otg";
	usb-role-switch;
};

&usb_1_dwc3_hs {
	remote-endpoint = <&sm5714_hs_ep>;
};

&venus {
	firmware-name = "qcom/sm7125/a52q/venus.mbn";
};

&camcc {
	status = "okay";
};

&cci0 {
	status = "okay";
};

/* main: Samsung S5KGW1P, 3-trio C-PHY, CSIPHY0, MCLK0 19.2 MHz */
&cci0_i2c0 {
	cam_main: camera@2d {
		compatible = "samsung,s5kgw1p";
		reg = <0x2d>;
		vio-supply = <&vreg_cam_l3>;
		vana-supply = <&vreg_cam_l5>;
		vdig-supply = <&vreg_cam_l2>;
		vaf-supply = <&vreg_cam_l7>;
		vcustom-supply = <&vreg_cam0_avdd18>;
		clocks = <&camcc CAM_CC_MCLK0_CLK>;
		clock-names = "mclk";
		assigned-clocks = <&camcc CAM_CC_MCLK0_CLK>;
		assigned-clock-rates = <19200000>;
		reset-gpios = <&tlmm 30 GPIO_ACTIVE_LOW>;
		pinctrl-0 = <&cam_mclk0_default>;
		pinctrl-names = "default";		orientation = <1>;
		rotation = <270>;

		port {
			cam_s5kgw1p_ep: endpoint {
				bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
				data-lanes = <1 2 3>;
				link-frequencies = /bits/ 64 <1000000000>;
				remote-endpoint = <&csiphy0_ep>;
			};
		};
	};
};

/* ultra-wide: Samsung S5K3L6XX, 4-lane D-PHY, CSIPHY3 via video-mux, MCLK2 */
&cci0_i2c1 {
	camera@2d {
		compatible = "samsung,s5k3l6xx";
		reg = <0x2d>;
		vddio-supply = <&vreg_cam_l3>;
		vdda-supply = <&vreg_cam2_vana>;
		vddd-supply = <&vreg_cam_l1>;
		clocks = <&camcc CAM_CC_MCLK2_CLK>;
		clock-names = "mclk";
		clock-frequency = <19200000>;
		assigned-clocks = <&camcc CAM_CC_MCLK2_CLK>;
		assigned-clock-rates = <19200000>;
		rstn-gpios = <&tlmm 29 GPIO_ACTIVE_LOW>;
		pinctrl-0 = <&cam_mclk2_default>;
		pinctrl-names = "default";		orientation = <1>;
		rotation = <270>;

		port {
			cam_s5k3l6_ep: endpoint {
				data-lanes = <1 2 3 4>;
				link-frequencies = /bits/ 64 <259200000 480000000 595200000>;
				remote-endpoint = <&vmux_in_uw>;
			};
		};
	};
};

&cci1 {
	status = "okay";
};

/* front: Sony IMX616, 4-lane D-PHY, CSIPHY2, MCLK4 24 MHz */
&cci1_i2c0 {
	camera@1a {
		compatible = "sony,imx616";
		reg = <0x1a>;
		vio-supply = <&vreg_cam_l3>;
		vana-supply = <&vreg_cam_l6>;
		vdig-supply = <&vreg_cam_l1>;
		clocks = <&camcc CAM_CC_MCLK4_CLK>;
		clock-names = "mclk";
		assigned-clocks = <&camcc CAM_CC_MCLK4_CLK>;
		assigned-clock-rates = <24000000>;
		reset-gpios = <&tlmm 21 GPIO_ACTIVE_LOW>;
		pinctrl-0 = <&cam_mclk4_default>;
		pinctrl-names = "default";		orientation = <0>;
		rotation = <90>;

		port {
			cam_imx616_ep: endpoint {
				data-lanes = <1 2 3 4>;
				link-frequencies = /bits/ 64 <516000000>;
				remote-endpoint = <&csiphy2_ep>;
			};
		};
	};
};

&camss {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			csiphy0_ep: endpoint {
				bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
				data-lanes = <0 1 2>;
				remote-endpoint = <&cam_s5kgw1p_ep>;
			};
		};

		port@2 {
			reg = <2>;
			csiphy2_ep: endpoint {
				data-lanes = <0 1 2 3>;
				remote-endpoint = <&cam_imx616_ep>;
			};
		};

		port@3 {
			reg = <3>;
			csiphy3_ep: endpoint {
				data-lanes = <0 1 2 3>;
				remote-endpoint = <&vmux_out>;
			};
		};
	};
};

&tlmm {
	cam_mclk0_default: cam-mclk0-default-state {
		pins = "gpio13";
		function = "cam_mclk";
		drive-strength = <2>;
		bias-disable;
	};

	cam_mclk2_default: cam-mclk2-default-state {
		pins = "gpio15";
		function = "cam_mclk";
		drive-strength = <2>;
		bias-disable;
	};

	cam_mclk4_default: cam-mclk4-default-state {
		pins = "gpio23";
		function = "cam_mclk";
		drive-strength = <2>;
		bias-disable;
	};
};
