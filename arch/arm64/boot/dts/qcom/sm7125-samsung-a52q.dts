/dts-v1/;

#include <dt-bindings/clock/qcom,camcc-sc7180.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/sound/qcom,q6afe.h>
#include <dt-bindings/sound/qcom,q6asm.h>
#include <dt-bindings/sound/qcom,q6dsp-lpass-ports.h>
#include <dt-bindings/media/video-interfaces.h>
#include "sm7125-samsung-common.dtsi"

/ {
	model = "Samsung Galaxy A52";
	compatible = "samsung,a52q", "qcom,sm7125";
	qcom,board-id = <0x22 0x6>;

	vreg_nfc_pvdd: regulator-nfc-pvdd {
		compatible = "regulator-fixed";
		regulator-name = "nfc_pvdd";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		gpio = <&tlmm 68 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/*
	 * Publish the AP sleep state to the ADSP sensor framework (SEE).
	 * Without it the ADSP faults on system suspend, see
	 * drivers/soc/qcom/smp2p_sleepstate.c.
	 */
	smp2p-sleepstate {
		compatible = "qcom,smp2p-sleepstate";
		qcom,smem-states = <&sleepstate_smp2p_out 12>;
		interrupts-extended = <&sleepstate_smp2p_in 0 IRQ_TYPE_EDGE_RISING>;
	};

	/* Stereo speaker amplifiers on a bit-banged I2C bus (SCL stretch) */
	i2c-speaker {
		compatible = "i2c-gpio";
		sda-gpios = <&tlmm 88 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&tlmm 89 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <2>;
		pinctrl-names = "default";
		pinctrl-0 = <&tas2562_active>;
		#address-cells = <1>;
		#size-cells = <0>;

		speaker_right: audio-codec@4c {
			compatible = "ti,tas2562";
			reg = <0x4c>;
			interrupt-parent = <&tlmm>;
			interrupts = <90 IRQ_TYPE_LEVEL_LOW>;
			shutdown-gpios = <&tlmm 94 GPIO_ACTIVE_HIGH>;
			ti,imon-slot-no = <0>;
			ti,rx-slot-width = <16>;
			sound-name-prefix = "Right";
			#sound-dai-cells = <0>;
		};

		speaker_left: audio-codec@4d {
			compatible = "ti,tas2562";
			reg = <0x4d>;
			interrupt-parent = <&tlmm>;
			interrupts = <90 IRQ_TYPE_LEVEL_LOW>;
			shutdown-gpios = <&tlmm 94 GPIO_ACTIVE_HIGH>;
			ti,imon-slot-no = <0>;
			ti,rx-slot-width = <16>;
			sound-name-prefix = "Left";
			#sound-dai-cells = <0>;
		};
	};

	wcd938x: audio-codec {
		compatible = "qcom,wcd9380-codec";

		pinctrl-names = "default";
		pinctrl-0 = <&wcd_reset_default>;

		reset-gpios = <&tlmm 58 GPIO_ACTIVE_LOW>;

		qcom,micbias1-microvolt = <1800000>;
		qcom,micbias2-microvolt = <1800000>;
		qcom,micbias3-microvolt = <1800000>;
		qcom,micbias4-microvolt = <1800000>;
		qcom,mbhc-buttons-vthreshold-microvolt = <75000 150000 237000 500000
							  500000 500000 500000 500000>;
		qcom,mbhc-headset-vthreshold-microvolt = <1700000>;
		qcom,mbhc-headphone-vthreshold-microvolt = <50000>;
		qcom,rx-device = <&wcd_rx>;
		qcom,tx-device = <&wcd_tx>;

		vdd-buck-supply = <&vreg_l15a_1p8>;
		vdd-rxtx-supply = <&vreg_l10a_1p8>;
		vdd-io-supply = <&vreg_l10a_1p8>;
		vdd-mic-bias-supply = <&vreg_bob>;

		#sound-dai-cells = <1>;
	};

	/* S2MPB03 camera PMIC on a bit-banged bus (gpio25 SDA, gpio26 SCL) */
	i2c-campmic {
		compatible = "i2c-gpio";
		sda-gpios = <&tlmm 25 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&tlmm 26 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <2>;
		#address-cells = <1>;
		#size-cells = <0>;

		pmic@56 {
			compatible = "samsung,s2mpb03";
			reg = <0x56>;

			regulators {
				vreg_cam_l1: ldo1 {	/* front/UW vdig */
					regulator-min-microvolt = <1050000>;
					regulator-max-microvolt = <1050000>;
				};

				vreg_cam_l2: ldo2 {	/* main vdig */
					regulator-min-microvolt = <1100000>;
					regulator-max-microvolt = <1100000>;
				};

				vreg_cam_l3: ldo3 {	/* vio, all sensors */
					regulator-min-microvolt = <1800000>;
					regulator-max-microvolt = <1800000>;
				};

				vreg_cam_l4: ldo4 {	/* depth/macro vdig */
					regulator-min-microvolt = <1200000>;
					regulator-max-microvolt = <1200000>;
				};

				vreg_cam_l5: ldo5 {	/* main vana */
					regulator-min-microvolt = <2800000>;
					regulator-max-microvolt = <2800000>;
				};

				vreg_cam_l6: ldo6 {	/* front vana */
					regulator-min-microvolt = <2800000>;
					regulator-max-microvolt = <2800000>;
				};

				vreg_cam_l7: ldo7 {	/* main vaf (VCM) */
					regulator-min-microvolt = <2800000>;
					regulator-max-microvolt = <2800000>;
				};
			};
		};
	};

	/* GPIO-switched camera LDOs */
	vreg_cam0_avdd18: regulator-cam0-avdd18 {
		compatible = "regulator-fixed";
		regulator-name = "cam0_avdd_1p8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		gpio = <&tlmm 63 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	vreg_cam2_vana: regulator-cam2-vana {
		compatible = "regulator-fixed";
		regulator-name = "cam2_vana";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		gpio = <&tlmm 65 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/* avdd for both GC5035 modules (depth and macro), shared gpio64 rail */
	vreg_cam3_vana: regulator-cam3-vana {
		compatible = "regulator-fixed";
		regulator-name = "cam3_vana";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		gpio = <&tlmm 64 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/*
	 * The ultra-wide (S5K3L6XX) and macro (GC5035) cameras share CSIPHY3
	 * through a gpio66 MIPI switch, modelled as a video-mux. gpio66 low
	 * selects the ultra-wide (mux state 0), high the macro (state 1).
	 */
	cam_mipi_mux: mux-controller {
		compatible = "gpio-mux";
		#mux-control-cells = <0>;
		mux-gpios = <&tlmm 66 GPIO_ACTIVE_HIGH>;
	};

	video-mux {
		compatible = "video-mux";
		mux-controls = <&cam_mipi_mux>;
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;	/* mux state 0: ultra-wide */
			vmux_in_uw: endpoint {
				remote-endpoint = <&cam_s5k3l6_ep>;
			};
		};

		port@1 {
			reg = <1>;	/* mux state 1: macro */
			vmux_in_macro: endpoint {
				remote-endpoint = <&cam_gc5035_macro_ep>;
			};
		};

		port@2 {
			reg = <2>;	/* output to CSIPHY3 */
			vmux_out: endpoint {
				remote-endpoint = <&csiphy3_ep>;
			};
		};
	};
};

&q6afedai {
	dai@113 {
		reg = <RX_CODEC_DMA_RX_0>;
	};

	dai@120 {
		reg = <TX_CODEC_DMA_TX_3>;
	};

	dai@127 {
		reg = <QUINARY_MI2S_RX>;
		qcom,sd-lines = <0>;
	};
};

&q6asmdai {
	dai@0 {
		reg = <0>;
	};

	dai@1 {
		reg = <1>;
	};

	dai@2 {
		reg = <2>;
	};
};

&rmtfs_mem {
	reg = <0x0 0xf4f00000 0x0 0x202000>;
};

&bluetooth {
	firmware-name = "sm7125/a52q/apnv11.bin";
};

&display_panel {
	compatible = "samsung,s6e3fc3-ams646yd04", "samsung,s6e3fc3";

	status = "okay";
};

&gpu_zap_shader {
	firmware-name = "qcom/sm7125/a52q/a615_zap.mbn";
};

&i2c0 {
	clock-frequency = <400000>;
	status = "okay";

	nfc@27 {
		compatible = "samsung,s3nrn4v";
		reg = <0x27>;

		interrupts-extended = <&tlmm 37 IRQ_TYPE_EDGE_RISING>;
		en-gpios = <&tlmm 12 GPIO_ACTIVE_HIGH>;
		wake-gpios = <&tlmm 36 GPIO_ACTIVE_HIGH>;
		pvdd-supply = <&vreg_nfc_pvdd>;

		pinctrl-names = "default";
		pinctrl-0 = <&nfc_default>;
	};
};

&i2c4 {
	status = "okay";

	usb-switch@25 {
		compatible = "siliconmitus,sm5714-muic";
		reg = <0x25>;
		mode-switch;

		port {
			sm5714_muic_ep: endpoint {
				remote-endpoint = <&sm5714_mux_ep>;
			};
		};
	};

	charger@49 {
		compatible = "siliconmitus,sm5714-charger";
		reg = <0x49>;

		siliconmitus,enable-autostop;
		siliconmitus,input-current-limit = <1300>;
		siliconmitus,charging-current = <1300>;
		siliconmitus,topoff-current = <225>;

		vreg_usb_otg_vbus: usb-otg-vbus {
			regulator-name = "usb_otg_vbus";
		};
	};

	fuel-gauge@71 {
		compatible = "siliconmitus,sm5714-fg";
		reg = <0x71>;
	};
};

&i2c7 {
	status = "okay";
	clock-frequency = <400000>;

	touchscreen@49 {
		compatible = "st,stmfts_fts5cu56a";
		reg = <0x49>;

		pinctrl-names = "default";
		pinctrl-0 = <&tsp_int>;

		interrupt-parent = <&tlmm>;
		interrupts = <9 IRQ_TYPE_LEVEL_LOW>;

		vdd-supply = <&vreg_l10a_1p8>;
		avdd-supply = <&vreg_l7c_3p0>;
	};
};

&i2c11 {
	status = "okay";

	typec@33 {
		compatible = "siliconmitus,sm5714-cc";
		reg = <0x33>;
		interrupts-extended = <&tlmm 104 IRQ_TYPE_LEVEL_LOW>;

		pinctrl-names = "default";
		pinctrl-0 = <&typec_int>;

		vbus-supply = <&vreg_usb_otg_vbus>;

		connector {
			compatible = "usb-c-connector";
			power-role = "dual";
			data-role = "dual";
			try-power-role = "sink";
			typec-power-opmode = "default";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					#address-cells = <1>;
					#size-cells = <0>;

					sm5714_hs_ep: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&usb_1_dwc3_hs>;
					};

					sm5714_mux_ep: endpoint@1 {
						reg = <1>;
						remote-endpoint = <&sm5714_muic_ep>;
					};
				};
			};
		};
	};
};

&ipa {
	firmware-name = "qcom/sm7125/a52q/ipa_fws.mbn";

	status = "okay";
};

&remoteproc_adsp {
	firmware-name = "qcom/sm7125/a52q/adsp.mbn";

	status = "okay";
};

&remoteproc_mpss {
	firmware-name = "qcom/sm7125/a52q/modem.mbn";

	status = "okay";
};

/* SMP2P sleepstate entries on the ADSP edge, consumed by smp2p-sleepstate. */
&{/smp2p-lpass} {
	sleepstate_smp2p_out: sleepstate-out {
		qcom,entry-name = "sleepstate";
		#qcom,smem-state-cells = <1>;
	};

	sleepstate_smp2p_in: sleepstate-in {
		qcom,entry-name = "sleepstate_see";
		interrupt-controller;
		#interrupt-cells = <2>;
	};
};

&tlmm {
	nfc_default: nfc-default-state {
		int-pins {
			pins = "gpio31", "gpio37";
			function = "gpio";
			drive-strength = <2>;
			bias-pull-down;
		};

		ctrl-pins {
			pins = "gpio12", "gpio36";
			function = "gpio";
			drive-strength = <2>;
			bias-disable;
		};
	};

	tsp_int: tsp-int-state {
		pins = "gpio9";
		function = "gpio";
		bias-disable;
		drive-strength = <2>;
	};

	typec_int: typec-int-state {
		pins = "gpio104";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};
};

&usb_1_dwc3 {
	dr_mode = "otg";
	usb-role-switch;
};

&usb_1_dwc3_hs {
	remote-endpoint = <&sm5714_hs_ep>;
};

&venus {
	firmware-name = "qcom/sm7125/a52q/venus.mbn";
};

&lpass_tlmm {
	status = "okay";
};

&rxmacro {
	status = "okay";
};

/ {
	sound {
		compatible = "qcom,sm8250-sndcard";
		model = "Samsung Galaxy A52";

		pinctrl-names = "default";
		pinctrl-0 = <&i2s1_active>;

		audio-routing = "IN1_HPHL", "HPHL_OUT",
				"IN2_HPHR", "HPHR_OUT",
				"AMIC1", "MIC BIAS1",
				"AMIC2", "MIC BIAS2",
				"AMIC4", "MIC BIAS3",
				"TX SWR_ADC0", "ADC1_OUTPUT",
				"TX SWR_ADC1", "ADC2_OUTPUT",
				"TX SWR_ADC3", "ADC4_OUTPUT";

		mm1-dai-link {
			link-name = "MultiMedia1";

			cpu {
				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA1>;
			};
		};

		mm2-dai-link {
			link-name = "MultiMedia2";

			cpu {
				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA2>;
			};
		};

		mm3-dai-link {
			link-name = "MultiMedia3";

			cpu {
				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA3>;
			};
		};

		speaker-dai-link {
			link-name = "Speaker Playback";

			cpu {
				sound-dai = <&q6afedai QUINARY_MI2S_RX>;
			};

			platform {
				sound-dai = <&q6routing>;
			};

			codec {
				sound-dai = <&speaker_right>, <&speaker_left>;
			};
		};

		wcd-playback-dai-link {
			link-name = "WCD Playback";

			cpu {
				sound-dai = <&q6afedai RX_CODEC_DMA_RX_0>;
			};

			platform {
				sound-dai = <&q6routing>;
			};

			codec {
				sound-dai = <&wcd938x 0>, <&swr1 0>, <&rxmacro 0>;
			};
		};

		wcd-capture-dai-link {
			link-name = "WCD Capture";

			cpu {
				sound-dai = <&q6afedai TX_CODEC_DMA_TX_3>;
			};

			platform {
				sound-dai = <&q6routing>;
			};

			codec {
				sound-dai = <&wcd938x 1>, <&swr2 0>, <&txmacro 0>;
			};
		};
	};
};

&swr1 {
	status = "okay";

	/* WCD9380 RX */
	wcd_rx: wcd9380-rx@0,4 {
		compatible = "sdw20217010d00";
		reg = <0 4>;
		qcom,rx-port-mapping = <1 2 3 4 5>;
	};
};

&swr2 {
	status = "okay";

	/* WCD9380 TX */
	wcd_tx: wcd9380-tx@0,3 {
		compatible = "sdw20217010d00";
		reg = <0 3>;
		qcom,tx-port-mapping = <2 3 4 5>;
	};
};

&tlmm {
	tas2562_active: tas2562-active-state {
		/* SDA, SCL, INT, EN */
		pins = "gpio88", "gpio89", "gpio90", "gpio94";
		function = "gpio";
		bias-disable;
	};

	wcd_reset_default: wcd-reset-default-state {
		pins = "gpio58";
		function = "gpio";
		drive-strength = <16>;
		bias-disable;
		output-low;
	};
};

&txmacro {
	status = "okay";
};

&vamacro {
	status = "okay";
};

&camcc {
	status = "okay";
};

&cci0 {
	status = "okay";
};

/* main: Samsung S5KGW1P, 3-trio C-PHY, CSIPHY0, MCLK0 19.2 MHz */
&cci0_i2c0 {
	cam_main: camera@2d {
		compatible = "samsung,s5kgw1p";
		reg = <0x2d>;
		vio-supply = <&vreg_cam_l3>;
		vana-supply = <&vreg_cam_l5>;
		vdig-supply = <&vreg_cam_l2>;
		vaf-supply = <&vreg_cam_l7>;
		vcustom-supply = <&vreg_cam0_avdd18>;
		clocks = <&camcc CAM_CC_MCLK0_CLK>;
		clock-names = "mclk";
		assigned-clocks = <&camcc CAM_CC_MCLK0_CLK>;
		assigned-clock-rates = <19200000>;
		reset-gpios = <&tlmm 30 GPIO_ACTIVE_LOW>;
		pinctrl-0 = <&cam_mclk0_default>;
		pinctrl-names = "default";		orientation = <1>;
		rotation = <270>;

		port {
			cam_s5kgw1p_ep: endpoint {
				bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
				data-lanes = <1 2 3>;
				link-frequencies = /bits/ 64 <1000000000>;
				remote-endpoint = <&csiphy0_ep>;
			};
		};
	};
};

/* ultra-wide: Samsung S5K3L6XX, 4-lane D-PHY, CSIPHY3 via video-mux, MCLK2 */
&cci0_i2c1 {
	camera@2d {
		compatible = "samsung,s5k3l6xx";
		reg = <0x2d>;
		vddio-supply = <&vreg_cam_l3>;
		vdda-supply = <&vreg_cam2_vana>;
		vddd-supply = <&vreg_cam_l1>;
		clocks = <&camcc CAM_CC_MCLK2_CLK>;
		clock-names = "mclk";
		clock-frequency = <19200000>;
		assigned-clocks = <&camcc CAM_CC_MCLK2_CLK>;
		assigned-clock-rates = <19200000>;
		rstn-gpios = <&tlmm 29 GPIO_ACTIVE_LOW>;
		pinctrl-0 = <&cam_mclk2_default>;
		pinctrl-names = "default";		orientation = <1>;
		rotation = <270>;

		port {
			cam_s5k3l6_ep: endpoint {
				data-lanes = <1 2 3 4>;
				link-frequencies = /bits/ 64 <259200000 480000000 595200000>;
				remote-endpoint = <&vmux_in_uw>;
			};
		};
	};
};

&cci1 {
	status = "okay";
};

/* front: Sony IMX616, 4-lane D-PHY, CSIPHY2, MCLK4 24 MHz */
&cci1_i2c0 {
	camera@1a {
		compatible = "sony,imx616";
		reg = <0x1a>;
		vio-supply = <&vreg_cam_l3>;
		vana-supply = <&vreg_cam_l6>;
		vdig-supply = <&vreg_cam_l1>;
		clocks = <&camcc CAM_CC_MCLK4_CLK>;
		clock-names = "mclk";
		assigned-clocks = <&camcc CAM_CC_MCLK4_CLK>;
		assigned-clock-rates = <24000000>;
		reset-gpios = <&tlmm 21 GPIO_ACTIVE_LOW>;
		pinctrl-0 = <&cam_mclk4_default>;
		pinctrl-names = "default";		orientation = <0>;
		rotation = <90>;

		port {
			cam_imx616_ep: endpoint {
				data-lanes = <1 2 3 4>;
				link-frequencies = /bits/ 64 <516000000>;
				remote-endpoint = <&csiphy2_ep>;
			};
		};
	};

	/* depth: GalaxyCore GC5035, 2-lane D-PHY, CSIPHY1, MCLK1 24 MHz */
	camera@37 {
		compatible = "galaxycore,gc5035";
		reg = <0x37>;
		iovdd-supply = <&vreg_cam_l3>;
		dvdd12-supply = <&vreg_cam_l4>;
		avdd28-supply = <&vreg_cam3_vana>;
		clocks = <&camcc CAM_CC_MCLK1_CLK>;
		clock-names = "mclk";
		clock-frequency = <24000000>;
		assigned-clocks = <&camcc CAM_CC_MCLK1_CLK>;
		assigned-clock-rates = <24000000>;
		resetb-gpios = <&tlmm 42 GPIO_ACTIVE_LOW>;
		pinctrl-0 = <&cam_mclk1_default>;
		pinctrl-names = "default";
		orientation = <1>;
		rotation = <270>;

		port {
			cam_gc5035_depth_ep: endpoint {
				data-lanes = <1 2>;
				link-frequencies = /bits/ 64 <438000000>;
				remote-endpoint = <&csiphy1_ep>;
			};
		};
	};

	/*
	 * macro: GalaxyCore GC5035, 2-lane D-PHY, MCLK3 24 MHz. Shares CSIPHY3
	 * with the ultra-wide camera through the gpio66 MIPI switch (video-mux
	 * input 1). "label" gives it a distinct entity name for its own tuning.
	 */
	camera@3f {
		compatible = "galaxycore,gc5035";
		reg = <0x3f>;
		label = "gc5035_macro";
		iovdd-supply = <&vreg_cam_l3>;
		dvdd12-supply = <&vreg_cam_l4>;
		avdd28-supply = <&vreg_cam3_vana>;
		clocks = <&camcc CAM_CC_MCLK3_CLK>;
		clock-names = "mclk";
		clock-frequency = <24000000>;
		assigned-clocks = <&camcc CAM_CC_MCLK3_CLK>;
		assigned-clock-rates = <24000000>;
		resetb-gpios = <&tlmm 24 GPIO_ACTIVE_LOW>;
		pinctrl-0 = <&cam_mclk3_default>;
		pinctrl-names = "default";
		orientation = <1>;
		rotation = <270>;

		port {
			cam_gc5035_macro_ep: endpoint {
				data-lanes = <1 2>;
				link-frequencies = /bits/ 64 <438000000>;
				remote-endpoint = <&vmux_in_macro>;
			};
		};
	};
};

&camss {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			csiphy0_ep: endpoint {
				bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
				data-lanes = <0 1 2>;
				remote-endpoint = <&cam_s5kgw1p_ep>;
			};
		};

		port@1 {
			reg = <1>;
			csiphy1_ep: endpoint {
				data-lanes = <0 1>;
				remote-endpoint = <&cam_gc5035_depth_ep>;
			};
		};

		port@2 {
			reg = <2>;
			csiphy2_ep: endpoint {
				data-lanes = <0 1 2 3>;
				remote-endpoint = <&cam_imx616_ep>;
			};
		};

		port@3 {
			reg = <3>;
			csiphy3_ep: endpoint {
				data-lanes = <0 1 2 3>;
				remote-endpoint = <&vmux_out>;
			};
		};
	};
};

&tlmm {
	cam_mclk0_default: cam-mclk0-default-state {
		pins = "gpio13";
		function = "cam_mclk";
		drive-strength = <2>;
		bias-disable;
	};

	cam_mclk1_default: cam-mclk1-default-state {
		pins = "gpio14";
		function = "cam_mclk";
		drive-strength = <2>;
		bias-disable;
	};

	cam_mclk2_default: cam-mclk2-default-state {
		pins = "gpio15";
		function = "cam_mclk";
		drive-strength = <2>;
		bias-disable;
	};

	cam_mclk3_default: cam-mclk3-default-state {
		pins = "gpio16";
		function = "cam_mclk";
		drive-strength = <2>;
		bias-disable;
	};

	cam_mclk4_default: cam-mclk4-default-state {
		pins = "gpio23";
		function = "cam_mclk";
		drive-strength = <2>;
		bias-disable;
	};
};

/*
 * Main camera VCM (AK7374) and the module EEPROMs live on QUP i2c9: the
 * main-module OTP at 0x50 and the front-module OTP at 0x51.
 */
&i2c9 {
	clock-frequency = <400000>;
	status = "okay";

	cam_main_vcm: camera-lens@c {
		compatible = "asahi-kasei,ak7374";
		reg = <0x0c>;
		vdd-supply = <&vreg_cam_l7>;
		vio-supply = <&vreg_cam_l3>;
	};

	eeprom@50 {
		compatible = "atmel,24c64";
		reg = <0x50>;
		pagesize = <32>;
		read-only;
		vcc-supply = <&vreg_cam_l3>;
	};

	eeprom@51 {
		compatible = "onnn,n24s64b", "atmel,24c64";
		reg = <0x51>;
		pagesize = <32>;
		read-only;
		vcc-supply = <&vreg_cam_l3>;
	};
};

/* Autofocus: the main sensor drives the AK7374 VCM. */
&cam_main {
	lens-focus = <&cam_main_vcm>;
};
