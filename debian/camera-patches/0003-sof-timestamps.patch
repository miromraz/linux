 							   VB2_BUF_STATE_DONE);
@@ -1592,13 +1592,13 @@ static void vfe_pix_ring_start(struct vfe_device *vfe, struct vfe_pix_ring *ring
 /*
  * vfe_pix_ring_retire - The frame in hw[0] completed. Locked.
  *
- * Queue it for its copy with @tok and done time @ts, unless it is the drop
+ * Queue it for its copy with @tok, unless it is the drop
  * frame or delivery stopped. Return whether it was queued. The caller must
  * validate the consumer's completion/token association first and advance
  * once afterwards. This helper establishes no hardware frame identity.
  */
 static bool vfe_pix_ring_retire(struct vfe_pix_ring *ring,
-				const struct vfe_pix_token *tok, u64 ts, bool hold)
+				const struct vfe_pix_token *tok, bool hold)
 {
 	u8 head = ring->hw[0];
 
@@ -1606,7 +1606,6 @@ static bool vfe_pix_ring_retire(struct vfe_pix_ring *ring,
 		return false;
 
 	ring->frame[head].token = *tok;
-	ring->frame[head].done_ts = ts;
 	ring->frame[head].error = ring->frame_error;
 	ring->ready[ring->nready++] = head;
 	/* Held until the next SOF proves the count belonged to this frame. */
@@ -2043,9 +2042,9 @@ int vfe170_params_commit(struct vfe_line *line, const struct vfe_pix_params *con
  * Every SOF gets the next sequence of the stream generation and a
  * FRAME_SYNC event, and its token goes to the frame starting in hw[0].
  * The composite done retires hw[0] with that token: the delivered buffer
- * gets the token's sequence and the done snapshot time as its timestamp
- * (the queue's default V4L2 end-of-frame meaning). The token's SOF time
- * stays internal; FRAME_SYNC gets a later host notification timestamp.
+ * gets the token's sequence and SOF snapshot time as its timestamp. That is
+ * the CSI-2 frame start, sent as the first row's readout begins, i.e. the
+ * end of its exposure; FRAME_SYNC gets a later host notification timestamp.
  *
  * Strict alternation, fail closed otherwise: at most one frame is started
  * and not retired. A SOF while the previous frame is unretired (its done
@@ -2122,7 +2121,7 @@ static void vfe_pix_frame_irq(struct vfe_device *vfe, bool sof, bool done,
 		st->tok.valid = st->pending_rings != 0;
 
 		head = img->hw[0];
-		deliver = vfe_pix_ring_retire(img, &tok, ts, next && !sof);
+		deliver = vfe_pix_ring_retire(img, &tok, next && !sof);
 		if (trace_camss_pix_done_enabled())
 			trace_camss_pix_done(vfe->id, tok.generation, tok.sequence,
 					     tok.valid, head, img->frame[head].dma,
@@ -2146,7 +2145,7 @@ static void vfe_pix_frame_irq(struct vfe_device *vfe, bool sof, bool done,
 		st->tok.valid = st->pending_rings != 0;
 		if (stats->ops) {
 			head = stats->hw[0];
-			deliver = vfe_pix_ring_retire(stats, &tok, ts, next && !sof);
+			deliver = vfe_pix_ring_retire(stats, &tok, next && !sof);
 			trace_camss_bhist_done(vfe->id, tok.generation, tok.sequence,
 					      tok.valid, stats->frame[head].dma,
 					      vfe_pix_wm_last(vfe, VFE_STATS_WM),
@@ -2325,10 +2324,6 @@ static irqreturn_t vfe_isr(int irq, void *dev)
 		if (status0 & STATUS_0_RDI_REG_UPDATE(i))
 			vfe->isr_ops.reg_update(vfe, i);
 
-	for (i = VFE_LINE_RDI0; i < rdi_num; i++)
-		if (status0 & STATUS_1_RDI_SOF(i))
-			vfe->isr_ops.sof(vfe, i);
-
 	if (pix) {
 		if (status0 & STATUS_0_PIX_REG_UPDATE)
 			vfe->isr_ops.reg_update(vfe, VFE_LINE_PIX);
@@ -2370,6 +2365,19 @@ static irqreturn_t vfe_isr(int irq, void *dev)
 				vfe->isr_ops.wm_done(vfe, wm);
 	}
 
+	/*
+	 * RDI SOF (STATUS_0 bit 27 + n, as the downstream rdi sof_irq_mask),
+	 * the time stamped on the line's next buffer done. After the dones: a
+	 * frame's done precedes the next SOF by as little as 0.03 ms at full
+	 * resolution and can share its snapshot, never its own SOF's (readout
+	 * takes most of the frame).
+	 */
+	for (i = VFE_LINE_RDI0; i < rdi_num; i++)
+		if (status0 & STATUS_1_RDI_SOF(i)) {
+			vfe->line[i].output.sof_ts = ts;
+			vfe->isr_ops.sof(vfe, i);
+		}
+
 	return IRQ_HANDLED;
