+	ring->hw[0] = ring->hw[1];
+	ring->hw[1] = vfe_pix_delivering(&ring->line->output) ?
+		      vfe_pix_take_frame(ring) : VFE_PIX_DROP;
+	ring->ops->queue_addr(vfe, ring, ring->hw[1]);
