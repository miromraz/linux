+/* Commit crossed into the next frame: the RUP IRQ labels the effective SOF. */
+static void params_test_late_commit(struct kunit *test)
+{
+	struct params_test *t = test->priv;
+	struct vfe_line *line = params_test_line(t);
+
+	params_test_live_begin(test);
+	t->commit_error = 1;
+	vfe_params_irq(line, 0, 0, 100, VFE_PARAMS_IRQ_END);
+	KUNIT_ASSERT_EQ(test, line->params.phase, VFE_PARAMS_RUP);
+	vfe_params_irq(line, 0, 7, 200, VFE_PARAMS_IRQ_SOF);	/* missed */
+	KUNIT_EXPECT_EQ(test, line->params.phase, VFE_PARAMS_RUP);
+	KUNIT_EXPECT_EQ(test, t->returned, 0);
+	vfe_params_irq(line, 0, 8, 300, VFE_PARAMS_IRQ_SOF | VFE_PARAMS_IRQ_RUP);
+	KUNIT_EXPECT_EQ(test, line->params.phase, VFE_PARAMS_IDLE);
+	KUNIT_EXPECT_EQ(test, t->last_sequence, 8u);
+	KUNIT_EXPECT_EQ(test, t->state, VB2_BUF_STATE_DONE);
+	KUNIT_EXPECT_EQ(test, t->faults, 0);
+
+	/* Late, but latched at once: labelled by the first SOF. */
+	list_add_tail(&t->buf.list, &line->params.pending);
+	params_upload_work(&line->params.upload_work);
+	line->output.pix.sof_sequence = 9;
+	vfe_params_irq(line, 0, 0, 400, VFE_PARAMS_IRQ_END);
+	vfe_params_irq(line, 0, 9, 500, VFE_PARAMS_IRQ_SOF | VFE_PARAMS_IRQ_RUP);
+	KUNIT_EXPECT_EQ(test, t->last_sequence, 9u);
+	KUNIT_EXPECT_EQ(test, t->faults, 0);
+
+	/* Only one SOF may pass without the RUP. */
+	list_add_tail(&t->buf.list, &line->params.pending);
+	params_upload_work(&line->params.upload_work);
+	line->output.pix.sof_sequence = 10;
+	vfe_params_irq(line, 0, 0, 600, VFE_PARAMS_IRQ_END);
+	vfe_params_irq(line, 0, 10, 700, VFE_PARAMS_IRQ_SOF);
+	vfe_params_irq(line, 0, 11, 800, VFE_PARAMS_IRQ_SOF);
+	KUNIT_EXPECT_EQ(test, t->faults, 1);
+}
