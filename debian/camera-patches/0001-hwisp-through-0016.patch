+static void pix_test_gtm_bank_and_enable(struct kunit *test)
+{
+	struct pix_test *t = test->priv;
+	struct vfe_device *vfe = &t->vfe;
+	struct vfe_line *line = pix_line(t);
+	struct vfe_pix_params *config = kunit_kzalloc(test, sizeof(*config), GFP_KERNEL);
+	u32 siblings = COLOR_EN_CCM | COLOR_EN_RGB_LUT | BIT(7);
+
+	KUNIT_ASSERT_NOT_NULL(test, config);
+	vfe_params_defaults(config);
+	config->mask = VFE_PARAMS_GTM;
+	config->gtm_enabled = true;
+	config->gtm[126] = 262143;
+	config->gtm[127] = 0x2000000;
+	vfe_pix_config(vfe, &vfe_pix_bayer[0], PIX_TEST_W, PIX_TEST_H,
+		       PIX_TEST_W, PIX_TEST_H, config);
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + VFE_GTM_CFG), 0u);
+	KUNIT_EXPECT_TRUE(test, readl(vfe->base + VFE_MODULE_COLOR_EN) & COLOR_EN_GTM);
+	vfe170_params_upload(line, config, BIT(VFE_BANK_GTM));
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + VFE_DMI_DATA_HI), 0x2000000u);
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + VFE_DMI_DATA_LO), 262143u);
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + VFE_DMI_CFG), 0u);
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + VFE_GTM_CFG), 0u);
+	line->output.pix.sof_sequence = 1;
+	writel(1, vfe->base + VFE_DIAG_SENSOR_FRM_CNT_STATUS);
+	writel(siblings, vfe->base + VFE_MODULE_COLOR_EN);
+	KUNIT_ASSERT_EQ(test, vfe170_params_commit(line, config, BIT(VFE_BANK_GTM)), 0);
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + VFE_GTM_CFG), 1u);
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + VFE_MODULE_COLOR_EN), siblings | COLOR_EN_GTM);
+	config->gtm_enabled = false;
+	KUNIT_ASSERT_EQ(test, vfe170_params_commit(line, config, 0), 0);
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + VFE_GTM_CFG), 0u);
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + VFE_MODULE_COLOR_EN), siblings);
+}
