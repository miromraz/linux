+#include "camss-vfe.h"
+#include "camss-vfe-17x-trace.h"
+
+bool vfe170_params_live;
+module_param_named(titan170_params_live, vfe170_params_live, bool, 0444);
+MODULE_PARM_DESC(titan170_params_live, "Enable experimental Titan170 live QCIP transactions");
+
+#define PARAMS_TIMEOUT msecs_to_jiffies(250)
+
+static void params_cancel(struct vfe_line *line, bool error);
