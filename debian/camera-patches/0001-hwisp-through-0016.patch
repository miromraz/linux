+#define VFE_TL_BG_COLS 32
+#define VFE_TL_BG_ROWS 24
+#define VFE_TL_BG_REGIONS (VFE_TL_BG_COLS * VFE_TL_BG_ROWS)
+#define VFE_TL_BG_OFFSET (VFE_HDR_BHIST_OFFSET + VFE_HDR_BHIST_DMA_SIZE)
+#define VFE_TL_BG_DMA_SIZE (VFE_TL_BG_REGIONS * 24)
+#define VFE_TL_BG_BLOCK_SIZE (sizeof(struct camss_stats_awb_bg) + \
+	VFE_TL_BG_REGIONS * sizeof(struct camss_ife_bg_region_stats))
+
+static inline bool vfe_stats_has_bg(void)
+{
+	return vfe170_awbbg || vfe170_3a;
+}
+
+static inline size_t vfe_stats_payload_size(void)
+{
+	return sizeof(struct vfe_bhist_buffer) +
+		(vfe_stats_has_bg() ? VFE_BG_BLOCK_SIZE : 0) +
+		(vfe170_3a ? VFE_BG_BLOCK_SIZE + sizeof(struct camss_stats_hdr_bhist) : 0) +
+		(vfe170_3a && vfe170_tlbg ? VFE_TL_BG_BLOCK_SIZE : 0);
+}
+
+static inline size_t vfe_stats_dma_size(void)
+{
+	return VFE_STATS_DMA_SIZE + (vfe_stats_has_bg() ? VFE_BG_DMA_SIZE : 0) +
+		(vfe170_3a ? VFE_BG_DMA_SIZE + VFE_HDR_BHIST_DMA_SIZE : 0) +
+		(vfe170_3a && vfe170_tlbg ? VFE_TL_BG_DMA_SIZE : 0);
+}
+
+struct vfe_line;
+struct vfe_stats {
+	struct video_device vdev;
+	struct vb2_queue queue;
+	struct mutex lock;
+	struct media_pad pad;
+	struct list_head pending;
+	wait_queue_head_t idle;
+	atomic_t copying;
+	/* Protected by the parent VFE output_lock. */
+	bool streaming;
+	bool registered;
+	u32 bg_mbus_code; /* Frozen at PIX start, never read mutable formats in copy. */
+};
