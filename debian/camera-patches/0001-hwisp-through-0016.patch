+static void params_trace(struct vfe_line *line, unsigned int event, int result)
+{
+	struct vfe_params *p = &line->params;
+
+	trace_camss_params(to_vfe(line)->id, p->generation, p->serial, event,
+			   p->phase, p->expected_sequence, p->staged.mask,
+			   p->staged_bank, result);
+}
+
+void vfe_params_defaults(struct vfe_pix_params *config)
+{
+	unsigned int c, i;
+
+	memset(config, 0, sizeof(*config));
+	config->bls[0] = 2048u << 15;
+	config->bls[1] = config->bls[2] = 0x3fff3fff;
+	for (c = 0; c < 3; c++) {
+		config->wb[c] = 128;
+		config->ccm[c * 3 + c] = 128;
+		for (i = 0; i < 64; i++)
+			config->gamma[c][i] = i * 16 | (i == 63 ? 15 : 16) << 10;
+	}
+}
+
+static int params_gamma(u32 dst[64], const u32 src[64])
+{
+	unsigned int i;
+
+	for (i = 0; i < 64; i++) {
+		u32 word = src[i];
+		int next = (word & 1023) + sign_extend32(word >> 10, 9);
+
+		if (word & ~0xfffff || next < 0 || next > 1024 ||
+		    (i < 63 && next != (src[i + 1] & 1023)))
+			return -EINVAL;
+		dst[i] = word;
+	}
+	return 0;
+}
+
+/* Titan170 IFE DMI selects, from the stock register header and capture. */
+const struct vfe_iq_lut vfe_iq_luts[VFE_IQ_LUTS] = {
+	{ 9, 1, VFE_BANK_LINEAR, true, 72, 0 },		/* linearization */
+	{ 12, 1, VFE_BANK_ABF, false, 64, 72 },		/* ABF noise */
+	{ 14, 4, VFE_BANK_LSC, false, 221, 136 },	/* rolloff R/Gr */
+	{ 15, 4, VFE_BANK_LSC, false, 221, 357 },	/* rolloff B/Gb */
+	{ 24, 1, VFE_BANK_GTM, true, 128, 578 },	/* GTM */
+	{ 26, 1, VFE_BANK_GAMMA, false, 64, 706 },	/* RGB LUT ch0 */
+	{ 28, 1, VFE_BANK_GAMMA, false, 64, 770 },	/* RGB LUT ch1 */
+	{ 30, 1, VFE_BANK_GAMMA, false, 64, 834 },	/* RGB LUT ch2 */
+};
+
+/* Inclusive, every offset a named IQ register (titan170_ife.h). */
+const u16 vfe_iq_ranges[][2] = {
+	{ 0x040, 0x040 },	/* MODULE_LENS_EN, checked below */
+	{ 0x048, 0x048 },	/* MODULE_COLOR_EN, checked below */
+	{ 0x4dc, 0x55c },	/* linearization (BLACK_*) */
+	{ 0x560, 0x578 },	/* demux */
+	{ 0x5c4, 0x5e0 },	/* BPC/BCC */
+	{ 0x5e8, 0x5e8 },	/* ABF_CFG */
+	{ 0x5f4, 0x648 },	/* ABF */
+	{ 0x6b0, 0x6b8 },	/* BLS */
+	{ 0x6bc, 0x6e4 },	/* rolloff */
+	{ 0x6f8, 0x720 },	/* demosaic, WB */
+	{ 0x760, 0x798 },	/* CCM, GTM_CFG, RGB_LUT_CFG */
+	{ 0xaac, 0xaac },	/* STATS_CFG */
+	{ 0xbc8, 0xbe8 },	/* AWB-BG, BHIST region */
+	{ 0xc14, 0xc14 },	/* AWB-BG Y */
+	{ 0xcb0, 0xcb0 },	/* AWB-BG sampling */
+	{ 0xd64, 0xd64 },	/* DS4 4:1 filter taps */
+	{ 0xd74, 0xd74 },	/* DS16 4:1 filter taps */
+	{ 0xd98, 0xd9c },	/* DS4 Y clamp, rounding */
+	{ 0xdb8, 0xdbc },	/* DS4 C clamp, rounding */
+	{ 0xdd8, 0xddc },	/* DS16 Y clamp, rounding */
+	{ 0xdf8, 0xdfc },	/* DS16 C clamp, rounding */
+	{ 0xf30, 0xf5c },	/* CST */
+};
+const unsigned int vfe_iq_nranges = ARRAY_SIZE(vfe_iq_ranges);
+
+/* Bank-select register, field mask and owner bit of each banked class. */
+static const struct {
+	u16 offset;
+	u32 mask;
+	u8 cls;
+} vfe_iq_bank_regs[] = {
+	{ 0x4dc, BIT(0), VFE_BANK_LINEAR },
+	{ 0x5e8, BIT(1), VFE_BANK_ABF },
+	{ 0x6bc, BIT(16), VFE_BANK_LSC },
+	{ 0x794, BIT(0), VFE_BANK_GTM },
+	{ 0x798, GENMASK(2, 0), VFE_BANK_GAMMA },
+};
+
+/* Driver-owned module enables: demux/demosaic/RGB LUT on, the rest off. */
+#define VFE_IQ_LENS_IQ	(BIT(1) | BIT(6) | BIT(7) | BIT(8) | BIT(11))
+#define VFE_IQ_LENS_ON	(BIT(2) | BIT(10))
+#define VFE_IQ_COLOR_IQ	(BIT(1) | BIT(2))
+#define VFE_IQ_COLOR_ON	BIT(3)
+
+static bool params_iq_allowed(u32 offset)
+{
+	unsigned int i;
+
+	if (offset % 4)
+		return false;
+	/* The kernel reports fixed AWB-BG geometry and sampling in metadata;
+	 * STATS_CFG holds the AWB-BG quad-sync and colour-conversion bits.
+	 */
+	if (vfe170_awbbg && ((offset >= 0xbc8 && offset <= 0xbe0) ||
+			     offset == 0xaac || offset == 0xc14 || offset == 0xcb0))
+		return false;
+	/* Stock 3A metadata describes a fixed hardware profile. Replay must not
+	 * change the shared stats configuration, geometry or clipping thresholds.
+	 */
+	if (vfe170_3a && ((offset >= 0xbc8 && offset <= 0xbe8) ||
+			  offset == 0xaac || offset == 0xc14 || offset == 0xcb0))
+		return false;
+	for (i = 0; i < vfe_iq_nranges; i++)
+		if (offset >= vfe_iq_ranges[i][0] && offset <= vfe_iq_ranges[i][1])
+			return true;
+	return false;
+}
+
+static int params_parse_iq(struct vfe_iq_replay *iq,
+			   const struct camss_params_iq_replay *p, size_t size)
+{
+	const u8 *cursor = (const u8 *)p->data, *end = (const u8 *)p + size;
+	u8 classes = 0, banks = 0, selects = 0;
+	unsigned int i, j;
+
+	if (p->_pad || p->num_regs > CAMSS_IQ_REPLAY_MAX_REGS ||
+	    p->num_luts > CAMSS_IQ_REPLAY_MAX_LUTS ||
+	    (size_t)(end - cursor) < p->num_regs * sizeof(struct camss_iq_reg))
+		return -EINVAL;
+	memset(iq, 0, sizeof(*iq));
+	for (i = 0; i < p->num_regs; i++, cursor += sizeof(struct camss_iq_reg)) {
+		u32 offset = get_unaligned((const u32 *)cursor);
+		u32 value = get_unaligned((const u32 *)cursor + 1);
+
+		if (!params_iq_allowed(offset))
+			return -EPERM;
+		for (j = 0; j < i; j++)
+			if (iq->reg[j][0] == offset)
+				return -EINVAL;
+		if ((offset == 0x040 &&
+		     (value & ~VFE_IQ_LENS_IQ) != VFE_IQ_LENS_ON) ||
+		    (offset == 0x048 &&
+		     (value & ~VFE_IQ_COLOR_IQ) != VFE_IQ_COLOR_ON))
+			return -EPERM;
+		for (j = 0; j < ARRAY_SIZE(vfe_iq_bank_regs); j++) {
+			u32 field = value & vfe_iq_bank_regs[j].mask;
+
+			if (vfe_iq_bank_regs[j].offset != offset)
+				continue;
+			/* All three gamma channels select one bank together. */
+			if (field && field != vfe_iq_bank_regs[j].mask)
+				return -EINVAL;
+			selects |= BIT(vfe_iq_bank_regs[j].cls);
+			banks |= !!field << vfe_iq_bank_regs[j].cls;
+		}
+		iq->reg[i][0] = offset;
+		iq->reg[i][1] = value;
+	}
+	iq->nregs = p->num_regs;
+	for (i = 0; i < p->num_luts; i++) {
+		const struct vfe_iq_lut *lut = NULL;
+		struct camss_iq_lut h;
+
+		if ((size_t)(end - cursor) < sizeof(h))
+			return -EINVAL;
+		memcpy(&h, cursor, sizeof(h));
+		cursor += sizeof(h);
+		for (j = 0; j < VFE_IQ_LUTS; j++)
+			if (vfe_iq_luts[j].sel == h.sel)
+				lut = &vfe_iq_luts[j];
+		if (!lut)
+			return -EPERM;
+		j = lut - vfe_iq_luts;
+		if (h.bank > 1 || h.words != lut->words || (iq->luts & BIT(j)) ||
+		    (size_t)(end - cursor) < h.words * 4u)
+			return -EINVAL;
+		if ((classes & BIT(lut->cls)) &&
+		    ((iq->banks >> lut->cls) & 1) != h.bank)
+			return -EINVAL;
+		memcpy(&iq->lut[lut->offset], cursor, h.words * 4u);
+		cursor += h.words * 4u;
+		iq->luts |= BIT(j);
+		classes |= BIT(lut->cls);
+		iq->banks |= h.bank << lut->cls;
+	}
+	/* Only zero padding to the 8-byte block size may remain. */
+	if (end - cursor >= 8 || memchr_inv(cursor, 0, end - cursor))
+		return -EINVAL;
+	/* Complete classes; selects and uploads always travel together. */
+	if (selects != classes || banks != iq->banks ||
+	    ((iq->luts & GENMASK(3, 2)) && (iq->luts & GENMASK(3, 2)) != GENMASK(3, 2)) ||
+	    ((iq->luts & GENMASK(7, 5)) && (iq->luts & GENMASK(7, 5)) != GENMASK(7, 5)))
+		return -EINVAL;
+	iq->classes = classes;
+	return 0;
+}
+
+static int params_parse_into(struct vfe_pix_params *parsed, const void *data, size_t size)
+{
+	const struct v4l2_isp_buffer *input = data;
+	const u8 *cursor;
+	size_t remaining;
+
+	if (size < sizeof(*input) || size > VFE_PARAMS_SIZE ||
+	    input->version != V4L2_ISP_VERSION_V1 ||
+	    input->data_size != size - sizeof(*input) || !input->data_size)
+		return -EINVAL;
+	vfe_params_defaults(parsed);
+	cursor = input->data;
+	remaining = input->data_size;
+	while (remaining) {
+		const struct v4l2_isp_block_header *h = (const void *)cursor;
+		u32 mask;
+		bool enable;
+		unsigned int i;
+
+		if (remaining < sizeof(*h))
+			return -EINVAL;
+		mask = h->type == CAMSS_PARAMS_BLS_EXPERIMENTAL ? VFE_PARAMS_BLS :
+			h->type == CAMSS_PARAMS_LINEARIZATION_EXPERIMENTAL ?
+			VFE_PARAMS_LINEARIZATION :
+			h->type == CAMSS_PARAMS_LSC_EXPERIMENTAL ? VFE_PARAMS_LSC :
+			h->type == CAMSS_PARAMS_IQ_REPLAY_EXPERIMENTAL ? VFE_PARAMS_IQ :
+			h->type == CAMSS_PARAMS_DEMUX_EXPERIMENTAL ? VFE_PARAMS_DEMUX :
+			h->type == CAMSS_PARAMS_BPC_EXPERIMENTAL ? VFE_PARAMS_BPC :
+			h->type == CAMSS_PARAMS_ABF_EXPERIMENTAL ? VFE_PARAMS_ABF :
+			h->type == CAMSS_PARAMS_GTM_EXPERIMENTAL ? VFE_PARAMS_GTM :
+			h->type < 32 ? BIT(h->type) : 0;
+		if (h->size < sizeof(*h) ||
+		    h->size > remaining || h->size % 8 || !mask ||
+		    (parsed->mask & mask) ||
+		    (h->flags != V4L2_ISP_PARAMS_FL_BLOCK_ENABLE &&
+		     h->flags != V4L2_ISP_PARAMS_FL_BLOCK_DISABLE))
+			return -EINVAL;
+		enable = h->flags == V4L2_ISP_PARAMS_FL_BLOCK_ENABLE;
+		/* The replay owns its buffer: no ordering against typed blocks. */
+		if (parsed->mask && (mask == VFE_PARAMS_IQ ||
+				     (parsed->mask & VFE_PARAMS_IQ)))
+			return -EINVAL;
+		switch (h->type) {
+		case CAMSS_PARAMS_GTM_EXPERIMENTAL: {
+			const struct camss_params_gtm *p = (const void *)h;
+
+			if (h->size != sizeof(*p))
+				return -EINVAL;
+			for (i = 0; i < ARRAY_SIZE(p->base); i++) {
+				if (p->base[i] > 0x3ffff || p->slope[i] < -33554432 ||
+				    p->slope[i] > 33554431)
+					return -ERANGE;
+				parsed->gtm[2 * i] = p->base[i];
+				parsed->gtm[2 * i + 1] = (u32)p->slope[i] & 0x3ffffff;
+			}
+			parsed->gtm_enabled = enable;
+			break;
+		}
+		case CAMSS_PARAMS_ABF_EXPERIMENTAL: {
+			const struct camss_params_abf *p = (const void *)h;
+			unsigned int c;
+
+			if (!enable || h->size != sizeof(*p) ||
+			    memchr_inv(p->_pad, 0, sizeof(p->_pad)))
+				return -EINVAL;
+			if (p->bx < -3120 || p->bx > 3110 || p->by < -8192 || p->by > -5 ||
+			    p->r_square_init > 0x4948900 || p->r_square_shift > 15 ||
+			    p->black_level > 4095 || p->bpc_offset > 4095 ||
+			    p->noise_anchor > 1023 || !p->noise_gap || p->noise_gap > 1023 ||
+			    p->fmax > 63 || p->fmin > 63 || p->max_shift > 14 ||
+			    p->min_shift > 14 || p->cross_plane > 1 || p->single_bpc > 1)
+				return -ERANGE;
+			for (i = 0; i < 64; i++) {
+				if (p->noise_base[i] > 511 || p->noise_delta[i] > 511)
+					return -ERANGE;
+				parsed->abf_lut[i] = p->noise_base[i] | p->noise_delta[i] << 9;
+			}
+			for (i = 0; i < 4; i++) {
+				if (p->radial_anchor[i] > 4095 || p->curve_offset[i] > 64)
+					return -ERANGE;
+				parsed->abf[1 + i] = p->curve_offset[i];
+			}
+			parsed->abf[0] = 1 | p->cross_plane << 2 | p->single_bpc << 3;
+			for (c = 0; c < 2; c++) {
+				if (p->noise_lo[c] > 256 || p->noise_slope[c] < -256 ||
+				    p->noise_slope[c] > 256 || p->noise_shift[c] > 10 ||
+				    p->pixel_match[c] > 4 || p->distance[c][0] < 1 ||
+				    p->distance[c][0] > 4 || p->distance[c][1] > 2 ||
+				    p->distance[c][2] > 1)
+					return -ERANGE;
+				parsed->abf[0] |= p->pixel_match[c] << (4 + 4 * c) |
+					p->distance[c][0] << (12 + 8 * c) |
+					p->distance[c][1] << (16 + 8 * c) |
+					p->distance[c][2] << (18 + 8 * c);
+				for (i = 0; i < 4; i++) {
+					if (p->radial_shift[c][i] > 15)
+						return -ERANGE;
+					parsed->abf[9 + 4 * c + i] = p->radial_base[c][i] |
+						p->radial_slope[c][i] << 8 | p->radial_shift[c][i] << 16;
+				}
+				parsed->abf[21 + c] = p->noise_lo[c] |
+					(p->noise_slope[c] & 1023) << 12 | p->noise_shift[c] << 24;
+			}
+			parsed->abf[5] = (p->bx & 16383) | (p->by & 16383) << 16;
+			parsed->abf[6] = p->r_square_init;
+			parsed->abf[7] = p->radial_anchor[0] | (u32)p->radial_anchor[1] << 16;
+			parsed->abf[8] = p->radial_anchor[2] | (u32)p->radial_anchor[3] << 16;
+			parsed->abf[17] = p->r_square_shift;
+			parsed->abf[18] = p->fmax | p->fmin << 8 | (u32)p->bpc_offset << 16;
+			parsed->abf[19] = p->max_shift | p->min_shift << 4 | p->black_level << 8;
+			parsed->abf[20] = p->noise_anchor | (u32)p->noise_gap << 16;
+			break;
+		}
+		case CAMSS_PARAMS_BPC_EXPERIMENTAL: {
+			const struct camss_params_bpc *p = (const void *)h;
+
+			if (!enable || h->size != sizeof(*p) ||
+			    memchr_inv(p->_pad, 0, sizeof(p->_pad)))
+				return -EINVAL;
+			if (p->black_level > 4095 || p->bpc_offset > 16383 ||
+			    p->bcc_offset > 16383 || p->threshold > 8191 ||
+			    p->hot_disabled > 1 || p->cold_disabled > 1 ||
+			    p->same_channel > 1 || p->fmax < 64 ||
+			    p->fmax > 127 || p->fmin > 64)
+				return -ERANGE;
+			for (i = 0; i < 4; i++) {
+				if (p->ratio_q12[i] < 128 || p->ratio_q12[i] > 131071)
+					return -ERANGE;
+				parsed->bpc[i + 1] = p->ratio_q12[i];
+			}
+			parsed->bpc[0] = p->hot_disabled | p->cold_disabled << 1 |
+				p->same_channel << 2 | p->black_level << 3;
+			parsed->bpc[5] = p->bpc_offset | (u32)p->bcc_offset << 16;
+			parsed->bpc[6] = p->fmax | p->fmin << 8 | (u32)p->threshold << 16;
+			break;
+		}
+		case CAMSS_PARAMS_DEMUX_EXPERIMENTAL: {
+			const struct camss_params_demux *p = (const void *)h;
+
+			if (!enable || h->size != sizeof(*p) ||
+			    memchr_inv(p->_pad, 0, sizeof(p->_pad)))
+				return -EINVAL;
+			if (p->black_offset > 4095)
+				return -ERANGE;
+			for (i = 0; i < 4; i++)
+				if (p->gain_q10[i] > 32767)
+					return -ERANGE;
+			parsed->demux[0] = 1 | (u32)p->black_offset << 4 |
+				(u32)p->black_offset << 20;
+			parsed->demux[1] = p->gain_q10[1] | (u32)p->gain_q10[2] << 16;
+			parsed->demux[2] = p->gain_q10[3] | (u32)p->gain_q10[0] << 16;
+			parsed->demux[3] = parsed->demux[1];
+			parsed->demux[4] = parsed->demux[2];
+			break;
+		}
+		case CAMSS_PARAMS_IQ_REPLAY_EXPERIMENTAL: {
+			int ret;
+
+			if (!enable || h->size < sizeof(struct camss_params_iq_replay))
+				return -EINVAL;
+			ret = params_parse_iq(&parsed->iq, (const void *)h, h->size);
+			if (ret)
+				return ret;
+			break;
+		}
+		case CAMSS_PARAMS_LSC_EXPERIMENTAL: {
+			const struct camss_params_lsc *p = (const void *)h;
+			u32 sw, sh, bw, bh, dx, dy, ox, oy;
+			unsigned int c;
+
+			if (h->size != sizeof(*p) || memchr_inv(p->_pad, 0, sizeof(p->_pad)))
+				return -EINVAL;
+			sw = p->subgrid_width;
+			sh = p->subgrid_height;
+			ox = p->offset_x;
+			oy = p->offset_y;
+			if (p->interpolation_factor > 3 || sw < 9 || sh < 9)
+				return -ERANGE;
+			bw = sw << p->interpolation_factor;
+			bh = sh << p->interpolation_factor;
+			if (bw > 2048 || bh > 1024 || ox >= bw || oy >= bh)
+				return -ERANGE;
+			dx = (1u << 20) / sw;
+			dy = (1u << 20) / sh;
+			parsed->lsc[0] = 15u << 18 | 11u << 24;
+			parsed->lsc[1] = (bw - 1) | (bh - 1) << 16;
+			parsed->lsc[2] = (sh - 1) | dy << 12 | (u32)p->interpolation_factor << 30;
+			parsed->lsc[3] = (sw - 1) | dx << 12;
+			memcpy(&parsed->lsc[4], &parsed->lsc[1], 3 * sizeof(u32));
+			parsed->lsc[7] = ((oy % sh) * dy) << 12;
+			parsed->lsc[8] = (ox % sw) | (oy % sh) << 12 |
+				(ox / sw) << 24 | (oy / sh) << 28;
+			parsed->lsc[9] = parsed->lsc[7];
+			parsed->lsc[10] = parsed->lsc[8];
+			for (c = 0; c < 4; c++)
+				for (i = 0; i < CAMSS_LSC_NODES; i++)
+					if (p->gain[c][i] < 1024 || p->gain[c][i] > 8191)
+						return -ERANGE;
+			for (i = 0; i < CAMSS_LSC_NODES; i++) {
+				parsed->lsc_lut[0][i] = p->gain[0][i] | p->gain[1][i] << 13;
+				parsed->lsc_lut[1][i] = p->gain[3][i] | p->gain[2][i] << 13;
+			}
+			parsed->lsc_extent[0] = 2 * (16 * bw - ox);
+			parsed->lsc_extent[1] = 2 * (12 * bh - oy);
+			parsed->lsc_enabled = enable;
+			break;
+		}
+		case CAMSS_PARAMS_LINEARIZATION_EXPERIMENTAL: {
+			const struct camss_params_linearization *p = (const void *)h;
+			/* Hardware knee registers have a different channel order to DMI. */
+			static const u8 reg_channel[] = { 0, 3, 1, 2 };
+			unsigned int c;
+
+			if (h->size != sizeof(*p))
+				return -EINVAL;
+			for (c = 0; c < 4; c++) {
+				for (i = 0; i < 8; i++) {
+					if (p->knee[c][i] > 0x3fff ||
+					    (i && p->knee[c][i] < p->knee[c][i - 1]))
+						return -ERANGE;
+				}
+				for (i = 0; i < 4; i++)
+					parsed->linear_knee[reg_channel[c] * 4 + i] =
+						p->knee[c][2 * i] << 16 | p->knee[c][2 * i + 1];
+				for (i = 0; i < 9; i++) {
+					if (p->base[c][i] > 0x3fff || p->slope_q11[c][i] > 0x3ffffff)
+						return -ERANGE;
+					parsed->linear_lut[4 * i + c] = p->base[c][i] |
+						(u64)p->slope_q11[c][i] << 14;
+				}
+			}
+			parsed->linear_enabled = enable;
+			break;
+		}
+		case CAMSS_PARAMS_BLS_EXPERIMENTAL: {
+			const struct camss_params_bls *p = (const void *)h;
+
+			if (h->size != sizeof(*p) || p->_pad0 ||
+			    memchr_inv(p->_pad, 0, sizeof(p->_pad)))
+				return -EINVAL;
+			if (p->offset > 0x3fff || !p->scale_q11 ||
+			    p->scale_q11 > 0x1ffff)
+				return -ERANGE;
+			for (i = 0; i < 4; i++)
+				if (p->threshold[i] > 0x3fff)
+					return -ERANGE;
+			parsed->bls[0] = p->offset | p->scale_q11 << 15;
+			parsed->bls[1] = p->threshold[2] | p->threshold[3] << 16;
+			parsed->bls[2] = p->threshold[0] | p->threshold[1] << 16;
+			parsed->bls_enabled = enable;
+			break;
+		}
+		case CAMSS_PARAMS_WB_GAIN: {
+			const struct camss_params_wb_gain *p = (const void *)h;
+			u16 gain[3];
+
+			if (h->size != sizeof(*p) || p->g_sub || p->b_sub ||
+			    p->r_sub || p->g_add || p->b_add || p->r_add ||
+			    memchr_inv(p->_pad, 0, sizeof(p->_pad)))
+				return -EINVAL;
+			gain[0] = p->g_gain;
+			gain[1] = p->b_gain;
+			gain[2] = p->r_gain;
+			for (i = 0; i < 3; i++) {
+				if (gain[i] > 32763)
+					return -ERANGE;
+				if (enable)
+					parsed->wb[i] = DIV_ROUND_CLOSEST(gain[i], 8);
+			}
+			break;
+		}
+		case CAMSS_PARAMS_COLOR_CORRECT: {
+			const struct camss_params_color_correct *p = (const void *)h;
+
+			if (h->size != sizeof(*p) || p->qfactor > 3 ||
+			    memchr_inv(p->k, 0, sizeof(p->k)) ||
+			    memchr_inv(p->_pad, 0, sizeof(p->_pad)))
+				return -EINVAL;
+			for (i = 0; i < 3; i++) {
+				if ((p->a[i] | p->b[i] | p->c[i]) & ~0xfff)
+					return -ERANGE;
+				parsed->ccm[i * 3] = p->a[i];
+				parsed->ccm[i * 3 + 1] = p->b[i];
+				parsed->ccm[i * 3 + 2] = p->c[i];
+			}
+			parsed->qfactor = p->qfactor;
+			parsed->ccm_enabled = enable;
+			break;
+		}
+		case CAMSS_IFE_PARAMS_GAMMA_64: {
+			const struct camss_ife_params_gamma_64 *p = (const void *)h;
+			u32 scratch[64];
+
+			if (h->size != sizeof(*p) ||
+			    params_gamma(enable ? parsed->gamma[0] : scratch, p->table_g) ||
+			    params_gamma(enable ? parsed->gamma[1] : scratch, p->table_b) ||
+			    params_gamma(enable ? parsed->gamma[2] : scratch, p->table_r))
+				return -EINVAL;
+			break;
+		}
+		default:
+			return -EINVAL;
+		}
+		parsed->mask |= mask;
+		remaining -= h->size;
+		cursor += h->size;
+	}
+	return 0;
+}
+
+/* Parsing is transactional, but the immutable LUT snapshot is too large
+ * for a kernel stack. Callers run in process context (vb2 prepare).
+ */
+int vfe_params_parse(struct vfe_pix_params *config, const void *data, size_t size)
+{
+	struct vfe_pix_params *parsed;
+	int ret;
+
+	parsed = kmalloc(sizeof(*parsed), GFP_KERNEL);
+	if (!parsed)
+		return -ENOMEM;
+	ret = params_parse_into(parsed, data, size);
+	if (!ret)
+		*config = *parsed;
+	kfree(parsed);
+	return ret;
+}
+
+static int params_check_size(const struct vfe_pix_params *config, u32 w, u32 h)
+{
+	if (config->lsc_enabled && (!w || !h || w % 2 || h % 2 ||
+	    w > config->lsc_extent[0] || h > config->lsc_extent[1]))
+		return -ERANGE;
+	return 0;
+}
+
+static void params_return(struct vfe_params_buffer *buf, enum vb2_buffer_state state)
+{
+	KUNIT_STATIC_STUB_REDIRECT(params_return, buf, state);
+	vb2_buffer_done(&buf->vb.vb2_buf, state);
+}
+
+static void params_finish_one(struct vfe_params_buffer *buf,
+			      enum vb2_buffer_state state)
+{
+	buf->vb.sequence = 0;
+	buf->vb.vb2_buf.timestamp = 0;
+	params_return(buf, state);
+}
+
+static void params_finish(struct list_head *list, enum vb2_buffer_state state,
+			  u32 sequence, u64 timestamp)
+{
+	struct vfe_params_buffer *buf, *next;
+
+	list_for_each_entry_safe(buf, next, list, list) {
+		list_del_init(&buf->list);
+		buf->vb.sequence = sequence;
+		buf->vb.vb2_buf.timestamp = timestamp;
+		params_return(buf, state);
+	}
+}
+
+static void params_merge(struct vfe_pix_params *dst,
+			 const struct vfe_pix_params *update)
+{
+	if (update->mask & VFE_PARAMS_GTM) {
+		memcpy(dst->gtm, update->gtm, sizeof(dst->gtm));
+		dst->gtm_enabled = update->gtm_enabled;
+	}
+	if (update->mask & VFE_PARAMS_ABF) {
+		memcpy(dst->abf, update->abf, sizeof(dst->abf));
+		memcpy(dst->abf_lut, update->abf_lut, sizeof(dst->abf_lut));
+	}
+	if (update->mask & VFE_PARAMS_BPC)
+		memcpy(dst->bpc, update->bpc, sizeof(dst->bpc));
+	if (update->mask & VFE_PARAMS_DEMUX)
+		memcpy(dst->demux, update->demux, sizeof(dst->demux));
+	if (update->mask & VFE_PARAMS_LSC) {
+		memcpy(dst->lsc, update->lsc, sizeof(dst->lsc));
+		memcpy(dst->lsc_lut, update->lsc_lut, sizeof(dst->lsc_lut));
+		memcpy(dst->lsc_extent, update->lsc_extent, sizeof(dst->lsc_extent));
+		dst->lsc_enabled = update->lsc_enabled;
+	}
+	if (update->mask & VFE_PARAMS_LINEARIZATION) {
+		memcpy(dst->linear_knee, update->linear_knee, sizeof(dst->linear_knee));
+		memcpy(dst->linear_lut, update->linear_lut, sizeof(dst->linear_lut));
+		dst->linear_enabled = update->linear_enabled;
+	}
+	if (update->mask & VFE_PARAMS_BLS) {
+		memcpy(dst->bls, update->bls, sizeof(dst->bls));
+		dst->bls_enabled = update->bls_enabled;
+	}
+	if (update->mask & BIT(CAMSS_PARAMS_WB_GAIN))
+		memcpy(dst->wb, update->wb, sizeof(dst->wb));
+	if (update->mask & BIT(CAMSS_PARAMS_COLOR_CORRECT)) {
+		memcpy(dst->ccm, update->ccm, sizeof(dst->ccm));
+		dst->qfactor = update->qfactor;
+		dst->ccm_enabled = update->ccm_enabled;
+	}
+	if (update->mask & BIT(CAMSS_IFE_PARAMS_GAMMA_64))
+		memcpy(dst->gamma, update->gamma, sizeof(dst->gamma));
+	if (update->mask & VFE_PARAMS_IQ)
+		dst->iq = update->iq;
+	dst->mask = update->mask;
+}
+
+/* The hardware snapshot outlives any cancelled userspace buffer. */
+static void params_upload_work(struct work_struct *work)
+{
+	struct vfe_params *p = container_of(work, struct vfe_params, upload_work);
+	struct vfe_line *line = container_of(p, struct vfe_line, params);
+	struct vfe_device *vfe = to_vfe(line);
+	struct vfe_params_buffer *buf;
+	const struct vfe_iq_replay *iq;
+	unsigned long flags;
+	u8 banks;
+
+	spin_lock_irqsave(&vfe->output_lock, flags);
+	if (!p->streaming || p->phase != VFE_PARAMS_IDLE ||
+	    line->output.state != VFE_OUTPUT_ON || line->output.pix.faulted ||
+	    list_empty(&p->pending)) {
+		spin_unlock_irqrestore(&vfe->output_lock, flags);
+		return;
+	}
+	buf = list_first_entry(&p->pending, struct vfe_params_buffer, list);
+	/* A replay names its banks: each must be the one hardware is not using. */
+	iq = &buf->config.iq;
+	if ((buf->config.mask & VFE_PARAMS_IQ) &&
+	    ((p->active_bank ^ iq->banks) & iq->classes) != iq->classes) {
+		list_del_init(&buf->list);
+		params_trace(line, 5, -EBUSY);
+		spin_unlock_irqrestore(&vfe->output_lock, flags);
+		params_finish_one(buf, VB2_BUF_STATE_ERROR);
+		spin_lock_irqsave(&vfe->output_lock, flags);
+		params_kick(line);
+		spin_unlock_irqrestore(&vfe->output_lock, flags);
+		return;
+	}
+	p->staged = p->active;
+	params_merge(&p->staged, &buf->config);
+	list_move_tail(&buf->list, &p->applied);
+	p->serial++;
+	p->generation = line->output.pix.generation;
+	p->phase = VFE_PARAMS_UPLOAD;
+	p->cancelled = false;
+	/* Independent double buffers: gamma/linear/LSC/ABF/GTM have distinct ownership bits. */
+	banks = !!(p->staged.mask & BIT(CAMSS_IFE_PARAMS_GAMMA_64));
+	banks |= !!(p->staged.mask & VFE_PARAMS_LINEARIZATION) << 1;
+	banks |= !!(p->staged.mask & VFE_PARAMS_LSC) << 2;
+	banks |= !!(p->staged.mask & VFE_PARAMS_ABF) << VFE_BANK_ABF;
+	banks |= !!(p->staged.mask & VFE_PARAMS_GTM) << VFE_BANK_GTM;
+	if (p->staged.mask & VFE_PARAMS_IQ)
+		banks |= p->staged.iq.classes;
+	p->staged_bank = p->active_bank ^ banks;
+	p->deadline = jiffies + PARAMS_TIMEOUT;
+	params_arm_timeout(line, PARAMS_TIMEOUT);
+	params_trace(line, 1, 0);
+	spin_unlock_irqrestore(&vfe->output_lock, flags);
+
+	/* Only this worker uses DMI while streaming. Full PIX stop joins it
+	 * before reset/unpower. Metadata stop cannot overwrite this snapshot.
+	 */
+	if (banks)
+		vfe170_params_upload(line, &p->staged, p->staged_bank);
+
+	spin_lock_irqsave(&vfe->output_lock, flags);
+	if (p->phase == VFE_PARAMS_UPLOAD) {
+		if (p->cancelled || !p->streaming ||
+		    line->output.state != VFE_OUTPUT_ON || line->output.pix.faulted) {
+			p->phase = VFE_PARAMS_IDLE;
+			cancel_delayed_work(&p->timeout_work);
+		} else {
+			p->phase = VFE_PARAMS_READY;
+			params_trace(line, 2, 0);
+		}
+	}
+	spin_unlock_irqrestore(&vfe->output_lock, flags);
+}
+
+static void params_timeout_work(struct work_struct *work)
+{
+	struct vfe_params *p = container_of(to_delayed_work(work), struct vfe_params,
+					   timeout_work);
+	struct vfe_line *line = container_of(p, struct vfe_line, params);
+	struct vfe_device *vfe = to_vfe(line);
+	unsigned long flags;
+	u64 generation = 0;
+	bool fault = false;
+
+	spin_lock_irqsave(&vfe->output_lock, flags);
+	if (p->phase >= VFE_PARAMS_UPLOAD && p->phase <= VFE_PARAMS_RUP) {
+		/* A late callback from a previous transaction must not expire a
+		 * newer one. Check its absolute deadline under the same lock.
+		 */
+		if (time_before(jiffies, p->deadline)) {
+			params_arm_timeout(line, p->deadline - jiffies);
+		} else {
+			p->phase = VFE_PARAMS_FAILED;
+			generation = p->generation;
+			params_trace(line, 6, -ETIMEDOUT);
+			fault = true;
+		}
+	}
+	spin_unlock_irqrestore(&vfe->output_lock, flags);
+	if (fault)
+		vfe170_params_fault(line, generation);
+}
+
+int vfe_params_take(struct vfe_line *line, struct vfe_pix_params *config)
+{
+	struct vfe_params *p = &line->params;
+	struct vfe_params_buffer *buf;
+
+	vfe_params_defaults(config);
+	if (!p->registered)
+		return 0;
+	if (p->streaming && !list_empty(&p->pending)) {
+		buf = list_first_entry(&p->pending, struct vfe_params_buffer, list);
+		if (params_check_size(&buf->config, line->fmt[MSM_VFE_PAD_SINK].width,
+				      line->fmt[MSM_VFE_PAD_SINK].height))
+			return -ERANGE;
+		*config = buf->config;
+		list_move_tail(&buf->list, &p->applied);
+	}
+	p->generation = line->output.pix.generation;
+	p->active = *config;
+	p->staged = *config;
+	/* Typed startup LUTs use bank 0; a replay uses the banks it names. */
+	p->active_bank = p->staged_bank = config->iq.banks & config->iq.classes;
+	p->phase = VFE_PARAMS_STARTUP;
+	p->cancelled = false;
+	p->serial++;
+	p->expected_sequence = 0;
+	params_trace(line, 0, 0);
+	return 0;
+}
+
+void vfe_params_irq(struct vfe_line *line, u64 generation, u32 sequence,
+		    u64 timestamp, u32 events)
+{
+	struct vfe_params *p = &line->params;
+	struct vfe_device *vfe = to_vfe(line);
+	unsigned long flags;
+	bool fault = false, completed = false;
+	LIST_HEAD(done);
+
+	if (!p->registered)
+		return;
+	spin_lock_irqsave(&vfe->output_lock, flags);
+	if (p->generation != generation || line->output.pix.faulted ||
+	    line->output.state == VFE_OUTPUT_STOPPING)
+		goto unlock;
+	if (p->phase == VFE_PARAMS_STARTUP && (events & VFE_PARAMS_IRQ_SOF)) {
+		if (sequence)
+			goto bad_ack;
+		p->phase = VFE_PARAMS_IDLE;
+		completed = true;
+	} else if (p->phase == VFE_PARAMS_RUP && p->late &&
+		   (events & (VFE_PARAMS_IRQ_SOF | VFE_PARAMS_IRQ_RUP)) == VFE_PARAMS_IRQ_SOF &&
+		   sequence == p->expected_sequence) {
+		/* A late commit missed this SOF; its RUP must come with the next. */
+		p->late = false;
+		p->expected_sequence++;
+	} else if (p->phase == VFE_PARAMS_RUP &&
+		   (events & (VFE_PARAMS_IRQ_SOF | VFE_PARAMS_IRQ_RUP))) {
+		/* The fixed-mode contract requires the next SOF and RUP in the
+		 * same snapshot. A separate/late/missing acknowledgement cannot
+		 * be labelled as an effective frame without more evidence.
+		 */
+		if ((events & (VFE_PARAMS_IRQ_SOF | VFE_PARAMS_IRQ_RUP)) !=
+		    (VFE_PARAMS_IRQ_SOF | VFE_PARAMS_IRQ_RUP) ||
+		    sequence != p->expected_sequence)
+			goto bad_ack;
+		p->active = p->staged;
+		p->active_bank = p->staged_bank;
+		p->phase = VFE_PARAMS_IDLE;
+		cancel_delayed_work(&p->timeout_work);
+		completed = true;
+	}
+	if (completed) {
+		params_trace(line, 4, 0);
+		list_splice_init(&p->applied, &done);
+		atomic_inc(&p->completing);
+		params_kick(line);
+	}
+	if (p->phase == VFE_PARAMS_READY && (events & VFE_PARAMS_IRQ_END)) {
+		int ret = vfe170_params_commit(line, &p->staged, p->staged_bank);
+
+		if (ret < 0)
+			goto bad_ack;
+		p->late = ret;
+		p->expected_sequence = line->output.pix.sof_sequence;
+		p->phase = VFE_PARAMS_RUP;
+		p->deadline = jiffies + PARAMS_TIMEOUT;
+		params_arm_timeout(line, PARAMS_TIMEOUT);
+		params_trace(line, 3, p->late);	/* result 1: late commit */
+	}
+	goto unlock;
+
+bad_ack:
+	p->phase = VFE_PARAMS_FAILED;
+	params_trace(line, 6, -EIO);
+	fault = true;
+unlock:
+	spin_unlock_irqrestore(&vfe->output_lock, flags);
+	params_finish(&done, VB2_BUF_STATE_DONE, sequence, timestamp);
+	if (completed && atomic_dec_and_test(&p->completing))
+		wake_up_all(&p->idle);
+	if (fault)
+		vfe170_params_fault(line, generation);
+}
+
+void vfe_params_complete(struct vfe_line *line, u64 generation,
+			 u32 sequence, u64 timestamp)
+{
+	vfe_params_irq(line, generation, sequence, timestamp, VFE_PARAMS_IRQ_SOF);
+}
+
+static void params_cancel(struct vfe_line *line, bool error)
+{
+	struct vfe_device *vfe = to_vfe(line);
+	struct vfe_params *p = &line->params;
+	unsigned long flags;
+	LIST_HEAD(done);
+
+	spin_lock_irqsave(&vfe->output_lock, flags);
+	if (error && p->streaming)
+		vb2_queue_error(&p->queue);
+	p->streaming = false;
+	p->cancelled = true;
+	/* A committed bank must remain owned until acknowledgement or full
+	 * PIX stop, even after its userspace buffer has been cancelled.
+	 */
+	if (p->phase == VFE_PARAMS_READY || p->phase == VFE_PARAMS_STARTUP) {
+		p->phase = VFE_PARAMS_IDLE;
+		cancel_delayed_work(&p->timeout_work);
+	}
+	list_splice_init(&p->pending, &done);
+	list_splice_tail_init(&p->applied, &done);
+	atomic_inc(&p->completing);
+	params_trace(line, 5, error ? -EIO : -ECANCELED);
+	spin_unlock_irqrestore(&vfe->output_lock, flags);
+	params_finish(&done, VB2_BUF_STATE_ERROR, 0, 0);
+	if (atomic_dec_and_test(&p->completing))
+		wake_up_all(&p->idle);
+}
+
+void vfe_params_error(struct vfe_line *line)
+{
+	if (line->params.registered)
+		params_cancel(line, true);
+}
+
+void vfe_params_stop_hw(struct vfe_line *line)
+{
+	struct vfe_params *p = &line->params;
+	struct vfe_device *vfe = to_vfe(line);
+	unsigned long flags;
+
+	if (!p->registered)
+		return;
+	cancel_work_sync(&p->upload_work);
+	cancel_delayed_work_sync(&p->timeout_work);
+	wait_event(p->idle, !atomic_read(&p->completing));
+	spin_lock_irqsave(&vfe->output_lock, flags);
+	p->phase = VFE_PARAMS_IDLE;
+	spin_unlock_irqrestore(&vfe->output_lock, flags);
+}
+
+static int params_setup(struct vb2_queue *q, unsigned int *buffers,
+			unsigned int *planes, unsigned int sizes[],
+			struct device *alloc_devs[])
+{
+	unsigned int limit = vfe170_params_live ? 8 : 1;
+	unsigned int allocated = vb2_get_num_buffers(q);
+
+	if (allocated >= limit)
+		return -EBUSY;
+	*buffers = clamp_t(unsigned int, *buffers, 1, limit - allocated);
+	if (*planes)
+		return *planes == 1 && sizes[0] >= VFE_PARAMS_SIZE ? 0 : -EINVAL;
+	*planes = 1;
+	sizes[0] = VFE_PARAMS_SIZE;
+	return 0;
+}
+
+static int params_prepare(struct vb2_buffer *vb)
+{
+	struct vfe_line *line = vb2_get_drv_priv(vb->vb2_queue);
+	struct vfe_device *vfe = to_vfe(line);
+	struct vfe_params_buffer *buf = container_of(to_vb2_v4l2_buffer(vb),
+						   struct vfe_params_buffer, vb);
+	void *data = vb2_plane_vaddr(vb, 0);
+	void *snapshot;
+	size_t size = vb2_get_plane_payload(vb, 0);
+	unsigned long flags;
+	bool busy;
+	int ret;
+
+	spin_lock_irqsave(&vfe->output_lock, flags);
+	busy = (!vfe170_params_live && line->output.state == VFE_OUTPUT_ON) ||
+	       line->output.state == VFE_OUTPUT_STOPPING || vfe->wedged ||
+	       (line->output.state == VFE_OUTPUT_ON && line->output.pix.faulted);
+	spin_unlock_irqrestore(&vfe->output_lock, flags);
+	if (busy)
+		return -EBUSY;
+	if (!data || size > VFE_PARAMS_SIZE || size > vb2_plane_size(vb, 0))
+		return -EINVAL;
+	/* Validate a private copy: concurrent writes to the mapped input can
+	 * never alter already validated register values or size fields.
+	 */
+	snapshot = kmemdup(data, size, GFP_KERNEL);
+	if (!snapshot)
+		return -ENOMEM;
+	ret = vfe_params_parse(&buf->config, snapshot, size);
+	kfree(snapshot);
+	if (!ret)
+		ret = params_check_size(&buf->config, line->fmt[MSM_VFE_PAD_SINK].width,
+					line->fmt[MSM_VFE_PAD_SINK].height);
+	return ret;
+}
+
+static void params_queue(struct vb2_buffer *vb)
+{
+	struct vfe_line *line = vb2_get_drv_priv(vb->vb2_queue);
+	struct vfe_device *vfe = to_vfe(line);
+	struct vfe_params_buffer *buf = container_of(to_vb2_v4l2_buffer(vb),
+						   struct vfe_params_buffer, vb);
+	unsigned long flags;
+	bool busy;
+
+	spin_lock_irqsave(&vfe->output_lock, flags);
+	busy = (!vfe170_params_live && line->output.state == VFE_OUTPUT_ON) ||
+	       line->output.state == VFE_OUTPUT_STOPPING || vfe->wedged ||
+	       (line->output.state == VFE_OUTPUT_ON && line->output.pix.faulted);
+	if (!busy) {
+		list_add_tail(&buf->list, &line->params.pending);
+		params_kick(line);
+	}
+	spin_unlock_irqrestore(&vfe->output_lock, flags);
+	if (busy)
+		params_return(buf, VB2_BUF_STATE_ERROR);
+}
+
+static int params_start(struct vb2_queue *q, unsigned int count)
+{
+	struct vfe_line *line = vb2_get_drv_priv(q);
+	struct vfe_device *vfe = to_vfe(line);
+	unsigned long flags;
+	bool busy;
+	LIST_HEAD(done);
+
+	if (!count)
+		return -ENOBUFS;
+	spin_lock_irqsave(&vfe->output_lock, flags);
+	busy = (!vfe170_params_live && line->output.state == VFE_OUTPUT_ON) ||
+	       line->output.state == VFE_OUTPUT_STOPPING || vfe->wedged ||
+	       (line->output.state == VFE_OUTPUT_ON && line->output.pix.faulted);
+	if (busy)
+		list_splice_init(&line->params.pending, &done);
+	else {
+		line->params.streaming = true;
+		params_kick(line);
+	}
+	spin_unlock_irqrestore(&vfe->output_lock, flags);
+	params_finish(&done, VB2_BUF_STATE_QUEUED, 0, 0);
+	return busy ? -EBUSY : 0;
+}
+
+static void params_stop(struct vb2_queue *q)
+{
+	struct vfe_line *line = vb2_get_drv_priv(q);
+
+	params_cancel(line, false);
+	cancel_work_sync(&line->params.upload_work);
+	wait_event(line->params.idle, !atomic_read(&line->params.completing));
+}
+
+static const struct vb2_ops params_queue_ops = {
+	.queue_setup = params_setup, .buf_prepare = params_prepare,
+	.buf_queue = params_queue, .start_streaming = params_start,
+	.stop_streaming = params_stop,
+};
+
+static int params_querycap(struct file *file, void *priv, struct v4l2_capability *cap)
+{
+	strscpy(cap->driver, "qcom-camss", sizeof(cap->driver));
+	strscpy(cap->card, "Titan170 ISP parameters", sizeof(cap->card));
+	return 0;
+}
+
+static int params_enum_fmt(struct file *file, void *priv, struct v4l2_fmtdesc *f)
+{
+	if (f->index)
+		return -EINVAL;
+	f->pixelformat = VFE_PARAMS_FOURCC;
+	strscpy(f->description, "Qualcomm ISP parameters", sizeof(f->description));
+	return 0;
+}
+
+static int params_fmt(struct file *file, void *priv, struct v4l2_format *f)
+{
+	memset(&f->fmt.meta, 0, sizeof(f->fmt.meta));
+	f->fmt.meta.dataformat = VFE_PARAMS_FOURCC;
+	f->fmt.meta.buffersize = VFE_PARAMS_SIZE;
+	return 0;
+}
+
+static const struct v4l2_ioctl_ops params_ioctl_ops = {
+	.vidioc_querycap = params_querycap,
+	.vidioc_enum_fmt_meta_out = params_enum_fmt,
+	.vidioc_g_fmt_meta_out = params_fmt, .vidioc_s_fmt_meta_out = params_fmt,
+	.vidioc_try_fmt_meta_out = params_fmt,
+	.vidioc_reqbufs = vb2_ioctl_reqbufs, .vidioc_create_bufs = vb2_ioctl_create_bufs,
+	.vidioc_prepare_buf = vb2_ioctl_prepare_buf, .vidioc_querybuf = vb2_ioctl_querybuf,
+	.vidioc_expbuf = vb2_ioctl_expbuf,
+	.vidioc_qbuf = vb2_ioctl_qbuf, .vidioc_dqbuf = vb2_ioctl_dqbuf,
+	.vidioc_streamon = vb2_ioctl_streamon, .vidioc_streamoff = vb2_ioctl_streamoff,
+};
+
+static const struct v4l2_file_operations params_fops = {
+	.owner = THIS_MODULE, .open = v4l2_fh_open, .release = vb2_fop_release,
+	.poll = vb2_fop_poll, .mmap = vb2_fop_mmap, .unlocked_ioctl = video_ioctl2,
+};
+
+static int params_init_queue(struct vfe_line *line, struct device *dev)
+{
+	struct vfe_params *p = &line->params;
+	struct vb2_queue *q = &p->queue;
+
+	mutex_init(&p->lock);
+	INIT_LIST_HEAD(&p->pending);
+	INIT_LIST_HEAD(&p->applied);
+	init_waitqueue_head(&p->idle);
+	atomic_set(&p->completing, 0);
+	INIT_WORK(&p->upload_work, params_upload_work);
+	INIT_DELAYED_WORK(&p->timeout_work, params_timeout_work);
+	q->type = V4L2_BUF_TYPE_META_OUTPUT;
+	q->io_modes = VB2_MMAP;
+	q->drv_priv = line;
+	q->buf_struct_size = sizeof(struct vfe_params_buffer);
+	q->ops = &params_queue_ops;
+	q->mem_ops = &vb2_vmalloc_memops;
+	q->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_MONOTONIC;
+	q->lock = &p->lock;
+	q->dev = dev;
+	/* A min_queued_buffers of 1 would force two allocations in vb2. Start
+	 * explicitly rejects an empty queue; queue_setup limits allocation to 1.
+	 */
+	return vb2_queue_init(q);
+}
+
+static int params_link_validate(struct media_link *link)
+{
+	struct video_device *vdev;
+	struct vfe_line *line;
+
+	if (!is_media_entity_v4l2_video_device(link->source->entity))
+		return -EINVAL;
+	vdev = media_entity_to_video_device(link->source->entity);
+	line = video_get_drvdata(vdev);
+	/* QCIP is metadata with one fixed format, not an image mbus format.
+	 * Only the immutable link to this VFE's parameter sink is valid.
+	 */
+	if (!line || vdev != &line->params.vdev || link->source->index != 0 ||
+	    link->sink->entity != &line->subdev.entity ||
+	    link->sink->index != MSM_VFE_PAD_PARAMS)
+		return -EINVAL;
+	return 0;
+}
+
+static const struct media_entity_operations params_entity_ops = {
+	.link_validate = params_link_validate,
+};
+
+int vfe_params_register(struct vfe_line *line, struct v4l2_device *v4l2_dev)
+{
+	struct vfe_params *p = &line->params;
+	struct vfe_device *vfe = to_vfe(line);
+	struct video_device *vdev = &p->vdev;
+	struct vb2_queue *q = &p->queue;
+	int ret;
+
+	ret = params_init_queue(line, vfe->camss->dev);
+	if (ret)
+		goto error_mutex;
+	snprintf(vdev->name, sizeof(vdev->name), "msm_vfe%u_params", vfe->id);
+	vdev->v4l2_dev = v4l2_dev;
+	vdev->fops = &params_fops;
+	vdev->ioctl_ops = &params_ioctl_ops;
+	vdev->release = video_device_release_empty;
+	vdev->lock = &p->lock;
+	vdev->queue = q;
+	vdev->vfl_dir = VFL_DIR_TX;
+	vdev->device_caps = V4L2_CAP_META_OUTPUT | V4L2_CAP_STREAMING;
+	video_set_drvdata(vdev, line);
+	vdev->entity.ops = &params_entity_ops;
+	p->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&vdev->entity, 1, &p->pad);
+	if (ret)
+		goto error_queue;
+	ret = video_register_device(vdev, VFL_TYPE_VIDEO, -1);
+	if (ret)
+		goto error_entity;
+	ret = media_create_pad_link(&vdev->entity, 0, &line->subdev.entity,
+				    MSM_VFE_PAD_PARAMS,
+				    MEDIA_LNK_FL_ENABLED | MEDIA_LNK_FL_IMMUTABLE);
+	if (ret) {
+		video_unregister_device(vdev);
+		goto error_entity;
+	}
+	p->registered = true;
+	return 0;
+error_entity:
+	media_entity_cleanup(&vdev->entity);
+error_queue:
+	vb2_queue_release(q);
+error_mutex:
+	mutex_destroy(&p->lock);
+	return ret;
+}
+
+void vfe_params_unregister(struct vfe_line *line)
+{
+	struct vfe_params *p = &line->params;
+
+	if (!p->registered)
+		return;
+	video_unregister_device(&p->vdev);
+	params_cancel(line, false);
+	vfe_params_stop_hw(line);
+	vb2_queue_release(&p->queue);
+	media_entity_cleanup(&p->vdev.entity);
+	p->registered = false;
+	mutex_destroy(&p->lock);
+}
+
+#if IS_ENABLED(CONFIG_VIDEO_QCOM_CAMSS_KUNIT_TEST)
+#include "camss-vfe-params-test.c"
+#endif
diff --git a/drivers/media/platform/qcom/camss/camss-vfe-params.h b/drivers/media/platform/qcom/camss/camss-vfe-params.h
new file mode 100644
index 000000000000..a9ee1ed6b88b
--- /dev/null
+++ b/drivers/media/platform/qcom/camss/camss-vfe-params.h
@@ -0,0 +1,155 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef CAMSS_VFE_PARAMS_H
+#define CAMSS_VFE_PARAMS_H
+
+#include <linux/qcom-camss-config.h>
+#include <linux/wait.h>
+#include <linux/workqueue.h>
+#include "camss-video.h"
+
+#define VFE_PARAMS_FOURCC v4l2_fourcc('Q', 'C', 'I', 'P')
+#define VFE_PARAMS_SIZE (sizeof(struct v4l2_isp_buffer) + \
+	sizeof(struct camss_params_wb_gain) + \
+	sizeof(struct camss_params_color_correct) + \
+	sizeof(struct camss_ife_params_gamma_64) + sizeof(struct camss_params_bls) + \
+	sizeof(struct camss_params_linearization) + sizeof(struct camss_params_lsc) + \
+	VFE_IQ_BLOCK_MAX + sizeof(struct camss_params_demux) + sizeof(struct camss_params_bpc) + \
+	sizeof(struct camss_params_abf) + sizeof(struct camss_params_gtm))
+#define VFE_IQ_BLOCK_MAX (sizeof(struct camss_params_iq_replay) + \
+	CAMSS_IQ_REPLAY_MAX_REGS * sizeof(struct camss_iq_reg) + \
+	CAMSS_IQ_REPLAY_MAX_LUTS * sizeof(struct camss_iq_lut) + \
+	CAMSS_IQ_REPLAY_LUT_WORDS * 4)
+
+/* Internal trace/update mask bit, not the private QCIP wire identifier. */
+#define VFE_PARAMS_BLS BIT(10)
+#define VFE_PARAMS_LINEARIZATION BIT(11)
+#define VFE_PARAMS_LSC BIT(12)
+#define VFE_PARAMS_IQ BIT(13)
+#define VFE_PARAMS_DEMUX BIT(14)
+#define VFE_PARAMS_BPC BIT(15)
+#define VFE_PARAMS_ABF BIT(16)
+#define VFE_PARAMS_GTM BIT(17)
+#define VFE_PARAMS_DMI (BIT(CAMSS_IFE_PARAMS_GAMMA_64) | VFE_PARAMS_LINEARIZATION | \
+	VFE_PARAMS_LSC | VFE_PARAMS_ABF | VFE_PARAMS_GTM)
+
+/* Bank ownership bits, shared by typed blocks and the IQ replay. */
+#define VFE_BANK_GAMMA 0
+#define VFE_BANK_LINEAR 1
+#define VFE_BANK_LSC 2
+#define VFE_BANK_ABF 3
+#define VFE_BANK_GTM 4
+
+/* One allowlisted DMI LUT: bank-0 select, bank-1 select step, owner. */
+struct vfe_iq_lut {
+	u8 sel, step, cls;
+	bool dmi64;
+	u16 words, offset; /* 32-bit words; offset into vfe_iq_replay.lut */
+};
+
+#define VFE_IQ_LUTS 8
+extern const struct vfe_iq_lut vfe_iq_luts[VFE_IQ_LUTS];
+extern const u16 vfe_iq_ranges[][2];
+extern const unsigned int vfe_iq_nranges;
+
+/* Validated allowlisted writes, applied in order after the driver's own. */
+struct vfe_iq_replay {
+	u16 nregs;
+	u8 luts;	/* BIT(i): vfe_iq_luts[i] present */
+	u8 classes;	/* bank ownership bits uploaded */
+	u8 banks;	/* bank per ownership bit */
+	u32 reg[CAMSS_IQ_REPLAY_MAX_REGS][2]; /* offset, value */
+	u32 lut[CAMSS_IQ_REPLAY_LUT_WORDS];
+};
+
+/* Validated, immutable register values; no userspace pointers. */
+struct vfe_pix_params {
+	u32 mask;
+	u16 wb[3]; /* G B R, Q7 */
+	u16 ccm[9]; /* row-major G B R, signed 12-bit */
+	u16 qfactor;
+	bool ccm_enabled;
+	u32 bls[3]; /* config, Gr/Gb thresholds, R/B thresholds */
+	bool bls_enabled;
+	u32 demux[5]; /* config, left Gr/Gb and B/R, mirrored right gains */
+	u32 bpc[7]; /* configuration only; statistics counter is hardware-owned */
+	u32 abf[23]; /* 0x5e8 then 0x5f4..0x648; bank supplied at commit */
+	u32 abf_lut[64];
+	u32 gamma[3][64]; /* G B R */
+	u32 linear_knee[16]; /* register order R/Gb/B/Gr, pairs high then low */
+	u64 linear_lut[36]; /* segment-major R/Gr/Gb/B, 14-bit base + Q11 slope */
+	bool linear_enabled;
+	u32 lsc[11]; /* 0x6bc..0x6e4, bank bit supplied at commit */
+	u32 lsc_lut[2][CAMSS_LSC_NODES]; /* R|Gr<<13, B|Gb<<13 */
+	u32 lsc_extent[2]; /* remaining mesh coverage in full-resolution pixels */
+	bool lsc_enabled;
+	u32 gtm[128]; /* alternating 18-bit base / 26-bit slope field */
+	bool gtm_enabled;
+	struct vfe_iq_replay iq;
+};
+
+struct vfe_params_buffer {
+	struct vb2_v4l2_buffer vb;
+	struct list_head list;
+	struct vfe_pix_params config;
+};
+
+enum vfe_params_phase {
+	VFE_PARAMS_IDLE,
+	VFE_PARAMS_STARTUP,
+	VFE_PARAMS_UPLOAD,
+	VFE_PARAMS_READY,
+	VFE_PARAMS_RUP,
+	VFE_PARAMS_FAILED,
+};
+
+#define VFE_PARAMS_IRQ_SOF BIT(0)
+#define VFE_PARAMS_IRQ_RUP BIT(1)
+#define VFE_PARAMS_IRQ_END BIT(2)
+
+struct vfe_params {
+	struct video_device vdev;
+	struct vb2_queue queue;
+	struct mutex lock;
+	struct media_pad pad;
+	wait_queue_head_t idle;
+	atomic_t completing;
+	struct work_struct upload_work;
+	struct delayed_work timeout_work;
+	/* All fields below protected by parent output_lock. */
+	struct list_head pending;
+	struct list_head applied;
+	u64 generation;
+	u64 serial;
+	struct vfe_pix_params active, staged;
+	enum vfe_params_phase phase;
+	unsigned long deadline;
+	u32 expected_sequence;
+	u8 active_bank, staged_bank;
+	bool cancelled;
+	bool late;	/* committed as the next frame began: RUP may lag a SOF */
+	bool streaming;
+	bool registered;
+};
+
+struct vfe_line;
+void vfe_params_defaults(struct vfe_pix_params *config);
+int vfe_params_parse(struct vfe_pix_params *config, const void *data, size_t size);
+/* Called under output_lock, before upstream starts. */
+int vfe_params_take(struct vfe_line *line, struct vfe_pix_params *config);
+void vfe_params_complete(struct vfe_line *line, u64 generation,
+			 u32 sequence, u64 timestamp);
+void vfe_params_irq(struct vfe_line *line, u64 generation, u32 sequence,
+		    u64 timestamp, u32 events);
+void vfe_params_error(struct vfe_line *line);
+void vfe_params_stop_hw(struct vfe_line *line);
+int vfe_params_register(struct vfe_line *line, struct v4l2_device *v4l2_dev);
+void vfe_params_unregister(struct vfe_line *line);
+
+extern bool vfe170_params_live;
+void vfe170_params_upload(struct vfe_line *line, const struct vfe_pix_params *config,
+			 u8 bank);
+int vfe170_params_commit(struct vfe_line *line, const struct vfe_pix_params *config,
+			u8 bank);
+void vfe170_params_fault(struct vfe_line *line, u64 generation);
+
+#endif
diff --git a/drivers/media/platform/qcom/camss/camss-vfe-stats.c b/drivers/media/platform/qcom/camss/camss-vfe-stats.c
new file mode 100644
index 000000000000..b21b9841cb9d
--- /dev/null
+++ b/drivers/media/platform/qcom/camss/camss-vfe-stats.c
@@ -0,0 +1,243 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Titan170 CPU-only statistics sink. PIX owns the hardware and DMA rings. */
+#include <linux/module.h>
+#include <media/v4l2-ioctl.h>
+#include <media/videobuf2-vmalloc.h>
+#include "camss.h"
+#include "camss-vfe.h"
+
+static struct vfe_line *stats_line(struct vb2_queue *q)
+{
+	return vb2_get_drv_priv(q);
+}
+
+static int stats_queue_setup(struct vb2_queue *q, unsigned int *buffers,
+			     unsigned int *planes, unsigned int sizes[],
+			     struct device *alloc_devs[])
+{
+	if (*planes)
+		return *planes == 1 && sizes[0] >= vfe_stats_payload_size() ?
+			0 : -EINVAL;
+	*planes = 1;
+	sizes[0] = vfe_stats_payload_size();
+	return 0;
+}
+
+static int stats_prepare(struct vb2_buffer *vb)
+{
+	if (vb2_plane_size(vb, 0) < vfe_stats_payload_size())
+		return -EINVAL;
+	vb2_set_plane_payload(vb, 0, vfe_stats_payload_size());
+	return 0;
+}
+
+static void stats_queue(struct vb2_buffer *vb)
+{
+	struct vfe_line *line = stats_line(vb->vb2_queue);
+	struct vfe_device *vfe = to_vfe(line);
+	struct camss_buffer *buf = container_of(to_vb2_v4l2_buffer(vb),
+					      struct camss_buffer, vb);
+	unsigned long flags;
+
+	spin_lock_irqsave(&vfe->output_lock, flags);
+	list_add_tail(&buf->queue, &line->stats.pending);
+	spin_unlock_irqrestore(&vfe->output_lock, flags);
+}
+
+static void stats_flush(struct vfe_line *line, enum vb2_buffer_state state)
+{
+	struct vfe_device *vfe = to_vfe(line);
+	struct camss_buffer *buf, *next;
+	unsigned long flags;
+	LIST_HEAD(pending);
+
+	spin_lock_irqsave(&vfe->output_lock, flags);
+	list_splice_init(&line->stats.pending, &pending);
+	spin_unlock_irqrestore(&vfe->output_lock, flags);
+	list_for_each_entry_safe(buf, next, &pending, queue) {
+		list_del(&buf->queue);
+		vb2_buffer_done(&buf->vb.vb2_buf, state);
+	}
+}
+
+static int stats_start(struct vb2_queue *q, unsigned int count)
+{
+	struct vfe_line *line = stats_line(q);
+	struct vfe_device *vfe = to_vfe(line);
+	unsigned long flags;
+	int ret = 0;
+
+	spin_lock_irqsave(&vfe->output_lock, flags);
+	if (vfe->wedged || (line->output.state == VFE_OUTPUT_ON &&
+			   line->output.pix.faulted))
+		ret = -EIO;
+	else
+		line->stats.streaming = true;
+	spin_unlock_irqrestore(&vfe->output_lock, flags);
+	if (ret)
+		stats_flush(line, VB2_BUF_STATE_QUEUED);
+	return ret;
+}
+
+static void stats_stop(struct vb2_queue *q)
+{
+	struct vfe_line *line = stats_line(q);
+	struct vfe_device *vfe = to_vfe(line);
+	unsigned long flags;
+
+	/* No more targets can be taken after this lock. Hardware keeps its ring. */
+	spin_lock_irqsave(&vfe->output_lock, flags);
+	line->stats.streaming = false;
+	spin_unlock_irqrestore(&vfe->output_lock, flags);
+	/* Join only copies owning a userspace target, not the live DMA producer. */
+	wait_event(line->stats.idle, !atomic_read(&line->stats.copying));
+	stats_flush(line, VB2_BUF_STATE_ERROR);
+}
+
+static const struct vb2_ops stats_queue_ops = {
+	.queue_setup = stats_queue_setup,
+	.buf_prepare = stats_prepare,
+	.buf_queue = stats_queue,
+	.start_streaming = stats_start,
+	.stop_streaming = stats_stop,
+};
+
+static int stats_querycap(struct file *file, void *priv,
+			  struct v4l2_capability *cap)
+{
+	strscpy(cap->driver, "qcom-camss", sizeof(cap->driver));
+	strscpy(cap->card, "Titan170 statistics", sizeof(cap->card));
+	return 0;
+}
+
+static int stats_enum_fmt(struct file *file, void *priv, struct v4l2_fmtdesc *f)
+{
+	if (f->index)
+		return -EINVAL;
+	f->pixelformat = VFE_STATS_FOURCC;
+	strscpy(f->description, "Qualcomm ISP statistics", sizeof(f->description));
+	return 0;
+}
+
+static int stats_fmt(struct file *file, void *priv, struct v4l2_format *f)
+{
+	memset(&f->fmt.meta, 0, sizeof(f->fmt.meta));
+	f->fmt.meta.dataformat = VFE_STATS_FOURCC;
+	f->fmt.meta.buffersize = vfe_stats_payload_size();
+	return 0;
+}
+
+static const struct v4l2_ioctl_ops stats_ioctl_ops = {
+	.vidioc_querycap = stats_querycap,
+	.vidioc_enum_fmt_meta_cap = stats_enum_fmt,
+	.vidioc_g_fmt_meta_cap = stats_fmt,
+	.vidioc_s_fmt_meta_cap = stats_fmt,
+	.vidioc_try_fmt_meta_cap = stats_fmt,
+	.vidioc_reqbufs = vb2_ioctl_reqbufs,
+	.vidioc_create_bufs = vb2_ioctl_create_bufs,
+	.vidioc_prepare_buf = vb2_ioctl_prepare_buf,
+	.vidioc_querybuf = vb2_ioctl_querybuf,
+	.vidioc_expbuf = vb2_ioctl_expbuf,
+	.vidioc_qbuf = vb2_ioctl_qbuf,
+	.vidioc_dqbuf = vb2_ioctl_dqbuf,
+	.vidioc_streamon = vb2_ioctl_streamon,
+	.vidioc_streamoff = vb2_ioctl_streamoff,
+};
+
+static const struct v4l2_file_operations stats_fops = {
+	.owner = THIS_MODULE,
+	.open = v4l2_fh_open,
+	.release = vb2_fop_release,
+	.poll = vb2_fop_poll,
+	.mmap = vb2_fop_mmap,
+	.unlocked_ioctl = video_ioctl2,
+};
+
+void vfe_stats_error(struct vfe_line *line)
+{
+	struct vfe_device *vfe = to_vfe(line);
+	unsigned long flags;
+
+	if (!line->stats.registered)
+		return;
+	spin_lock_irqsave(&vfe->output_lock, flags);
+	if (line->stats.streaming) {
+		line->stats.streaming = false;
+		vb2_queue_error(&line->stats.queue);
+	}
+	spin_unlock_irqrestore(&vfe->output_lock, flags);
+}
+
+int vfe_stats_register(struct vfe_line *line, struct v4l2_device *v4l2_dev)
+{
+	struct vfe_stats *stats = &line->stats;
+	struct vfe_device *vfe = to_vfe(line);
+	struct vb2_queue *q = &stats->queue;
+	struct video_device *vdev = &stats->vdev;
+	int ret;
+
+	mutex_init(&stats->lock);
+	INIT_LIST_HEAD(&stats->pending);
+	init_waitqueue_head(&stats->idle);
+	atomic_set(&stats->copying, 0);
+	q->type = V4L2_BUF_TYPE_META_CAPTURE;
+	q->io_modes = VB2_MMAP;
+	q->drv_priv = line;
+	q->buf_struct_size = sizeof(struct camss_buffer);
+	q->ops = &stats_queue_ops;
+	q->mem_ops = &vb2_vmalloc_memops;
+	q->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_MONOTONIC;
+	q->lock = &stats->lock;
+	q->dev = vfe->camss->dev;
+	q->min_queued_buffers = 1;
+	ret = vb2_queue_init(q);
+	if (ret)
+		goto error_mutex;
+	snprintf(vdev->name, sizeof(vdev->name), "msm_vfe%u_stats", vfe->id);
+	vdev->v4l2_dev = v4l2_dev;
+	vdev->fops = &stats_fops;
+	vdev->ioctl_ops = &stats_ioctl_ops;
+	vdev->release = video_device_release_empty;
+	vdev->lock = &stats->lock;
+	vdev->queue = q;
+	vdev->vfl_dir = VFL_DIR_RX;
+	vdev->device_caps = V4L2_CAP_META_CAPTURE | V4L2_CAP_STREAMING;
+	video_set_drvdata(vdev, line);
+	stats->pad.flags = MEDIA_PAD_FL_SINK;
+	ret = media_entity_pads_init(&vdev->entity, 1, &stats->pad);
+	if (ret)
+		goto error_queue;
+	ret = video_register_device(vdev, VFL_TYPE_VIDEO, -1);
+	if (ret)
+		goto error_entity;
+	ret = media_create_pad_link(&line->subdev.entity, MSM_VFE_PAD_STATS,
+				    &vdev->entity, 0,
+				    MEDIA_LNK_FL_ENABLED | MEDIA_LNK_FL_IMMUTABLE);
+	if (ret) {
+		video_unregister_device(vdev);
+		goto error_entity;
+	}
+	stats->registered = true;
+	return 0;
+
+error_entity:
+	media_entity_cleanup(&vdev->entity);
+error_queue:
+	vb2_queue_release(q);
+error_mutex:
+	mutex_destroy(&stats->lock);
+	return ret;
+}
+
+void vfe_stats_unregister(struct vfe_line *line)
+{
+	struct vfe_stats *stats = &line->stats;
+
+	if (!stats->registered)
+		return;
+	video_unregister_device(&stats->vdev);
+	vb2_queue_release(&stats->queue);
+	media_entity_cleanup(&stats->vdev.entity);
+	stats->registered = false;
+	mutex_destroy(&stats->lock);
+}
