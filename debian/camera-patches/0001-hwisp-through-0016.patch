+/* Single-IFE DS4/DS16 at 1440x1080 reproduce the stock pyramid words. */
+static void pix_test_ds_stock_registers(struct kunit *test)
+{
+	struct pix_test *t = test->priv;
+	struct vfe_device *vfe = &t->vfe;
+	struct vfe_pix_ds ds[2];
+	static const u32 stock[][2] = {
+		{ 0xd60, 0x04380300 }, { 0xd64, 0x09016c7d }, { 0xd68, 0x021c0300 },
+		{ 0xd6c, 0x300 }, { 0xd70, 0x010e0f00 }, { 0xd74, 0x09016c7d },
+		{ 0xd78, 0x00870f00 }, { 0xd7c, 0xf00 },
+		{ 0xd84, 0x437 }, { 0xd8c, 0xe00 }, { 0xd90, 0x10d }, { 0xd98, 0x3ff00000 },
+		{ 0xd9c, 6 }, { 0xda4, 0x21b }, { 0xdb0, 0x86 }, { 0xdbc, 7 },
+		{ 0xdc4, 0x10d }, { 0xdd0, 0x43 }, { 0xdd8, 0x3ff00000 }, { 0xddc, 6 },
+		{ 0xde4, 0x86 }, { 0xdf0, 0x21 }, { 0xdfc, 7 },
+		/* stock WM5/WM6 stride and frame increment (IPE_RT slices) */
+		{ 0x2728, 0x600 }, { 0x2758, 0x33000 }, { 0x2828, 0x180 }, { 0x2858, 0x3600 },
+	};
+	unsigned int i;
+
+	KUNIT_EXPECT_EQ(test, vfe_pix_ds_geometry(2000, 1128, ds), -EINVAL);
+	/* Stock IPE_RT at 1920x1440: DS4 1920x180, DS16 576x48 (192-byte strides). */
+	KUNIT_ASSERT_EQ(test, vfe_pix_ds_geometry(1920, 1440, ds), 0);
+	KUNIT_EXPECT_EQ(test, ds[0].stride, 1920u);
+	KUNIT_EXPECT_EQ(test, ds[0].lines, 180u);
+	KUNIT_EXPECT_EQ(test, ds[1].bytes, 480u);
+	KUNIT_EXPECT_EQ(test, ds[1].stride, 576u);
+	KUNIT_EXPECT_EQ(test, ds[1].lines, 48u);
+	KUNIT_ASSERT_EQ(test, vfe_pix_ds_geometry(1440, 1080, ds), 0);
+	KUNIT_EXPECT_EQ(test, ds[0].w, 360u);
+	KUNIT_EXPECT_EQ(test, ds[0].h, 270u);
+	KUNIT_EXPECT_EQ(test, ds[1].w, 90u);
+	KUNIT_EXPECT_EQ(test, ds[1].h, 68u);
+	writel(ZOOM_EN_CST, vfe->base + VFE_MODULE_ZOOM_EN);
+	vfe_pix_ds_config(vfe, 1440, 1080, ds);
+	for (i = 0; i < ARRAY_SIZE(stock); i++)
+		KUNIT_EXPECT_EQ_MSG(test, readl(vfe->base + stock[i][0]), stock[i][1],
+				    "offset 0x%x", stock[i][0]);
+	/* Whole-line crops: the stock stripes' crops summed (184+176, 48+42). */
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + 0xd88), 0x59fu);
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + 0xd94), 0x167u);
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + 0xdc8), 0x167u);
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + 0xdd4), 0x59u);
+	/* WM width/height: 4 bytes per pixel, two rows per line, 16-byte width */
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + VFE_BUS_WM_BUFFER_WIDTH_CFG(5)), 1440u);
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + VFE_BUS_WM_BUFFER_HEIGHT_CFG(5)), 135u);
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + VFE_BUS_WM_BUFFER_WIDTH_CFG(6)), 368u);
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + VFE_BUS_WM_BUFFER_HEIGHT_CFG(6)), 34u);
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + VFE_BUS_WM_PACKER_CFG(5)), 0u);
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + VFE_MODULE_ZOOM_EN), 0xfde1u);
+}
