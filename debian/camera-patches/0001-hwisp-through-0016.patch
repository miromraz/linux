+static void params_test_exit(struct kunit *test)
+{
+	struct params_test *t = test->priv;
+	struct vfe_line *line = params_test_line(t);
+
+	params_cancel(line, false);
+	vfe_params_stop_hw(line);
+	vb2_queue_release(&line->params.queue);
+	mutex_destroy(&line->params.lock);
+	vfe170_params_live = false;
+	vfe170_awbbg = false;
+}
