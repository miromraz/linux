+extern bool vfe170_bhist;
+int vfe_stats_register(struct vfe_line *line, struct v4l2_device *v4l2_dev);
+void vfe_stats_unregister(struct vfe_line *line);
+void vfe_stats_error(struct vfe_line *line);
+
