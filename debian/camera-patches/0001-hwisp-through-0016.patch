+/* Exercise the real BHIST engine's pending-bit protocol in both IRQ orders. */
+static void pix_test_bhist_order(struct kunit *test)
+{
+	struct pix_test *t = test->priv;
+	unsigned int order;
+
+	t->ack_reset = true;
+	vfe170_bhist = true;
+	KUNIT_ASSERT_EQ(test, pix_start(t, pix_line(t)), 0);
+	pix_ring2(t)->copy_work.func = pix_test_copy_work;
+	KUNIT_EXPECT_EQ(test, t->allocs, 8);
+	KUNIT_EXPECT_EQ(test, pix_reg(t, VFE_BUS_WM_CFG(VFE_STATS_WM)), 3);
+	KUNIT_EXPECT_EQ(test, pix_reg(t, VFE_BUS_WM_IMAGE_ADDR(VFE_STATS_WM)),
+			PIX_TEST_DMA(5));
+	KUNIT_EXPECT_EQ(test, pix_reg(t, VFE_BHIST_COUNT), 999u | 563u << 16);
+	KUNIT_EXPECT_EQ(test, pix_reg(t, VFE_BUS_COMP_MASK(1)),
+			vfe170_awbbg ? BIT(15) | BIT(16) : BIT(16));
+	for (order = 0; order < 3; order++) {
+		pix_queue(t, order);
+		pix_snap(t, true, false, 100 + order * 10);
+		vfe_pix_frame_irq(&t->vfe, false, order != 0, order != 1, false,
+				  101 + order * 10);
+		if (order < 2) {
+			KUNIT_EXPECT_TRUE(test, pix_st(t)->tok.valid);
+			vfe_pix_frame_irq(&t->vfe, false, order == 0, order == 1, false,
+					  102 + order * 10);
+		}
+		flush_work(&pix_img(t)->copy_work);
+		flush_work(&pix_ring2(t)->copy_work);
+		KUNIT_EXPECT_FALSE(test, pix_st(t)->tok.valid);
+		KUNIT_EXPECT_EQ(test, pix_st(t)->pending_rings, 0);
+	}
+	KUNIT_EXPECT_EQ(test, t->nreturned, 3);
+	KUNIT_EXPECT_EQ(test, t->faults, 0);
+	KUNIT_EXPECT_EQ(test, pix_stop(t, pix_line(t)), 0);
+	KUNIT_EXPECT_EQ(test, t->frees, 8);
+	KUNIT_EXPECT_EQ(test, t->bad_handoff, 0);
+}
