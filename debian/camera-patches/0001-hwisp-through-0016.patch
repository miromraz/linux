+static void params_arm_timeout(struct vfe_line *line, unsigned long delay)
+{
+	KUNIT_STATIC_STUB_REDIRECT(params_arm_timeout, line, delay);
+	mod_delayed_work(system_wq, &line->params.timeout_work, delay);
+}
+
+/* output_lock held. Only the worker starts a new transaction. */
+static void params_kick(struct vfe_line *line)
+{
+	struct vfe_params *p = &line->params;
+
+	KUNIT_STATIC_STUB_REDIRECT(params_kick, line);
+	if (vfe170_params_live && p->streaming && p->phase == VFE_PARAMS_IDLE &&
+	    line->output.state == VFE_OUTPUT_ON && !line->output.pix.faulted &&
+	    !list_empty(&p->pending))
+		schedule_work(&p->upload_work);
+}
