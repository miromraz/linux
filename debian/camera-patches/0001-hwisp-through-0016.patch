+#define PARAMS_TEST_GAMMA_LUTS GENMASK(7, 5)
+
+static void params_test_iq_replay_parse(struct kunit *test)
+{
+	struct params_test *t = test->priv;
+	struct params_test_iq *in = kunit_kzalloc(test, sizeof(*in), GFP_KERNEL);
+	u32 regs[][2] = {
+		{ 0x798, 7 }, { 0x6b0, 0x041e81dd }, { 0x40, 0xdc6 }, { 0x48, 0xe },
+		{ 0xf40, 0x01fe1eae }, { 0xbe8, 0x06c50907 },
+	};
+	/* Driver-owned or unnamed offsets: bus WM, CAMIF, ZOOM_EN, STATS_EN,
+	 * DMI, scaler, ABF gap, reg update, IRQ mask, HDR, pedestal.
+	 */
+	static const u32 denied[] = { 0x2208, 0x478, 0x4c, 0x44, 0xc24, 0xa3c,
+		0x5ec, 0x4ac, 0x5c, 0x57c, 0x4d8, 0x6b2 };
+	size_t size;
+	unsigned int i;
+
+	KUNIT_ASSERT_NOT_NULL(test, in);
+	KUNIT_EXPECT_EQ(test, VFE_IQ_BLOCK_MAX, (size_t)5176);
+	size = params_test_iq_build(in, regs, ARRAY_SIZE(regs), PARAMS_TEST_GAMMA_LUTS, 1);
+	KUNIT_ASSERT_EQ(test, vfe_params_parse(&t->result, in, size), 0);
+	KUNIT_EXPECT_EQ(test, t->result.mask, VFE_PARAMS_IQ);
+	KUNIT_EXPECT_EQ(test, t->result.iq.nregs, 6);
+	KUNIT_EXPECT_EQ(test, t->result.iq.reg[1][0], 0x6b0u);
+	KUNIT_EXPECT_EQ(test, t->result.iq.reg[1][1], 0x041e81ddu);
+	KUNIT_EXPECT_EQ(test, t->result.iq.luts, (u8)PARAMS_TEST_GAMMA_LUTS);
+	KUNIT_EXPECT_EQ(test, t->result.iq.classes, (u8)BIT(VFE_BANK_GAMMA));
+	KUNIT_EXPECT_EQ(test, t->result.iq.banks, (u8)BIT(VFE_BANK_GAMMA));
+	KUNIT_EXPECT_EQ(test, t->result.iq.lut[834 + 63], 7u << 16 | 63);
+	for (i = 0; i < ARRAY_SIZE(denied); i++) {
+		regs[1][0] = denied[i];
+		size = params_test_iq_build(in, regs, ARRAY_SIZE(regs),
+					    PARAMS_TEST_GAMMA_LUTS, 1);
+		KUNIT_EXPECT_LT(test, vfe_params_parse(&t->result, in, size), 0);
+	}
+	regs[1][0] = 0x6b0;
+	/* Module enables: IQ bits only; demux/demosaic/RGB LUT stay on. */
+	regs[2][1] = 0xdc6 | BIT(4);
+	size = params_test_iq_build(in, regs, ARRAY_SIZE(regs), PARAMS_TEST_GAMMA_LUTS, 1);
+	KUNIT_EXPECT_EQ(test, vfe_params_parse(&t->result, in, size), -EPERM);
+	regs[2][1] = 0xdc6 & ~BIT(10);
+	size = params_test_iq_build(in, regs, ARRAY_SIZE(regs), PARAMS_TEST_GAMMA_LUTS, 1);
+	KUNIT_EXPECT_EQ(test, vfe_params_parse(&t->result, in, size), -EPERM);
+	regs[2][1] = 0x404;
+	regs[3][1] = 0x6;
+	size = params_test_iq_build(in, regs, ARRAY_SIZE(regs), PARAMS_TEST_GAMMA_LUTS, 1);
+	KUNIT_EXPECT_EQ(test, vfe_params_parse(&t->result, in, size), -EPERM);
+	regs[2][1] = 0xdc6;
+	regs[3][1] = 0xe;
+	/* Bank selects must match the uploads, all channels together. */
+	regs[0][1] = 3;
+	size = params_test_iq_build(in, regs, ARRAY_SIZE(regs), PARAMS_TEST_GAMMA_LUTS, 1);
+	KUNIT_EXPECT_LT(test, vfe_params_parse(&t->result, in, size), 0);
+	regs[0][1] = 0;
+	size = params_test_iq_build(in, regs, ARRAY_SIZE(regs), PARAMS_TEST_GAMMA_LUTS, 1);
+	KUNIT_EXPECT_LT(test, vfe_params_parse(&t->result, in, size), 0);
+	size = params_test_iq_build(in, regs, ARRAY_SIZE(regs), PARAMS_TEST_GAMMA_LUTS, 0);
+	KUNIT_EXPECT_EQ(test, vfe_params_parse(&t->result, in, size), 0);
+	regs[0][1] = 7;
+	size = params_test_iq_build(in, regs, ARRAY_SIZE(regs), BIT(5) | BIT(6), 1);
+	KUNIT_EXPECT_LT(test, vfe_params_parse(&t->result, in, size), 0);
+	size = params_test_iq_build(in, regs, ARRAY_SIZE(regs), 0, 1);
+	KUNIT_EXPECT_LT(test, vfe_params_parse(&t->result, in, size), 0);
+	size = params_test_iq_build(in, regs + 1, ARRAY_SIZE(regs) - 1,
+				    PARAMS_TEST_GAMMA_LUTS, 1);
+	KUNIT_EXPECT_LT(test, vfe_params_parse(&t->result, in, size), 0);
+	/* LSC needs both tables; complete LSC/ABF/GTM/linearization pass. */
+	{
+		u32 banked[][2] = { { 0x4dc, 1 }, { 0x5e8, 0x06363007 },
+			{ 0x6bc, 0x0b3d0000 }, { 0x794, 1 }, { 0x798, 7 } };
+
+		size = params_test_iq_build(in, banked, 5, 0xff, 1);
+		KUNIT_EXPECT_EQ(test, vfe_params_parse(&t->result, in, size), 0);
+		KUNIT_EXPECT_EQ(test, t->result.iq.classes, (u8)GENMASK(4, 0));
+		KUNIT_EXPECT_EQ(test, t->result.iq.banks, (u8)GENMASK(4, 0));
+		size = params_test_iq_build(in, banked, 5, 0xff & ~BIT(3), 1);
+		KUNIT_EXPECT_LT(test, vfe_params_parse(&t->result, in, size), 0);
+		banked[1][1] &= ~BIT(1);
+		size = params_test_iq_build(in, banked, 5, 0xff, 1);
+		KUNIT_EXPECT_LT(test, vfe_params_parse(&t->result, in, size), 0);
+	}
+	/* Structure: duplicates, lengths, banks, selects, flags, padding. */
+	regs[1][0] = 0x798;
+	size = params_test_iq_build(in, regs, ARRAY_SIZE(regs), PARAMS_TEST_GAMMA_LUTS, 1);
+	KUNIT_EXPECT_LT(test, vfe_params_parse(&t->result, in, size), 0);
+	regs[1][0] = 0x6b0;
+	size = params_test_iq_build(in, regs, ARRAY_SIZE(regs), PARAMS_TEST_GAMMA_LUTS, 2);
+	KUNIT_EXPECT_LT(test, vfe_params_parse(&t->result, in, size), 0);
+	size = params_test_iq_build(in, regs, ARRAY_SIZE(regs), PARAMS_TEST_GAMMA_LUTS, 1);
+	in->data[ARRAY_SIZE(regs) * 2] = 0x3a | 1 << 8 | 64 << 16; /* BHIST RAM */
+	KUNIT_EXPECT_EQ(test, vfe_params_parse(&t->result, in, size), -EPERM);
+	in->data[ARRAY_SIZE(regs) * 2] = 26 | 1 << 8 | 63 << 16;
+	KUNIT_EXPECT_LT(test, vfe_params_parse(&t->result, in, size), 0);
+	size = params_test_iq_build(in, regs, ARRAY_SIZE(regs), PARAMS_TEST_GAMMA_LUTS, 1);
+	in->h.header.flags = 1;
+	KUNIT_EXPECT_LT(test, vfe_params_parse(&t->result, in, size), 0);
+	in->h.header.flags = 2;
+	in->h._pad = 1;
+	KUNIT_EXPECT_LT(test, vfe_params_parse(&t->result, in, size), 0);
+	in->h._pad = 0;
+	in->h.num_regs = CAMSS_IQ_REPLAY_MAX_REGS + 1;
+	KUNIT_EXPECT_LT(test, vfe_params_parse(&t->result, in, size), 0);
+	in->h.num_regs = ARRAY_SIZE(regs);
+	in->h.header.size += 8;
+	in->size += 8;
+	KUNIT_EXPECT_LT(test, vfe_params_parse(&t->result, in, size + 8), 0);
+	for (i = 0; i < size - 8; i += 4)
+		KUNIT_EXPECT_LT(test, vfe_params_parse(&t->result, in, i), 0);
+	/* Kernel-reported AWB-BG geometry stays fixed while it is enabled. */
+	regs[1][0] = 0xbcc;
+	size = params_test_iq_build(in, regs, ARRAY_SIZE(regs), PARAMS_TEST_GAMMA_LUTS, 1);
+	KUNIT_EXPECT_EQ(test, vfe_params_parse(&t->result, in, size), 0);
+	vfe170_awbbg = true;
+	KUNIT_EXPECT_EQ(test, vfe_params_parse(&t->result, in, size), -EPERM);
+	regs[1][0] = 0xaac;
+	size = params_test_iq_build(in, regs, ARRAY_SIZE(regs), PARAMS_TEST_GAMMA_LUTS, 1);
+	KUNIT_EXPECT_EQ(test, vfe_params_parse(&t->result, in, size), -EPERM);
+	vfe170_awbbg = false;
+	KUNIT_EXPECT_EQ(test, vfe_params_parse(&t->result, in, size), 0);
+	vfe170_3a = true;
+	KUNIT_EXPECT_EQ(test, vfe_params_parse(&t->result, in, size), -EPERM);
+	regs[1][0] = 0xbe8;
+	size = params_test_iq_build(in, regs, ARRAY_SIZE(regs), PARAMS_TEST_GAMMA_LUTS, 1);
+	KUNIT_EXPECT_EQ(test, vfe_params_parse(&t->result, in, size), -EPERM);
+	regs[1][0] = 0x6b0;
+	size = params_test_iq_build(in, regs, ARRAY_SIZE(regs) - 1, PARAMS_TEST_GAMMA_LUTS, 1);
+	KUNIT_EXPECT_EQ(test, vfe_params_parse(&t->result, in, size), 0);
+	vfe170_3a = false;
+}
