--- /dev/null
+++ b/drivers/media/platform/qcom/camss/camss-vfe-params-test.c
@@ -0,0 +1,1497 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <kunit/test.h>
+#include <linux/workqueue.h>
+#include "camss-vfe-abf-vectors.h"
+
+struct params_test_input {
+	u32 version, size;
+	struct camss_params_wb_gain wb;
+	struct camss_params_color_correct ccm;
+	struct camss_ife_params_gamma_64 gamma;
+};
+
+struct params_test {
+	struct vfe_device vfe;
+	struct vfe_params_buffer buf, second;
+	struct params_test_input input;
+	struct vfe_pix_params result;
+	int returned, uploads, commits, faults, kicks;
+	int commit_error;
+	u8 uploaded_bank;
+	u32 last_sequence;
+	enum vb2_buffer_state state;
+	struct work_struct complete_work;
+	struct delayed_work release_work;
+	struct completion entered, release;
+};
+
+static struct vfe_line *params_test_line(struct params_test *t)
+{
+	return &t->vfe.line[VFE_LINE_PIX];
+}
+
+static void params_test_return(struct vfe_params_buffer *buf, enum vb2_buffer_state state)
+{
+	struct params_test *t = kunit_get_current_test()->priv;
+
+	t->returned++;
+	t->state = state;
+	t->last_sequence = buf->vb.sequence;
+}
+
+static void params_test_kick(struct vfe_line *line)
+{
+	struct params_test *t = kunit_get_current_test()->priv;
+
+	t->kicks++;
+}
+
+static void params_test_arm_timeout(struct vfe_line *line, unsigned long delay)
+{
+	/* Tests invoke timeout_work explicitly; do not run fake MMIO on a worker. */
+}
+
+static void params_test_upload(struct vfe_line *line,
+			       const struct vfe_pix_params *config, u8 bank)
+{
+	struct params_test *t = kunit_get_current_test()->priv;
+
+	t->uploads++;
+	t->uploaded_bank = bank;
+	KUNIT_EXPECT_NE(kunit_get_current_test(), bank, line->params.active_bank);
+}
+
+static int params_test_commit(struct vfe_line *line,
+			     const struct vfe_pix_params *config, u8 bank)
+{
+	struct params_test *t = kunit_get_current_test()->priv;
+
+	t->commits++;
+	return t->commit_error;
+}
+
+static void params_test_fault(struct vfe_line *line, u64 generation)
+{
+	struct params_test *t = kunit_get_current_test()->priv;
+
+	t->faults++;
+	line->output.pix.faulted = true;
+	vfe_params_error(line);
+}
+
+static void params_test_worker(struct work_struct *work)
+{
+	struct params_test *t = container_of(work, struct params_test, complete_work);
+
+	/* Model a detached completion still owning its vb2 target. */
+	complete(&t->entered);
+	wait_for_completion_timeout(&t->release, HZ);
+	atomic_dec(&params_test_line(t)->params.completing);
+	wake_up_all(&params_test_line(t)->params.idle);
+}
+
+static void params_test_release(struct work_struct *work)
+{
+	struct params_test *t = container_of(to_delayed_work(work), struct params_test,
+					   release_work);
+
+	complete(&t->release);
+}
+
+static int params_test_init(struct kunit *test)
+{
+	struct params_test *t = kunit_kzalloc(test, sizeof(*t), GFP_KERNEL);
+	struct vfe_line *line;
+	unsigned int i;
+
+	KUNIT_ASSERT_NOT_NULL(test, t);
+	test->priv = t;
+	line = params_test_line(t);
+	line->id = VFE_LINE_PIX;
+	spin_lock_init(&t->vfe.output_lock);
+	KUNIT_ASSERT_EQ(test, params_init_queue(line, NULL), 0);
+	INIT_LIST_HEAD(&t->buf.list);
+	INIT_LIST_HEAD(&t->second.list);
+	vfe170_params_live = false;
+	line->params.registered = true;
+	init_completion(&t->entered);
+	init_completion(&t->release);
+	INIT_WORK(&t->complete_work, params_test_worker);
+	INIT_DELAYED_WORK(&t->release_work, params_test_release);
+	kunit_activate_static_stub(test, params_return, params_test_return);
+	kunit_activate_static_stub(test, params_kick, params_test_kick);
+	kunit_activate_static_stub(test, params_arm_timeout, params_test_arm_timeout);
+	kunit_activate_static_stub(test, vfe170_params_upload, params_test_upload);
+	kunit_activate_static_stub(test, vfe170_params_commit, params_test_commit);
+	kunit_activate_static_stub(test, vfe170_params_fault, params_test_fault);
+	t->input.version = 1;
+	t->input.size = sizeof(t->input) - 8;
+	t->input.wb.header = (struct v4l2_isp_block_header) {
+		.type = CAMSS_PARAMS_WB_GAIN, .flags = 2, .size = sizeof(t->input.wb),
+	};
+	t->input.wb.g_gain = 1024;
+	t->input.wb.b_gain = 1536;
+	t->input.wb.r_gain = 2048;
+	t->input.ccm.header = (struct v4l2_isp_block_header) {
+		.type = CAMSS_PARAMS_COLOR_CORRECT, .flags = 2,
+		.size = sizeof(t->input.ccm),
+	};
+	t->input.ccm.a[0] = t->input.ccm.b[1] = t->input.ccm.c[2] = 128;
+	t->input.gamma.header = (struct v4l2_isp_block_header) {
+		.type = CAMSS_IFE_PARAMS_GAMMA_64, .flags = 2,
+		.size = sizeof(t->input.gamma),
+	};
+	for (i = 0; i < 64; i++) {
+		t->input.gamma.table_r[i] = i * 16 | (i == 63 ? 15 : 16) << 10;
+		t->input.gamma.table_g[i] = t->input.gamma.table_r[i];
+		t->input.gamma.table_b[i] = t->input.gamma.table_r[i];
+	}
+	return 0;
+}
+
+static int params_test_parse(struct params_test *t)
+{
+	return vfe_params_parse(&t->result, &t->input, sizeof(t->input));
+}
+
+static void params_test_layout_and_channels(struct kunit *test)
+{
+	struct params_test *t = test->priv;
+
+	KUNIT_EXPECT_EQ(test, sizeof(t->input), (size_t)856);
+	KUNIT_ASSERT_EQ(test, params_test_parse(t), 0);
+	KUNIT_EXPECT_EQ(test, t->result.wb[0], 128);
+	KUNIT_EXPECT_EQ(test, t->result.wb[1], 192);
+	KUNIT_EXPECT_EQ(test, t->result.wb[2], 256);
+	KUNIT_EXPECT_TRUE(test, t->result.ccm_enabled);
+	KUNIT_EXPECT_EQ(test, t->result.mask, BIT(1) | BIT(3) | BIT(9));
+	memset(&t->input, 0xa5, sizeof(t->input));
+	KUNIT_EXPECT_EQ(test, t->result.wb[2], 256);
+	KUNIT_EXPECT_EQ(test, t->result.gamma[0][63], 1008u | 15u << 10);
+}
+
+static void params_test_lengths(struct kunit *test)
+{
+	struct params_test *t = test->priv;
+	unsigned int i;
+
+	for (i = 0; i < sizeof(t->input); i++)
+		KUNIT_EXPECT_LT(test, vfe_params_parse(&t->result, &t->input, i), 0);
+	t->input.wb.header.size = 0;
+	KUNIT_EXPECT_LT(test, params_test_parse(t), 0);
+	t->input.wb.header.size = U32_MAX;
+	KUNIT_EXPECT_LT(test, params_test_parse(t), 0);
+}
+
+static void params_test_headers(struct kunit *test)
+{
+	struct params_test *t = test->priv;
+
+	t->input.version = 2;
+	KUNIT_EXPECT_LT(test, params_test_parse(t), 0);
+	t->input.version = 1;
+	t->input.wb.header.flags = 3;
+	KUNIT_EXPECT_LT(test, params_test_parse(t), 0);
+	t->input.wb.header.flags = 2;
+	t->input.gamma.header.type = 5; /* Never reinterpret conflicting IFE WB. */
+	KUNIT_EXPECT_LT(test, params_test_parse(t), 0);
+	t->input.gamma.header.type = 1;
+	KUNIT_EXPECT_LT(test, params_test_parse(t), 0);
+	t->input.gamma.header.type = 32;
+	KUNIT_EXPECT_LT(test, params_test_parse(t), 0);
+}
+
+static void params_test_wb_rejects_offsets_and_overflow(struct kunit *test)
+{
+	struct params_test *t = test->priv;
+
+	t->input.wb.r_gain = 32763;
+	KUNIT_ASSERT_EQ(test, params_test_parse(t), 0);
+	KUNIT_EXPECT_EQ(test, t->result.wb[2], 4095);
+	t->input.wb.r_gain = 32764;
+	KUNIT_EXPECT_LT(test, params_test_parse(t), 0);
+	t->input.wb.r_gain = 1024;
+	t->input.wb.g_sub = 1;
+	KUNIT_EXPECT_LT(test, params_test_parse(t), 0);
+	t->input.wb.g_sub = 0;
+	t->input.wb._pad[2] = 1;
+	KUNIT_EXPECT_LT(test, params_test_parse(t), 0);
+}
+
+static void params_test_ccm_signed_fields(struct kunit *test)
+{
+	struct params_test *t = test->priv;
+
+	t->input.ccm.b[0] = 0xff0; /* -16 */
+	KUNIT_ASSERT_EQ(test, params_test_parse(t), 0);
+	KUNIT_EXPECT_EQ(test, t->result.ccm[1], 0xff0);
+	t->input.ccm.b[0] = 0xfff0;
+	KUNIT_EXPECT_LT(test, params_test_parse(t), 0);
+	t->input.ccm.b[0] = 0;
+	t->input.ccm.qfactor = 4;
+	KUNIT_EXPECT_LT(test, params_test_parse(t), 0);
+	t->input.ccm.qfactor = 0;
+	t->input.ccm.k[0] = 1;
+	KUNIT_EXPECT_LT(test, params_test_parse(t), 0);
+}
+
+static void params_test_gamma_bounds_and_routing(struct kunit *test)
+{
+	struct params_test *t = test->priv;
+	unsigned int i;
+
+	for (i = 0; i < 64; i++)
+		t->input.gamma.table_b[i] = (1008 - i * 16) | (i == 63 ? 0 : 1008) << 10;
+	KUNIT_ASSERT_EQ(test, params_test_parse(t), 0);
+	KUNIT_EXPECT_EQ(test, t->result.gamma[1][0], 1008u | 1008u << 10);
+	KUNIT_EXPECT_EQ(test, t->result.gamma[2][0], 16u << 10);
+	t->input.gamma.table_b[0] |= BIT(20);
+	KUNIT_EXPECT_LT(test, params_test_parse(t), 0);
+	t->input.gamma.table_b[0] = 1009 | 1008 << 10; /* Broken knot continuity. */
+	KUNIT_EXPECT_LT(test, params_test_parse(t), 0);
+	t->input.gamma.table_b[0] = 1008 | 1008 << 10;
+	t->input.gamma.table_r[63] = 1008 | 17 << 10; /* Endpoint 1025. */
+	KUNIT_EXPECT_LT(test, params_test_parse(t), 0);
+}
+
+static void params_test_disabled_blocks(struct kunit *test)
+{
+	struct params_test *t = test->priv;
+
+	t->input.wb.header.flags = 1;
+	t->input.ccm.header.flags = 1;
+	t->input.gamma.header.flags = 1;
+	KUNIT_ASSERT_EQ(test, params_test_parse(t), 0);
+	KUNIT_EXPECT_EQ(test, t->result.wb[2], 128);
+	KUNIT_EXPECT_FALSE(test, t->result.ccm_enabled);
+	KUNIT_EXPECT_EQ(test, t->result.gamma[1][63], 1008u | 15u << 10);
+}
+
+static void params_test_first_sof_and_cancel(struct kunit *test)
+{
+	struct params_test *t = test->priv;
+	struct vfe_line *line = params_test_line(t);
+
+	KUNIT_ASSERT_EQ(test, params_test_parse(t), 0);
+	t->buf.config = t->result;
+	list_add_tail(&t->buf.list, &line->params.pending);
+	KUNIT_ASSERT_EQ(test, params_start(&line->params.queue, 1), 0);
+	vfe_params_take(line, &t->result);
+	KUNIT_EXPECT_EQ(test, t->result.wb[2], 256);
+	KUNIT_EXPECT_EQ(test, t->returned, 0);
+	vfe_params_complete(line, 1, 0, 123); /* A delayed IRQ from another start. */
+	KUNIT_EXPECT_EQ(test, t->returned, 0);
+	vfe_params_complete(line, 0, 0, 456);
+	KUNIT_EXPECT_EQ(test, t->returned, 1);
+	KUNIT_EXPECT_EQ(test, t->state, VB2_BUF_STATE_DONE);
+	KUNIT_EXPECT_EQ(test, t->buf.vb.vb2_buf.timestamp, 456ull);
+	params_stop(&line->params.queue);
+	KUNIT_EXPECT_EQ(test, t->returned, 1);
+}
+
+static void params_test_stop_before_sof(struct kunit *test)
+{
+	struct params_test *t = test->priv;
+	struct vfe_line *line = params_test_line(t);
+
+	list_add_tail(&t->buf.list, &line->params.pending);
+	line->params.streaming = true;
+	vfe_params_take(line, &t->result);
+	params_stop(&line->params.queue);
+	KUNIT_EXPECT_EQ(test, t->returned, 1);
+	KUNIT_EXPECT_EQ(test, t->state, VB2_BUF_STATE_ERROR);
+	vfe_params_complete(line, 0, 0, 456);
+	KUNIT_EXPECT_EQ(test, t->returned, 1);
+}
+
