+static void params_test_bls_fields(struct kunit *test)
+{
+	struct params_test *t = test->priv;
+	struct {
+		u32 version, size;
+		struct camss_params_bls bls;
+	} input = {
+		.version = 1, .size = sizeof(struct camss_params_bls),
+		.bls = {
+			.header = { .type = CAMSS_PARAMS_BLS_EXPERIMENTAL,
+				.flags = 2, .size = sizeof(struct camss_params_bls) },
+			.offset = 1024, .scale_q11 = 2184,
+			.threshold = { 11, 22, 33, 44 },
+		},
+	};
+	unsigned int i;
+
+	KUNIT_EXPECT_EQ(test, sizeof(input), (size_t)40);
+	KUNIT_EXPECT_EQ(test, VFE_PARAMS_SIZE, (size_t)9072);
+	KUNIT_ASSERT_EQ(test, vfe_params_parse(&t->result, &input, sizeof(input)), 0);
+	KUNIT_EXPECT_EQ(test, t->result.mask, VFE_PARAMS_BLS);
+	KUNIT_EXPECT_TRUE(test, t->result.bls_enabled);
+	KUNIT_EXPECT_EQ(test, t->result.bls[0], 0x04440400u);
+	KUNIT_EXPECT_EQ(test, t->result.bls[1], 0x002c0021u);
+	KUNIT_EXPECT_EQ(test, t->result.bls[2], 0x0016000bu);
+	/* The stock intermediate's 16-bit narrowing must not be copied. */
+	input.bls.scale_q11 = 65536;
+	KUNIT_ASSERT_EQ(test, vfe_params_parse(&t->result, &input, sizeof(input)), 0);
+	KUNIT_EXPECT_EQ(test, t->result.bls[0], 0x80000400u);
+	input.bls.scale_q11 = 131071;
+	KUNIT_ASSERT_EQ(test, vfe_params_parse(&t->result, &input, sizeof(input)), 0);
+	KUNIT_EXPECT_EQ(test, t->result.bls[0], 0xffff8400u);
+	input.bls.scale_q11++;
+	KUNIT_EXPECT_LT(test, vfe_params_parse(&t->result, &input, sizeof(input)), 0);
+	KUNIT_EXPECT_EQ(test, t->result.bls[0], 0xffff8400u); /* atomic failure */
+	input.bls.scale_q11 = 0;
+	KUNIT_EXPECT_LT(test, vfe_params_parse(&t->result, &input, sizeof(input)), 0);
+	input.bls.scale_q11 = 2048;
+	input.bls.offset = 16384;
+	KUNIT_EXPECT_LT(test, vfe_params_parse(&t->result, &input, sizeof(input)), 0);
+	input.bls.offset = 16383;
+	KUNIT_ASSERT_EQ(test, vfe_params_parse(&t->result, &input, sizeof(input)), 0);
+	for (i = 0; i < 4; i++) {
+		input.bls.threshold[i] = 16384;
+		KUNIT_EXPECT_LT(test, vfe_params_parse(&t->result, &input, sizeof(input)), 0);
+		input.bls.threshold[i] = 16383;
+	}
+	input.bls.header.flags = 1;
+	KUNIT_ASSERT_EQ(test, vfe_params_parse(&t->result, &input, sizeof(input)), 0);
+	KUNIT_EXPECT_FALSE(test, t->result.bls_enabled);
+	input.bls._pad0 = 1;
+	KUNIT_EXPECT_LT(test, vfe_params_parse(&t->result, &input, sizeof(input)), 0);
+	input.bls._pad0 = 0;
+	for (i = 0; i < 2; i++) {
+		input.bls._pad[i] = 1;
+		KUNIT_EXPECT_LT(test, vfe_params_parse(&t->result, &input, sizeof(input)), 0);
+		input.bls._pad[i] = 0;
+	}
+	input.bls.header.type = 10; /* internal mask is NOT a wire assignment */
+	KUNIT_EXPECT_LT(test, vfe_params_parse(&t->result, &input, sizeof(input)), 0);
+}
