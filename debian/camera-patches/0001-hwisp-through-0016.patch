+/* The TL_BG block follows HDR-BHIST; the earlier blocks keep their offsets. */
+static void pix_test_stock_tlbg_serialization(struct kunit *test)
+{
+	static const struct vb2_mem_ops memops = { .vaddr = bhist_test_vaddr };
+	struct pix_test *t = test->priv;
+	struct vb2_queue queue = { .mem_ops = &memops };
+	struct camss_buffer buf = {};
+	struct vfe_pix_frame frame = {};
+	struct vfe_pix_ring ring = { .line = pix_line(t) };
+	struct vfe_bhist_buffer *dst;
+	struct camss_stats_awb_bg *be, *tl;
+	struct camss_stats_hdr_bhist *hist;
+	u8 *src;
+	unsigned int i;
+
+	pix_stock_stats_mode(t);
+	vfe170_tlbg = true;
+	dst = kunit_kmalloc(test, vfe_stats_payload_size(), GFP_KERNEL);
+	src = kunit_kzalloc(test, vfe_stats_dma_size(), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, dst);
+	KUNIT_ASSERT_NOT_NULL(test, src);
+	KUNIT_EXPECT_EQ(test, vfe_stats_dma_size(), (size_t)154624 + 18432);
+	memset(dst, 0xa5, vfe_stats_payload_size());
+	for (i = 0; i < VFE_BG_REGIONS; i++)
+		put_unaligned_le32(i + 65536, src + VFE_HDR_BE_OFFSET + i * 24);
+	for (i = 0; i < VFE_TL_BG_REGIONS; i++) {
+		u8 *r = src + VFE_TL_BG_OFFSET + i * 24;
+
+		put_unaligned_le32(0xc0000000u | i, r);	/* bits 31:30 are reserved */
+		put_unaligned_le32(i + 1, r + 4);
+		put_unaligned_le32(i + 2, r + 8);
+		put_unaligned_le32(i + 3, r + 12);
+		put_unaligned_le16(5184, r + 16);
+		put_unaligned_le16(5183, r + 18);
+		put_unaligned_le16(5182, r + 20);
+		put_unaligned_le16(5181, r + 22);
+	}
+	frame.cpu = src;
+	pix_line(t)->stats.bg_mbus_code = MEDIA_BUS_FMT_SGRBG10_1X10;
+	buf.vb.vb2_buf.vb2_queue = &queue;
+	buf.vb.vb2_buf.num_planes = 1;
+	buf.vb.vb2_buf.planes[0].mem_priv = dst;
+	buf.vb.vb2_buf.planes[0].length = vfe_stats_payload_size();
+	KUNIT_ASSERT_EQ(test, vfe_bhist_copy(NULL, &ring, &frame, &buf), 0);
+	KUNIT_EXPECT_EQ(test, vfe_stats_payload_size(), (size_t)302216 + 36912);
+	KUNIT_EXPECT_EQ(test, dst->data_size, 302208 + 36912);
+	be = (void *)(dst + 1) + VFE_BG_BLOCK_SIZE;
+	hist = (void *)be + VFE_BG_BLOCK_SIZE;
+	tl = (void *)(hist + 1);
+	KUNIT_EXPECT_EQ(test, be->header.type, 0x8002);
+	KUNIT_EXPECT_EQ(test, be->regions[3071].r_sum, 3071 + 65536);
+	KUNIT_EXPECT_EQ(test, hist->header.type, 0x8003);
+	KUNIT_EXPECT_EQ(test, tl->header.type, 0x8005);
+	KUNIT_EXPECT_EQ(test, tl->header.size, 36912);
+	KUNIT_EXPECT_EQ(test, tl->columns, 32);
+	KUNIT_EXPECT_EQ(test, tl->rows, 24);
+	KUNIT_EXPECT_EQ(test, tl->region_width, 144);
+	KUNIT_EXPECT_EQ(test, tl->region_height, 144);
+	KUNIT_EXPECT_EQ(test, tl->left, 0);
+	KUNIT_EXPECT_EQ(test, tl->high[0], 0x3fff);
+	KUNIT_EXPECT_EQ(test, tl->high[3], 0x3fff);
+	KUNIT_EXPECT_EQ(test, tl->config_flags, CAMSS_AWB_BG_SCALE_UNVERIFIED);
+	for (i = 0; i < VFE_TL_BG_REGIONS; i++) {
+		KUNIT_EXPECT_EQ(test, tl->regions[i].r_sum, i);
+		KUNIT_EXPECT_EQ(test, tl->regions[i].b_sum, i + 1);
+		KUNIT_EXPECT_EQ(test, tl->regions[i].gr_sum, i + 2);
+		KUNIT_EXPECT_EQ(test, tl->regions[i].gb_sum, i + 3);
+		KUNIT_EXPECT_EQ(test, tl->regions[i].r_cnt, 5184);
+		KUNIT_EXPECT_EQ(test, tl->regions[i].gb_cnt, 5181);
+		KUNIT_EXPECT_EQ(test, tl->regions[i].sat_r_sum, 0);
+	}
+	KUNIT_EXPECT_PTR_EQ(test, (void *)&tl->regions[VFE_TL_BG_REGIONS],
+			    (void *)dst + vfe_stats_payload_size());
+}
