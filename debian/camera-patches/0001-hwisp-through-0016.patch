+static void params_test_link_validation(struct kunit *test)
+{
+	struct params_test *t = test->priv;
+	struct vfe_line *line = params_test_line(t);
+	struct video_device *vdev = &line->params.vdev;
+	struct media_pad source = { .entity = &vdev->entity, .index = 0 };
+	struct media_pad sink = { .entity = &line->subdev.entity,
+		.index = MSM_VFE_PAD_PARAMS };
+	struct media_link link = { .source = &source, .sink = &sink };
+
+	vdev->entity.obj_type = MEDIA_ENTITY_TYPE_VIDEO_DEVICE;
+	video_set_drvdata(vdev, line);
+	KUNIT_EXPECT_EQ(test, params_link_validate(&link), 0);
+	sink.index = MSM_VFE_PAD_SINK;
+	KUNIT_EXPECT_EQ(test, params_link_validate(&link), -EINVAL);
+	sink.index = MSM_VFE_PAD_PARAMS;
+	sink.entity = &t->vfe.line[VFE_LINE_RDI0].subdev.entity;
+	KUNIT_EXPECT_EQ(test, params_link_validate(&link), -EINVAL);
+	sink.entity = &line->subdev.entity;
+	source.index = 1;
+	KUNIT_EXPECT_EQ(test, params_link_validate(&link), -EINVAL);
