+/* Shared CAMIF errors fail each ring's frame, then both recover next frame. */
+static void pix_test_two_ring_frame_error(struct kunit *test)
+{
+	struct pix_test *t = test->priv;
+
+	t->ack_reset = true;
+	pix_queue(t, 0);
+	pix_queue(t, 1);
