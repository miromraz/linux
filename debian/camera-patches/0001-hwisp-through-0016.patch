diff --git a/include/uapi/linux/qcom-camss-config.h b/include/uapi/linux/qcom-camss-config.h
new file mode 100644
index 000000000000..9f89085174f5
--- /dev/null
+++ b/include/uapi/linux/qcom-camss-config.h
@@ -0,0 +1,274 @@
+/* SPDX-License-Identifier: GPL-2.0-only WITH Linux-syscall-note */
+/*
+ * Qualcomm CAMSS ISP parameters, experimental October 2026 proposal subset.
+ * WB/CCM layouts: Loic Poulain's October 5 CAMSS/OPE proposal.
+ * GAMMA_64 layout/identifier: October 7 IFE proposal.
+ * These proposals are not a stable upstream ABI. Type 5 is reserved for the
+ * October 5 BHIST ROI; do not import the conflicting October 7 WB type 5.
+ */
+#ifndef _UAPI_LINUX_QCOM_CAMSS_CONFIG_H
+#define _UAPI_LINUX_QCOM_CAMSS_CONFIG_H
+
+#include <linux/types.h>
+#include <linux/media/v4l2-isp.h>
+
+enum camss_params_block_type {
+	CAMSS_PARAMS_WB_GAIN = 1,
+	CAMSS_PARAMS_CHROMA_ENHAN = 2,
+	CAMSS_PARAMS_COLOR_CORRECT = 3,
+	CAMSS_PARAMS_GAMMA = 4,
+	CAMSS_PARAMS_AEC_BHIST = 5,
+	CAMSS_IFE_PARAMS_GAMMA_64 = 9,
+};
+
+/* Gains U15Q10, offsets normalized U16. Titan170 currently accepts zero
+ * offsets only and rounds gains to U12Q7, rejecting conversion overflow.
+ * All padding must be zero. Channel order is G, B, R.
+ */
+struct camss_params_wb_gain {
+	struct v4l2_isp_block_header header;
+	__u16 g_gain, b_gain, r_gain;
+	__u16 g_sub, b_sub, r_sub;
+	__u16 g_add, b_add, r_add;
+	__u16 _pad[3];
+} __attribute__((aligned(8)));
+
+/* GBR matrix: output[i] = a[i]*G + b[i]*B + c[i]*R + k[i].
+ * Coefficients are signed 12-bit two's-complement fields, not sign-extended
+ * u16. Precision is Q(7 + qfactor), qfactor 0..3. Titan170 accepts zero k.
+ */
+struct camss_params_color_correct {
+	struct v4l2_isp_block_header header;
+	__u16 a[3], b[3], c[3], k[3];
+	__u16 qfactor;
+	__u16 _pad[3];
+} __attribute__((aligned(8)));
+
+#define CAMSS_IFE_GAMMA_64_SIZE 64
+/* Each word: unsigned 10-bit base, signed 10-bit delta in bits 19:10;
+ * upper bits zero. Base+delta is the next knot (0..1024); adjacent knots
+ * must agree. This is not the 256-entry OPE CAMSS_PARAMS_GAMMA layout.
+ */
+struct camss_ife_params_gamma_64 {
+	struct v4l2_isp_block_header header;
+	__u32 table_r[CAMSS_IFE_GAMMA_64_SIZE];
+	__u32 table_g[CAMSS_IFE_GAMMA_64_SIZE];
+	__u32 table_b[CAMSS_IFE_GAMMA_64_SIZE];
+} __attribute__((aligned(8)));
+
+/* Private experimental QCIP ID, not an upstream assignment. Values are in
+ * the BLS hardware domain; no RAW10 alignment/calibration is implied.
+ * Offset/thresholds are unsigned 14-bit, scale is unsigned 17-bit Q11
+ * (1..131071). Scale and subtraction are independent. Threshold order is
+ * R, B, Gr, Gb. All padding must be zero, including for DISABLE.
+ */
+#define CAMSS_PARAMS_BLS_EXPERIMENTAL 0x8002
+struct camss_params_bls {
+	struct v4l2_isp_block_header header;
+	__u16 offset;
+	__u16 _pad0;
+	__u32 scale_q11;
+	__u16 threshold[4];
+	__u32 _pad[2];
+} __attribute__((aligned(8)));
+
+/* Private Titan170 linearization 3.3 experiment. Single stripe, semantic
+ * R/Gr/Gb/B channel order. Eight nondecreasing 14-bit knees delimit nine
+ * segments. Bases are 14-bit; slopes are unsigned 26-bit Q11, NOT the Q12
+ * format of linearization 3.4. Segment continuity is a userspace policy.
+ * All fields are validated even for DISABLE. No sensor calibration implied.
+ */
+#define CAMSS_PARAMS_LINEARIZATION_EXPERIMENTAL 0x8003
+struct camss_params_linearization {
+	struct v4l2_isp_block_header header;
+	__u16 knee[4][8];
+	__u16 base[4][9];
+	__u32 slope_q11[4][9];
+} __attribute__((aligned(8)));
+
+/* Private Titan170 LSC34 experiment. Single stripe, 17x13 row-major nodes
+ * per semantic R/Gr/Gb/B channel, unsigned Q10 gains in [1024,8191].
+ * Geometry is in Bayer quads (half the pixel dimensions). Each mesh cell
+ * has 2^interpolation_factor subgrids per axis. Offsets locate the first
+ * image quad within the first mesh cell. Subgrids must be >=9 quads;
+ * cell width/height must fit 11/10 bits plus one. The mesh must cover the
+ * entire active input. No crop projection or calibration is implied.
+ * All fields, including zero padding, are checked even for DISABLE.
+ */
+#define CAMSS_PARAMS_LSC_EXPERIMENTAL 0x8004
+#define CAMSS_LSC_NODES 221
+struct camss_params_lsc {
+	struct v4l2_isp_block_header header;
+	__u16 subgrid_width, subgrid_height;
+	__u16 offset_x, offset_y;
+	__u8 interpolation_factor;
+	__u8 _pad[7];
+	__u16 gain[4][CAMSS_LSC_NODES];
+} __attribute__((aligned(8)));
+
+/* Private Titan170 stock IQ replay experiment. Raw IFE register writes and
+ * DMI LUT uploads, accepted only inside the driver's IQ allowlist: module
+ * enables (IQ bits only), linearization, demux, BPC/BCC, ABF, BLS, LSC,
+ * demosaic/WB, CCM, GTM, gamma, CST and the BHIST/AWB-BG statistics config.
+ * Bus, IRQ, CAMIF, clock, scaler and output registers are never accepted.
+ * The block holds num_regs struct camss_iq_reg, then num_luts LUTs, each a
+ * struct camss_iq_lut immediately followed by its 32-bit words, then zero
+ * padding to 8 bytes. A LUT is named by its bank-0 DMI RAM select and a
+ * bank; DMI64 entries are low word first. A LUT and its bank-select
+ * register must appear together, with matching banks. Live updates must
+ * name the bank not currently in use. Only ENABLE is accepted, and no other
+ * block may share the buffer.
+ */
+#define CAMSS_PARAMS_IQ_REPLAY_EXPERIMENTAL 0x8005
+#define CAMSS_IQ_REPLAY_MAX_REGS 192
+#define CAMSS_IQ_REPLAY_LUT_WORDS 898 /* every LUT once */
+#define CAMSS_IQ_REPLAY_MAX_LUTS 8
+struct camss_iq_reg {
+	__u32 offset;
+	__u32 value;
+};
+
+struct camss_iq_lut {
+	__u8 sel;
+	__u8 bank;
+	__u16 words;
+};
+
+struct camss_params_iq_replay {
+	struct v4l2_isp_block_header header;
+	__u16 num_regs;
+	__u16 num_luts;
+	__u32 _pad;
+	__u32 data[];
+} __attribute__((aligned(8)));
+
+/* Private Titan170 demux13 experiment. Single stripe; semantic R/Gr/Gb/B
+ * unsigned 15-bit Q10 gains, mirrored to both hardware planes. Black input
+ * and output offsets are the same unsigned 12-bit value. Bayer period is 1;
+ * CFA selection remains owned by the negotiated sensor format. ENABLE only:
+ * demux is required by the Bayer pipeline. All padding must be zero.
+ */
+#define CAMSS_PARAMS_DEMUX_EXPERIMENTAL 0x8006
+struct camss_params_demux {
+	struct v4l2_isp_block_header header;
+	__u16 gain_q10[4];
+	__u16 black_offset;
+	__u16 _pad[3];
+} __attribute__((aligned(8)));
+
+/* Private Titan170 BPCBCC50, ENABLE only. Ratios are unsigned Q12 in
+ * R/G, B/G, G/R, G/B order (128..131071). No statistics-counter writes.
+ * black_level: 0..4095; offsets: 0..16383; threshold: 0..8191;
+ * fmax: 64..127, fmin: 0..64; three boolean controls: 0 or 1.
+ * All padding must be zero. */
+#define CAMSS_PARAMS_BPC_EXPERIMENTAL 0x8007
+struct camss_params_bpc {
+	struct v4l2_isp_block_header header;
+	__u32 ratio_q12[4];
+	__u16 black_level;
+	__u16 bpc_offset;
+	__u16 bcc_offset;
+	__u16 threshold;
+	__u8 hot_disabled;
+	__u8 cold_disabled;
+	__u8 same_channel;
+	__u8 fmax;
+	__u8 fmin;
+	__u8 _pad[3];
+} __attribute__((aligned(8)));
+
+/* Private Titan170 ABF34, ENABLE only. Hardware bank selection belongs to
+ * the driver. Noise table entries are unsigned 9-bit base/absolute delta.
+ * Radial channels: coefficient, threshold; noise channels: Gr/Gb, R/B.
+ * Curves: Gr/Gb/R/B. Pixel match and distance: Gr/Gb, R/B.
+ * All fields are bounded by the original A52q hardware calculation;
+ * padding must be zero. This block writes 0x5e8 and 0x5f4..0x648 only.
+ */
+#define CAMSS_PARAMS_ABF_EXPERIMENTAL 0x8008
+struct camss_params_abf {
+	struct v4l2_isp_block_header header;
+	__u16 noise_base[64];
+	__u16 noise_delta[64];
+	__u32 r_square_init;
+	__u16 radial_anchor[4];
+	__s16 bx, by;
+	__u16 black_level, bpc_offset;
+	__u16 noise_anchor, noise_gap;
+	__u16 noise_lo[2];
+	__s16 noise_slope[2];
+	__u8 radial_base[2][4];
+	__u8 radial_slope[2][4];
+	__u8 radial_shift[2][4];
+	__u8 curve_offset[4];
+	__u8 noise_shift[2];
+	__u8 r_square_shift;
+	__u8 pixel_match[2];
+	__u8 distance[2][3];
+	__u8 fmax, fmin, max_shift, min_shift;
+	__u8 cross_plane, single_bpc;
+	__u8 _pad[3];
+} __attribute__((aligned(8)));
+
+/* Private Titan170 GTM10. Semantic 18-bit bases and signed 26-bit slopes.
+ * The driver owns the bank bit at 0x794 and the GTM color-enable bit.
+ * No userspace MMIO offset, DMI selector or bank is accepted.
+ */
+#define CAMSS_PARAMS_GTM_EXPERIMENTAL 0x8009
+struct camss_params_gtm {
+	struct v4l2_isp_block_header header;
+	__u32 base[64];
+	__s32 slope[64];
+} __attribute__((aligned(8)));
+
+/* Private experimental QCIS block, NOT an upstream-assigned statistics ID.
+ * Keep separate from proposal IDs until the shared BG extension is settled.
+ * Native-endian fields, row-major cells, semantic R/B/Gr/Gb channel order.
+ */
+#define CAMSS_STATS_AWB_BG_EXPERIMENTAL 0x8001
+#define CAMSS_STATS_HDR_BE_EXPERIMENTAL 0x8002
+#define CAMSS_STATS_HDR_BHIST_EXPERIMENTAL 0x8003
+/* Fixed 4624x3468 profile: STATS_CFG=0xf48, nonuniform Y BHIST.
+ * Same 1024-bin layout as BHIST, deliberately a different block ID.
+ */
+#define CAMSS_STATS_STOCK_BHIST_EXPERIMENTAL 0x8004
+/* Tintless BG (titan170_tlbg): camss_stats_awb_bg layout, 32x24 regions of
+ * 144x144 at (0,0), thresholds 0x3fff. Stock taps it before white balance.
+ */
+#define CAMSS_STATS_TL_BG_EXPERIMENTAL 0x8005
+#define CAMSS_AWB_BG_SCALE_UNVERIFIED 1
+
+/* Compatible field layout with the October 7 IFE region proposal. Saturated
+ * fields are zero when saturation statistics are disabled (initial mode).
+ */
+struct camss_ife_bg_region_stats {
+	__u32 r_sum, b_sum, gr_sum, gb_sum;
+	__u16 r_cnt, b_cnt, gr_cnt, gb_cnt;
+	__u32 sat_r_sum, sat_b_sum, sat_gr_sum, sat_gb_sum;
+	__u16 sat_r_cnt, sat_b_cnt, sat_gr_cnt, sat_gb_cnt;
+};
+
+struct camss_stats_awb_bg {
+	struct v4l2_isp_block_header header;
+	__u32 config_flags; /* CAMSS_AWB_BG_SCALE_UNVERIFIED; no Y/saturation mode */
+	__u32 mbus_code;
+	__u16 left, top, columns, rows, region_width, region_height;
+	__u16 low[4], high[4]; /* R, B, Gr, Gb in the hardware threshold domain */
+	__u16 sample_pattern;
+	__u8 shift;
+	__u8 sample_bits; /* 14 in measured GRBG10 mode; zero when SCALE_UNVERIFIED */
+	struct camss_ife_bg_region_stats regions[];
+} __attribute__((aligned(8)));
+
+/* HDR-BE uses camss_stats_awb_bg's layout with its own type and thresholds.
+ * HDR-BHIST bins are interleaved R/G/B, 256 bins per channel, 25-bit counts.
+ * The green channel and field selection are recorded in stats_cfg.
+ */
+struct camss_stats_hdr_bhist {
+	struct v4l2_isp_block_header header;
+	__u32 stats_cfg;
+	__u32 mbus_code;
+	__u16 left, top, width, height;
+	__u32 bins[256][3];
+} __attribute__((aligned(8)));
+
+#endif
