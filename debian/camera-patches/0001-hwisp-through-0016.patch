+static void params_test_iq_replay_exclusive(struct kunit *test)
+{
+	struct params_test *t = test->priv;
+	struct params_test_iq *in = kunit_kzalloc(test, sizeof(*in) + 32, GFP_KERNEL);
+	const u32 regs[][2] = { { 0x6b0, 0x041e81dd } };
+	struct camss_params_wb_gain *wb;
+	size_t size;
+
+	KUNIT_ASSERT_NOT_NULL(test, in);
+	size = params_test_iq_build(in, regs, 1, 0, 0);
+	KUNIT_ASSERT_EQ(test, vfe_params_parse(&t->result, in, size), 0);
+	wb = (void *)((u8 *)in + size);
+	*wb = t->input.wb;
+	in->size += sizeof(*wb);
+	KUNIT_EXPECT_EQ(test, vfe_params_parse(&t->result, in, size + sizeof(*wb)), -EINVAL);
+}
+
+static void params_test_iq_replay_banks(struct kunit *test)
+{
+	struct params_test *t = test->priv;
+	struct vfe_line *line = params_test_line(t);
+	struct params_test_iq *in = kunit_kzalloc(test, sizeof(*in), GFP_KERNEL);
+	const u32 regs[][2] = { { 0x798, 7 } };
+	const u32 regs0[][2] = { { 0x798, 0 } };
+	size_t size;
+
+	KUNIT_ASSERT_NOT_NULL(test, in);
+	size = params_test_iq_build(in, regs, 1, PARAMS_TEST_GAMMA_LUTS, 1);
+	KUNIT_ASSERT_EQ(test, vfe_params_parse(&t->buf.config, in, size), 0);
+	/* Startup: the replay's own bank becomes the active one. */
+	list_add_tail(&t->buf.list, &line->params.pending);
+	line->params.streaming = true;
+	KUNIT_ASSERT_EQ(test, vfe_params_take(line, &t->result), 0);
+	KUNIT_EXPECT_EQ(test, line->params.active_bank, BIT(VFE_BANK_GAMMA));
+	vfe_params_complete(line, 0, 0, 10);
+	KUNIT_EXPECT_EQ(test, t->returned, 1);
+	/* Live: naming the in-use bank is refused without an upload. */
+	vfe170_params_live = true;
+	line->output.state = VFE_OUTPUT_ON;
+	line->output.pix.sof_sequence = 3;
+	list_add_tail(&t->buf.list, &line->params.pending);
+	params_upload_work(&line->params.upload_work);
+	KUNIT_EXPECT_EQ(test, t->uploads, 0);
+	KUNIT_EXPECT_EQ(test, t->returned, 2);
+	KUNIT_EXPECT_EQ(test, t->state, VB2_BUF_STATE_ERROR);
+	KUNIT_EXPECT_EQ(test, line->params.phase, VFE_PARAMS_IDLE);
+	KUNIT_EXPECT_TRUE(test, list_empty(&line->params.pending));
+	/* The other bank is accepted, uploaded and becomes active on RUP. */
+	size = params_test_iq_build(in, regs0, 1, PARAMS_TEST_GAMMA_LUTS, 0);
+	KUNIT_ASSERT_EQ(test, vfe_params_parse(&t->buf.config, in, size), 0);
+	list_add_tail(&t->buf.list, &line->params.pending);
+	params_upload_work(&line->params.upload_work);
+	KUNIT_EXPECT_EQ(test, t->uploads, 1);
+	KUNIT_EXPECT_EQ(test, t->uploaded_bank, 0);
+	KUNIT_ASSERT_EQ(test, line->params.phase, VFE_PARAMS_READY);
+	vfe_params_irq(line, 0, 0, 100, VFE_PARAMS_IRQ_END);
+	vfe_params_irq(line, 0, 3, 200, VFE_PARAMS_IRQ_SOF | VFE_PARAMS_IRQ_RUP);
+	KUNIT_EXPECT_EQ(test, line->params.active_bank, 0);
+	KUNIT_EXPECT_EQ(test, t->returned, 3);
+	KUNIT_EXPECT_EQ(test, t->state, VB2_BUF_STATE_DONE);
+	KUNIT_EXPECT_EQ(test, line->params.active.iq.reg[0][1], 0u);
+}
+
+static void params_test_abf_replay_to_typed_banks(struct kunit *test)
+{
+	struct params_test *t = test->priv;
+	struct vfe_line *line = params_test_line(t);
+	struct params_test_iq *in = kunit_kzalloc(test, sizeof(*in), GFP_KERNEL);
+	const u32 regs[][2] = { { 0x5e8, 0x06363007 } };
+	const u32 masks[] = { VFE_PARAMS_ABF | BIT(CAMSS_PARAMS_WB_GAIN),
+		BIT(CAMSS_PARAMS_WB_GAIN), VFE_PARAMS_ABF };
+	const u8 banks[] = { 0, 0, BIT(VFE_BANK_ABF) };
+	unsigned int i;
+	size_t size;
+
+	KUNIT_ASSERT_NOT_NULL(test, in);
+	size = params_test_iq_build(in, regs, 1, BIT(1), 1);
+	KUNIT_ASSERT_EQ(test, vfe_params_parse(&t->buf.config, in, size), 0);
+	list_add_tail(&t->buf.list, &line->params.pending);
+	line->params.streaming = true;
+	KUNIT_ASSERT_EQ(test, vfe_params_take(line, &t->result), 0);
+	KUNIT_EXPECT_EQ(test, line->params.active_bank, BIT(VFE_BANK_ABF));
+	vfe_params_complete(line, 0, 0, 10);
+	vfe170_params_live = true;
+	line->output.state = VFE_OUTPUT_ON;
+	for (i = 0; i < ARRAY_SIZE(masks); i++) {
+		line->output.pix.sof_sequence = 3 + i;
+		t->buf.config.mask = masks[i];
+		t->buf.config.abf[0] = 5;
+		t->buf.config.abf_lut[63] = 511;
+		list_add_tail(&t->buf.list, &line->params.pending);
+		params_upload_work(&line->params.upload_work);
+		KUNIT_ASSERT_EQ(test, line->params.phase, VFE_PARAMS_READY);
+		KUNIT_EXPECT_EQ(test, line->params.staged_bank, banks[i]);
+		KUNIT_EXPECT_EQ(test, t->uploads, i < 2 ? 1 : 2);
+		vfe_params_irq(line, 0, 0, 100 + 200*i, VFE_PARAMS_IRQ_END);
+		vfe_params_irq(line, 0, 3+i, 200 + 200*i, VFE_PARAMS_IRQ_SOF | VFE_PARAMS_IRQ_RUP);
+		KUNIT_EXPECT_EQ(test, line->params.active_bank, banks[i]);
+		KUNIT_EXPECT_EQ(test, line->params.active.abf_lut[63], 511u);
+	}
+	KUNIT_EXPECT_EQ(test, t->returned, 4);
+}
+
+static void params_test_gtm_fields(struct kunit *test)
+{
+	struct params_test *t = test->priv;
+	struct {
+		u32 version, size;
+		struct camss_params_gtm gtm;
+	} *in = kunit_kzalloc(test, sizeof(*in), GFP_KERNEL);
+	unsigned int i;
+
+	KUNIT_ASSERT_NOT_NULL(test, in);
+	in->version = V4L2_ISP_VERSION_V1;
+	in->size = sizeof(in->gtm);
+	in->gtm.header.type = CAMSS_PARAMS_GTM_EXPERIMENTAL;
+	in->gtm.header.size = sizeof(in->gtm);
+	in->gtm.header.flags = V4L2_ISP_PARAMS_FL_BLOCK_ENABLE;
+	KUNIT_EXPECT_EQ(test, sizeof(in->gtm), (size_t)520);
+	for (i = 0; i < 64; i++) {
+		in->gtm.base[i] = i == 63 ? 262143 : i;
+		in->gtm.slope[i] = i & 1 ? 33554431 : -33554432;
+	}
+	KUNIT_ASSERT_EQ(test, vfe_params_parse(&t->result, in, sizeof(*in)), 0);
+	KUNIT_EXPECT_EQ(test, t->result.mask, VFE_PARAMS_GTM);
+	KUNIT_EXPECT_TRUE(test, t->result.gtm_enabled);
+	KUNIT_EXPECT_EQ(test, t->result.gtm[126], 262143u);
+	KUNIT_EXPECT_EQ(test, t->result.gtm[1], 0x2000000u);
+	KUNIT_EXPECT_EQ(test, t->result.gtm[127], 0x1ffffffu);
+	in->gtm.base[63]++;
+	KUNIT_EXPECT_EQ(test, vfe_params_parse(&t->result, in, sizeof(*in)), -ERANGE);
+	in->gtm.base[63]--;
+	in->gtm.slope[63]++;
+	KUNIT_EXPECT_EQ(test, vfe_params_parse(&t->result, in, sizeof(*in)), -ERANGE);
+	in->gtm.slope[63]--;
+	in->gtm.slope[0]--;
+	KUNIT_EXPECT_EQ(test, vfe_params_parse(&t->result, in, sizeof(*in)), -ERANGE);
+	in->gtm.slope[0]++;
+	in->gtm.header.flags = V4L2_ISP_PARAMS_FL_BLOCK_DISABLE;
+	KUNIT_ASSERT_EQ(test, vfe_params_parse(&t->result, in, sizeof(*in)), 0);
+	KUNIT_EXPECT_FALSE(test, t->result.gtm_enabled);
+}
+
+static void params_test_gtm_replay_to_typed_banks(struct kunit *test)
+{
+	struct params_test *t = test->priv;
