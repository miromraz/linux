+/*
+ * Single-IFE stock preview geometry: 4624x3468 MN-downscaled to 1440x1080
+ * reproduces the stock scaler words except the dual-IFE stripe fields, and
+ * replay registers land after every driver default, on startup and commit.
+ */
+static void pix_test_stock_scaler_and_replay(struct kunit *test)
+{
+	struct pix_test *t = test->priv;
+	struct vfe_device *vfe = &t->vfe;
+	struct vfe_line *line = pix_line(t);
+	struct vfe_pix_params *config = kunit_kzalloc(test, sizeof(*config), GFP_KERNEL);
+	static const u32 stock[][2] = {
+		{ 0xa3c, 3 }, { 0xa40, 0x059f120f }, { 0xa44, 0x30066c16 },
+		{ 0xa54, 0x04370d8b }, { 0xa58, 0x30066c16 }, { 0xa64, 0xd8b },
+		{ 0xa68, 3 }, { 0xa6c, 0x02cf120f }, { 0xa70, 0x20066c16 },
+		{ 0xa80, 0x021b0d8b }, { 0xa84, 0x20066c16 }, { 0xa90, 0xd8b },
+		{ 0xe0c, 0xe00 }, { 0xe10, 0x437 }, { 0xe1c, 0x16 },
+		{ 0xe2c, 0xe00 }, { 0xe30, 0x21b }, { 0xe3c, 0x17 },
+	};
+	unsigned int i;
+
+	KUNIT_ASSERT_NOT_NULL(test, config);
+	vfe_params_defaults(config);
+	vfe_pix_config(vfe, &vfe_pix_bayer[0], 4624, 3468, 1440, 1080, config);
+	for (i = 0; i < ARRAY_SIZE(stock); i++)
+		KUNIT_EXPECT_EQ_MSG(test, readl(vfe->base + stock[i][0]), stock[i][1],
+				    "offset 0x%x", stock[i][0]);
+	/* Single stripe: the whole 4624 input, no stripe offsets. */
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + 0xa50), 0x120fu);
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + 0xa48), 0u);
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + 0xe14), 0x59fu);
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + 0xe34), 0x59fu);
+
+	config->mask = VFE_PARAMS_IQ;
+	config->iq.nregs = 3;
+	config->iq.reg[0][0] = 0x040;
+	config->iq.reg[0][1] = 0xdc6;
+	config->iq.reg[1][0] = 0xf44;
+	config->iq.reg[1][1] = 0x1f54;
+	config->iq.reg[2][0] = 0x798;
+	config->iq.reg[2][1] = 7;
+	config->iq.luts = BIT(5);
+	config->iq.classes = config->iq.banks = BIT(VFE_BANK_GAMMA);
+	config->iq.lut[706 + 63] = 0x5a5a5;
+	vfe_pix_iq_upload(vfe, &config->iq);
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + VFE_DMI_DATA_LO), 0x5a5a5u);
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + VFE_DMI_CFG), 0u);
+	line->output.pix.sof_sequence = 1;
+	writel(1, vfe->base + VFE_DIAG_SENSOR_FRM_CNT_STATUS);
+	KUNIT_ASSERT_EQ(test, vfe170_params_commit(line, config, 1), 0);
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + 0x40), 0xdc6u);
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + 0xf44), 0x1f54u);
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + 0x798), 7u);
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + VFE_REG_UPDATE_CMD), BIT(0));
+}
