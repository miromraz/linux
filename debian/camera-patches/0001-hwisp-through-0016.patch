+static void pix_test_stock_stats_serialization(struct kunit *test)
+{
+	static const struct vb2_mem_ops memops = { .vaddr = bhist_test_vaddr };
+	struct pix_test *t = test->priv;
+	struct vb2_queue queue = { .mem_ops = &memops };
+	struct camss_buffer buf = {};
+	struct vfe_pix_frame frame = {};
+	struct vfe_pix_ring ring = { .line = pix_line(t) };
+	struct vfe_bhist_buffer *dst;
+	struct camss_stats_awb_bg *bg, *be;
+	struct camss_stats_hdr_bhist *hist;
+	u8 *src;
+	unsigned int i;
+
+	pix_stock_stats_mode(t);
+	dst = kunit_kmalloc(test, vfe_stats_payload_size(), GFP_KERNEL);
+	src = kunit_kzalloc(test, vfe_stats_dma_size(), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, dst);
+	KUNIT_ASSERT_NOT_NULL(test, src);
+	memset(dst, 0xa5, vfe_stats_payload_size());
+	for (i = 0; i < VFE_BG_REGIONS; i++) {
+		put_unaligned_le32(i, src + 4096 + i * 24);
+		put_unaligned_le32(i + 65536, src + VFE_HDR_BE_OFFSET + i * 24);
+		put_unaligned_le16(1296, src + VFE_HDR_BE_OFFSET + i * 24 + 16);
+	}
+	for (i = 0; i < 768; i++)
+		put_unaligned_le32(0xfe000000u | i, src + VFE_HDR_BHIST_OFFSET + i * 4);
+	frame.cpu = src;
+	pix_line(t)->stats.bg_mbus_code = MEDIA_BUS_FMT_SGRBG10_1X10;
+	buf.vb.vb2_buf.vb2_queue = &queue;
+	buf.vb.vb2_buf.num_planes = 1;
+	buf.vb.vb2_buf.planes[0].mem_priv = dst;
+	buf.vb.vb2_buf.planes[0].length = vfe_stats_payload_size();
+	KUNIT_ASSERT_EQ(test, vfe_bhist_copy(NULL, &ring, &frame, &buf), 0);
+	KUNIT_EXPECT_EQ(test, vfe_stats_payload_size(), (size_t)302216);
+	KUNIT_EXPECT_EQ(test, dst->header.type, 0x8004);
+	KUNIT_EXPECT_EQ(test, dst->data_size, 302208);
+	bg = (void *)(dst + 1);
+	be = (void *)bg + VFE_BG_BLOCK_SIZE;
+	hist = (void *)be + VFE_BG_BLOCK_SIZE;
+	KUNIT_EXPECT_EQ(test, bg->header.type, 0x8001);
+	KUNIT_EXPECT_EQ(test, bg->config_flags, CAMSS_AWB_BG_SCALE_UNVERIFIED);
+	KUNIT_EXPECT_EQ(test, bg->sample_bits, 0);
+	KUNIT_EXPECT_EQ(test, bg->region_width, 72);
+	KUNIT_EXPECT_EQ(test, bg->left, 0);
+	KUNIT_EXPECT_EQ(test, bg->high[0], 15423);
+	KUNIT_EXPECT_EQ(test, be->header.type, 0x8002);
+	KUNIT_EXPECT_EQ(test, be->high[0], 16285);
+	KUNIT_EXPECT_EQ(test, hist->header.size, 3096);
+	KUNIT_EXPECT_EQ(test, hist->header.type, 0x8003);
+	KUNIT_EXPECT_EQ(test, hist->stats_cfg, 0xf48);
+	KUNIT_EXPECT_EQ(test, hist->width, 4624);
+	for (i = 0; i < VFE_BG_REGIONS; i++) {
+		KUNIT_EXPECT_EQ(test, bg->regions[i].r_sum, i);
+		KUNIT_EXPECT_EQ(test, be->regions[i].r_sum, i + 65536);
+		KUNIT_EXPECT_EQ(test, be->regions[i].r_cnt, 1296);
+		KUNIT_EXPECT_EQ(test, be->regions[i].sat_r_sum, 0);
+	}
+	for (i = 0; i < 256; i++) {
+		KUNIT_EXPECT_EQ(test, hist->bins[i][0], i * 3);
+		KUNIT_EXPECT_EQ(test, hist->bins[i][1], i * 3 + 1);
+		KUNIT_EXPECT_EQ(test, hist->bins[i][2], i * 3 + 2);
+	}
+	buf.vb.vb2_buf.planes[0].length--;
+	KUNIT_EXPECT_EQ(test, vfe_bhist_copy(NULL, &ring, &frame, &buf), -EINVAL);
+}
