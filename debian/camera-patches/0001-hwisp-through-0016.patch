+struct params_test_iq {
+	u32 version, size;
+	struct camss_params_iq_replay h;
+	u32 data[CAMSS_IQ_REPLAY_MAX_REGS * 2 + CAMSS_IQ_REPLAY_MAX_LUTS +
+		 CAMSS_IQ_REPLAY_LUT_WORDS];
+};
+
+/* Registers, then the LUTs in @luts (vfe_iq_luts indices) at @bank. */
+static size_t params_test_iq_build(struct params_test_iq *in, const u32 (*regs)[2],
+				   unsigned int nregs, u8 luts, u8 bank)
+{
+	u32 *w = in->data;
+	unsigned int i, j, n = 0;
+	size_t block;
+
+	memset(in, 0, sizeof(*in));
+	for (i = 0; i < nregs; i++) {
+		*w++ = regs[i][0];
+		*w++ = regs[i][1];
+	}
+	for (i = 0; i < VFE_IQ_LUTS; i++) {
+		struct camss_iq_lut h = { vfe_iq_luts[i].sel, bank, vfe_iq_luts[i].words };
+
+		if (!(luts & BIT(i)))
+			continue;
+		memcpy(w++, &h, sizeof(h));
+		for (j = 0; j < h.words; j++)
+			*w++ = i << 16 | j;
+		n++;
+	}
+	block = ALIGN((u8 *)w - (u8 *)&in->h, 8);
+	in->h.header = (struct v4l2_isp_block_header) {
+		.type = CAMSS_PARAMS_IQ_REPLAY_EXPERIMENTAL, .flags = 2, .size = block,
+	};
+	in->h.num_regs = nregs;
+	in->h.num_luts = n;
+	in->version = 1;
+	in->size = block;
+	return 8 + block;
+}
