+	KUNIT_ASSERT_EQ(test, vfe_params_take(line, &t->result), 0);
+	KUNIT_EXPECT_EQ(test, line->params.active_bank, BIT(VFE_BANK_GTM));
+	vfe_params_complete(line, 0, 0, 10);
