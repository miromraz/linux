+static void pix_test_bls_registers(struct kunit *test)
+{
+	struct pix_test *t = test->priv;
+	struct vfe_device *vfe = &t->vfe;
+	struct vfe_line *line = &vfe->line[VFE_LINE_PIX];
+	struct vfe_pix_params *config = kunit_kzalloc(test, sizeof(*config), GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, config);
+
+	vfe_params_defaults(config);
+	vfe_pix_config(vfe, &vfe_pix_bayer[0], PIX_TEST_W, PIX_TEST_H,
+		       PIX_TEST_W, PIX_TEST_H, config);
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + 0x40), BIT(2) | BIT(10));
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + 0x6b0), 0x04000000u);
+	config->mask = VFE_PARAMS_BLS;
+	config->bls_enabled = true;
+	config->bls[0] = 0x80000400;
+	config->bls[1] = 0x002c0021;
+	config->bls[2] = 0x0016000b;
+	vfe_pix_config(vfe, &vfe_pix_bayer[0], PIX_TEST_W, PIX_TEST_H,
+		       PIX_TEST_W, PIX_TEST_H, config);
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + 0x40), BIT(2) | BIT(10) | BIT(11));
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + 0x6b0), 0x80000400u);
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + 0x6b4), 0x002c0021u);
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + 0x6b8), 0x0016000bu);
+	line->output.pix.sof_sequence = 1;
+	writel(1, vfe->base + VFE_DIAG_SENSOR_FRM_CNT_STATUS);
+	/* A sibling lens-enable bit must survive a BLS-only live disable. */
+	writel(BIT(2) | BIT(8) | BIT(10) | BIT(11), vfe->base + 0x40);
+	config->bls_enabled = false;
+	KUNIT_ASSERT_EQ(test, vfe170_params_commit(line, config, 0), 0);
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + 0x40), BIT(2) | BIT(8) | BIT(10));
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + VFE_REG_UPDATE_CMD), BIT(0));
+	config->bls_enabled = true;
+	KUNIT_ASSERT_EQ(test, vfe170_params_commit(line, config, 0), 0);
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + 0x40), BIT(2) | BIT(8) | BIT(10) | BIT(11));
+	/* A counter beyond the next frame must reject the update before BLS. */
+	writel(3, vfe->base + VFE_DIAG_SENSOR_FRM_CNT_STATUS);
+	config->bls[0] = 0;
+	KUNIT_EXPECT_EQ(test, vfe170_params_commit(line, config, 0), -EIO);
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + 0x6b0), 0x80000400u);
+	/* The next frame already counted: committed, reported late. */
+	writel(2, vfe->base + VFE_DIAG_SENSOR_FRM_CNT_STATUS);
+	KUNIT_EXPECT_EQ(test, vfe170_params_commit(line, config, 0), 1);
+	KUNIT_EXPECT_EQ(test, readl(vfe->base + 0x6b0), 0u);
+	/* Late window: just after SOF 1, frame 1 in flight, nothing retired. */
+	line->output.pix.sof_sequence = 2;
+	line->output.pix.tok = (struct vfe_pix_token) { .sequence = 1, .valid = true };
+	line->output.pix.pending_rings = BIT(VFE_PIX_RING_IMAGE);
+	KUNIT_EXPECT_EQ(test, vfe170_params_commit(line, config, 0), 0);
+	line->output.pix.tok.sequence = 0;	/* an older frame: not the window */
+	KUNIT_EXPECT_EQ(test, vfe170_params_commit(line, config, 0), -EIO);
+	line->output.pix.tok.valid = false;
+	line->output.pix.pending_rings = 0;
+}
