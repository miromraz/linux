+	const u32 regs[][2] = { { 0x794, 1 } };
+	const u32 masks[] = { VFE_PARAMS_GTM | BIT(CAMSS_PARAMS_WB_GAIN),
+		BIT(CAMSS_PARAMS_WB_GAIN), VFE_PARAMS_GTM };
