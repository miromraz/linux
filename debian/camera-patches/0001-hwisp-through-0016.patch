+/* Replay observed top errors through the real ISR, including an error+SOF.
+ * No frame may be labelled successful; mappings survive until reset.
+ */
+static void pix_test_top_error_stops_clients(struct kunit *test)
+{
+	struct pix_test *t = test->priv;
+	static const u32 errors[][2] = { { 0, 0x1800 }, { BIT(16), 0 },
+		{ 0, BIT(23) } };
+	unsigned int n, wm, returned, freed, faults, syncs;
+
+	t->ack_reset = true;
+	vfe170_bhist = true;
+	for (n = 0; n < ARRAY_SIZE(errors); n++) {
+		pix_queue(t, 0);
+		KUNIT_ASSERT_EQ(test, pix_start(t, pix_line(t)), 0);
+		returned = t->nreturned;
+		freed = t->frees;
+		faults = t->faults;
+		syncs = t->nsyncs;
+		/* Unexpected enabled RDI client must also be stopped under PIX
+		 * exclusivity. Never release its possible mappings here.
+		 */
+		writel(1, t->vfe.base + VFE_BUS_WM_CFG(0));
+		writel(errors[n][0] | STATUS_0_CAMIF_SOF,
+		       t->vfe.base + VFE_IRQ_STATUS_0);
+		writel(errors[n][1], t->vfe.base + VFE_IRQ_STATUS_1);
+		vfe_isr(0, &t->vfe);
+		KUNIT_EXPECT_TRUE(test, pix_st(t)->faulted);
+		KUNIT_EXPECT_EQ(test, t->faults, faults + 1);
+		KUNIT_EXPECT_EQ(test, t->nsyncs, syncs);
+		KUNIT_EXPECT_EQ(test, pix_st(t)->sof_sequence, 0);
+		KUNIT_EXPECT_EQ(test, t->nreturned, returned);
+		KUNIT_EXPECT_EQ(test, t->frees, freed);
+		for (wm = 0; wm < VFE170_NUM_BUS_CLIENTS; wm++)
+			KUNIT_EXPECT_EQ(test, pix_reg(t, VFE_BUS_WM_CFG(wm)), 0);
+		KUNIT_EXPECT_EQ(test, pix_reg(t, VFE_IRQ_MASK_0), (u32)MASK_0_RESET_ACK);
+		KUNIT_EXPECT_EQ(test, pix_reg(t, VFE_IRQ_MASK_1), 0);
+		for (wm = 0; wm < VFE_BUS_IRQ_BANKS; wm++)
+			KUNIT_EXPECT_EQ(test, pix_reg(t, VFE_BUS_IRQ_MASK(wm)), 0);
+		vfe_isr(0, &t->vfe);
+		KUNIT_EXPECT_EQ(test, t->faults, faults + 1);
+		KUNIT_ASSERT_EQ(test, pix_stop(t, pix_line(t)), 0);
+		KUNIT_EXPECT_EQ(test, t->frees, t->allocs);
+		writel(0, t->vfe.base + VFE_IRQ_STATUS_0);
+		writel(0, t->vfe.base + VFE_IRQ_STATUS_1);
+	}
+}
