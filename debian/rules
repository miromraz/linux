#!/usr/bin/make -f

MK = $(MAKE) ARCH=arm64 -j$(shell nproc)
# NOTE: dt_binding_check wants DT_SCHEMA_FILES COLON-separated (the bindings
# Makefile does $(subst :," -e ",...) into grep -F). Partial paths are fine.
DT_YAMLS = clock/mediatek,infracfg.yaml:clock/mediatek,mt6797-mcumixed.yaml:regulator/mediatek,mt6797-cpu-sram.yaml

%:
	dh $@

override_dh_auto_configure:
	$(MK) defconfig
	$(MK) olddefconfig

override_dh_auto_build:
	@echo "===== dt_binding_check ====="
	-$(MK) dt_binding_check DT_SCHEMA_FILES="$(DT_YAMLS)" 2>&1 | tee dtbind.log
	@echo "===== CHECK_DTBS mt6797-gemini-pda.dtb ====="
	-$(MK) CHECK_DTBS=y mediatek/mt6797-gemini-pda.dtb 2>&1 | tee dtbs.log
	@echo "===== NEW-WARNING GATE ====="
	@# Match DT schema/dtc/yamllint diagnostics, then drop the pre-existing
	@# display-node warnings (disp-ovl / ovl-2l / disp-rdma 'resets',
	@# mt6779-pinctrl) that are identical in the v6 baseline build and are
	@# NOT touched by this cpufreq series. Any remaining diagnostic fails.
	@cat dtbind.log dtbs.log 2>/dev/null | \
	  grep -nEi "does not match|is not valid|from schema \$$id|failed to match|was expecting|not of type|is not one of|additional (propert|items)|undocumented compatible|\[(warning|error)\]|Warning \(" | \
	  grep -vEi "ovl|rdma|pinctrl|yamllint.* not installed" | \
	  tee new-warnings.txt ; \
	  if [ -s new-warnings.txt ]; then \
	    echo "DTCHECK FAIL: new DT warning(s) above"; exit 1; \
	  else echo "DTCHECK CLEAN: no new DT warnings for this series"; fi

override_dh_auto_test:

override_dh_auto_install:

override_dh_auto_clean:
