#!/usr/bin/make -f
MK = $(MAKE) ARCH=arm64 -j$(shell nproc)
DT_YAMLS = clock/mediatek,infracfg.yaml:regulator/mediatek,mt6797-cpu-sram.yaml
%:
	dh $@
override_dh_auto_configure:
	$(MK) defconfig
	$(MK) olddefconfig
override_dh_auto_build:
	@echo "===== dt_binding_check (DT_SCHEMA_FILES=$(DT_YAMLS)) ====="
	-$(MK) dt_binding_check DT_SCHEMA_FILES="$(DT_YAMLS)" 2>&1 | tee dtbind.log
	@echo "===== GATE (this series' bindings must be warning-free) ====="
	@grep -nEi "does not match|is not valid|from schema \$$id|failed to match|was expecting|not of type|is not one of|additional (propert|items)|undocumented|\[(warning|error)\]|Warning \(|yamllint: error" dtbind.log | tee new-warnings.txt ; \
	  if [ -s new-warnings.txt ]; then echo "DTCHECK FAIL: binding warning(s) above"; exit 1; else echo "DTCHECK CLEAN"; fi
override_dh_auto_test:
override_dh_auto_install:
override_dh_auto_clean:
