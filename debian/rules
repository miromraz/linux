#!/usr/bin/make -f

MK = $(MAKE) ARCH=arm64 -j$(shell nproc)
DT_YAMLS = Documentation/devicetree/bindings/clock/mediatek,infracfg.yaml \
           Documentation/devicetree/bindings/clock/mediatek,mt6797-mcumixed.yaml \
           Documentation/devicetree/bindings/regulator/mediatek,mt6797-cpu-sram.yaml

%:
	dh $@

override_dh_auto_configure:
	$(MK) defconfig
	$(MK) olddefconfig

override_dh_auto_build:
	@echo "===== dt_binding_check ====="
	-$(MK) dt_binding_check DT_SCHEMA_FILES="$(DT_YAMLS)" 2>&1 | tee dtbind.log
	@echo "===== CHECK_DTBS mt6797-gemini-pda.dtb ====="
	-$(MK) CHECK_DTBS=y mediatek/mt6797-gemini-pda.dtb 2>&1 | tee dtbs.log
	@echo "===== WARNING SUMMARY (diagnostic, non-fatal) ====="
	-grep -nEi 'warning|error|does not match|is not valid|failed to match|was expecting|not of type|is not one of|additional|undocumented|from schema|lacks|missing|deprecated' dtbind.log dtbs.log || echo "NONE-MATCHED-BY-PATTERN"

override_dh_auto_test:

override_dh_auto_install:

override_dh_auto_clean:
